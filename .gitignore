            ("Luminosity-flux relation", "Astronomy", "F=L/(4πd²)", "Relate isotropic luminosity L to observed flux F at distance d.", "Assumes negligible absorption and isotropic emission."),
            ("Redshift", "Astronomy", "z=(λ_observed−λ_rest)/λ_rest", "Fractional wavelength shift relative to rest wavelength.", "Positive z denotes a redshift."),
            ("Hubble law", "Astronomy", "v≈H₀d", "Low-redshift approximation relating recession velocity and distance.", "Cosmological interpretation depends on model and scale."),
            ("Kepler third law", "Astronomy", "T²=4π²a³/[G(M+m)]", "Orbital period for a two-body system with semi-major axis a.", "For m≪M, use central mass M."),
            ("Schwarzschild radius", "Astronomy", "r_s=2GM/c²", "Event-horizon radius for a non-rotating, uncharged black hole.", "Idealized Schwarzschild solution."),
            ("Linear population density", "Earth Science", "Density=population/area", "Measure population per unit land area.", "State whether total or habitable land area is used."),
            ("Richter-style magnitude difference", "Earth Science", "ΔM=log₁₀(A₁/A₂)", "Magnitude difference corresponds to a logarithmic amplitude ratio for the same measurement setup.", "Modern earthquake magnitude scales use calibrated definitions."),
            ("Hydrostatic pressure gradient", "Earth Science", "dp/dz=−ρg", "Pressure variation with vertical elevation z in a static fluid.", "Density may vary with depth."),
            ("Lapse rate", "Earth Science", "Γ=−dT/dz", "Rate of temperature decrease with altitude under the specified atmospheric profile.", "Environmental lapse rate varies in time and space."),
            ("Slope gradient", "Earth Science", "Gradient=(vertical rise/horizontal run)×100%", "Express terrain slope as percent grade.", "Use horizontal distance, not slope length."),

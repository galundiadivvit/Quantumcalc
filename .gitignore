            ("pOH", "Chemistry", "pOH=−log₁₀(a_OH⁻); pH+pOH≈14", "At approximately 25°C in dilute aqueous solution, pH+pOH≈14.", "The sum changes with temperature and activity conditions."),
            ("Henderson-Hasselbalch", "Chemistry", "pH=pKₐ+log₁₀([A⁻]/[HA])", "Estimate buffer pH when conjugate acid/base concentrations are known.", "Most useful when both buffer components are present."),

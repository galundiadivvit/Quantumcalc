        visual = card(page, "DISTRIBUTION VIEW", "FREQUENCY PROFILE")
        inputs.grid(row=0, column=0, sticky="nsew", padx=(0, 8), pady=5)
        visual.grid(row=0, column=1, sticky="nsew", padx=(8, 0), pady=5)
        left = tk.Frame(inputs, bg=C["panel"])
        left.pack(fill="both", expand=True, padx=13, pady=(0, 13))
        tk.Label(left, text="Enter values separated by commas, spaces or semicolons",
                 bg=C["panel"], fg=C["cyan2"], font=(FONT, 9, "bold")).pack(anchor="w")
        self.lab_data_input = tk.StringVar(value="12, 15, 18, 18, 21, 24, 24, 24, 30")
        styled_entry(left, self.lab_data_input, font_size=12).pack(fill="x", ipady=10, pady=8)
        actions = tk.Frame(left, bg=C["panel"])
        actions.pack(fill="x", pady=2)
        neon_button(actions, "ANALYSE DATASET", self.update_lab_stats, width=18, height=2).pack(side="left", padx=(0, 6))
        neon_button(actions, "LOAD EXAMPLE", lambda: (self.lab_data_input.set("4, 7, 7, 9, 12, 14, 14, 18, 21, 24"), self.update_lab_stats()), width=13, height=2).pack(side="left")
        neon_button(actions, "EXPORT CSV", self.export_lab_statistics, width=11, height=2, accent="mint").pack(side="left", padx=(6, 0))
        self.lab_stats_output = tk.StringVar(value="Enter a dataset to inspect its statistical profile.")
        tk.Label(left, textvariable=self.lab_stats_output, bg=C["bg2"], fg=C["cyan2"],
                 font=(MONO, 9), anchor="nw", justify="left", padx=12, pady=12,
                 wraplength=420, relief="sunken", bd=2).pack(fill="both", expand=True, pady=(9, 0))
        self.lab_stats_canvas = tk.Canvas(visual, bg=C["bg2"], highlightthickness=1,
                                          highlightbackground=C["line2"])
        self.lab_stats_canvas.pack(fill="both", expand=True, padx=13, pady=(0, 13))
        self.lab_stats_canvas.bind("<Configure>", lambda _e: self._draw_lab_stats(self._lab_stats_data) if getattr(self, "_lab_stats_data", None) else None)
        self.update_lab_stats()

    def update_lab_stats(self) -> None:
        try:
            data = self._parse_lab_series(self.lab_data_input.get(), "Dataset")
            n = len(data)
            ordered = sorted(data)
            mean = statistics.mean(data)
            median = statistics.median(data)
            modes = statistics.multimode(data)
            pvar = statistics.pvariance(data)
            svar = statistics.variance(data) if n > 1 else 0.0
            psd, ssd = math.sqrt(pvar), math.sqrt(svar)
            lower = ordered[:n//2]
            upper = ordered[(n+1)//2:]
            q1 = statistics.median(lower) if lower else ordered[0]
            q3 = statistics.median(upper) if upper else ordered[-1]
            iqr = q3 - q1
            mad = statistics.median([abs(x - median) for x in data])
            sem = ssd / math.sqrt(n) if n > 1 else 0.0
            cv = (ssd / abs(mean) * 100) if n > 1 and mean != 0 else None
            cv_text = f"{fmt(cv, 6)} %" if cv is not None else "Not defined"
            mode_text = ", ".join(fmt(x) for x in modes[:6]) + (" …" if len(modes) > 6 else "")
            lower_fence, upper_fence = q1 - 1.5 * iqr, q3 + 1.5 * iqr
            outliers = [x for x in data if x < lower_fence or x > upper_fence]
            self._lab_stats_metrics = {
                "Count": n, "Unique values": len(set(data)), "Mean": mean,
                "Median": median, "Mode": mode_text, "Minimum": ordered[0],
                "Maximum": ordered[-1], "Range": ordered[-1] - ordered[0],
                "Q1": q1, "Q3": q3, "Interquartile range": iqr,
                "Population standard deviation": psd, "Sample standard deviation": ssd,
                "Sample variance": svar, "Standard error": sem,
                "Median absolute deviation": mad, "Coefficient of variation (%)": cv,
                "Tukey outlier count": len(outliers), "Lower outlier fence": lower_fence,
                "Upper outlier fence": upper_fence,
            }
            self._lab_stats_data = list(data)
            self.lab_stats_output.set(
                f"COUNT / UNIQUE     {n} / {len(set(data))}\n"
                f"MEAN / MEDIAN      {fmt(mean, 8)} / {fmt(median, 8)}\n"
                f"MODE               {mode_text}\n"
                f"MIN / MAX          {fmt(ordered[0])} / {fmt(ordered[-1])}\n"
                f"RANGE / IQR        {fmt(ordered[-1]-ordered[0])} / {fmt(iqr)}\n"
                f"Q1 / Q3            {fmt(q1)} / {fmt(q3)}\n"
                f"POP. STD. DEV.     {fmt(psd, 8)}\n"
                f"SAMPLE STD. DEV.   {fmt(ssd, 8)}\n"
                f"SAMPLE VARIANCE    {fmt(svar, 8)}\n"
                f"STD. ERROR         {fmt(sem, 8)}\n"
                f"MEDIAN ABS. DEV.   {fmt(mad, 8)}\n"
                f"COEFF. VARIATION   {cv_text}\n"
                f"TUKEY OUTLIERS     {len(outliers)}  (outside 1.5 × IQR fences)"
            )
            self._draw_lab_stats(data)
        except Exception as exc:
            self.lab_stats_output.set(f"Dataset error\n\n{exc}")
            self.lab_stats_canvas.delete("all")

    def _draw_lab_stats(self, data: list[float]) -> None:
        c = self.lab_stats_canvas
        c.delete("all")
        w, h = max(c.winfo_width(), 420), max(c.winfo_height(), 300)
        left, right, top, bottom = 54, w-24, 34, h-42
        lo, hi = min(data), max(data)
        if hi == lo:
            lo, hi = lo - .5, hi + .5
        bins = min(14, max(5, round(math.sqrt(len(data)))))
        step = (hi-lo)/bins
        counts = [0]*bins
        for value in data:
            counts[min(bins-1, max(0, int((value-lo)/step)))] += 1
        maxc = max(counts) or 1
        for g in range(5):
            y = bottom-(bottom-top)*g/4
            c.create_line(left, y, right, y, fill=C["line"], dash=(2, 4))
            c.create_text(left-10, y, text=str(round(maxc*g/4)), fill=C["muted"], anchor="e", font=(MONO, 8))
        slot = (right-left)/bins
        shades = [C["sapphire_dark"], C["blue"], C["fusion"], C["mint_dark"], C["mint"]]
        for i, count in enumerate(counts):
            x0, x1 = left+i*slot+4, left+(i+1)*slot-4
            y = bottom-(bottom-top)*count/maxc
            color = shades[min(len(shades)-1, int(i*len(shades)/bins))]
            c.create_rectangle(x0, y, x1, bottom, fill=color, outline=C["cyan2"], width=1)
            c.create_text((x0+x1)/2, y-9, text=str(count), fill=C["cyan2"], font=(MONO, 8))
        mean_x = left + (statistics.mean(data)-lo)/(hi-lo)*(right-left)
        median_x = left + (statistics.median(data)-lo)/(hi-lo)*(right-left)
        c.create_line(mean_x, top, mean_x, bottom, fill=C["mint_light"], width=2, dash=(5, 3))
        c.create_line(median_x, top, median_x, bottom, fill=C["cyan2"], width=2, dash=(2, 3))
        c.create_text(12, 8, text="FREQUENCY DISTRIBUTION", fill=C["cyan2"], anchor="nw", font=(FONT, 9, "bold"))
        c.create_text(right, 8, text=f"n = {len(data)}", fill=C["muted"], anchor="ne", font=(MONO, 8))
        c.create_text(left, h-18, text=fmt(min(data)), fill=C["muted"], anchor="w", font=(MONO, 8))
        c.create_text(right, h-18, text=fmt(max(data)), fill=C["muted"], anchor="e", font=(MONO, 8))
        c.create_rectangle(left, h-5, left+10, h-1, fill=C["mint_light"], outline="")
        c.create_text(left+15, h-3, text="Mean", fill=C["muted"], anchor="w", font=(FONT, 8))
        c.create_rectangle(left+70, h-5, left+80, h-1, fill=C["cyan2"], outline="")
        c.create_text(left+85, h-3, text="Median", fill=C["muted"], anchor="w", font=(FONT, 8))


class _NavigationProxy:
    """Small compatibility shim for retained formula/graph code."""
    def __init__(self, app): self.app = app
    def select(self, page):
        if page is getattr(self.app, "dashboard", None): self.app._show_page("Standard")
        elif page is getattr(self.app, "graph_page", None): self.app._show_page("Graphing")
        elif page is getattr(self.app, "finance_page", None): self.app._show_page("Financial tool")


def _flat_card(parent: tk.Widget, title: str | None = None, subtitle: str | None = None,
               accent: str = "cyan") -> tk.Frame:
    """Clean raised card with a Sapphire/Fusion/Emerald accent line."""
    frame = tk.Frame(parent, bg=C["panel"], highlightthickness=1,
                     highlightbackground=C["line"], bd=0)
    if title:
        head = tk.Frame(frame, bg=C["panel"])
        head.pack(fill="x", padx=12, pady=(10, 7))
        tk.Frame(head, bg=C["cyan"], width=3, height=19).pack(side="left", padx=(0, 9))
        tk.Label(head, text=title, bg=C["panel"], fg=C["text"],
                 font=(FONT, 11, "bold")).pack(side="left")
        if subtitle:
            tk.Label(head, text=subtitle, bg=C["panel"], fg=C["muted"],
                     font=(FONT, 8)).pack(side="right")
        accent_line = tk.Canvas(frame, height=2, bg=C["panel"],
                                highlightthickness=0, bd=0)
        accent_line.pack(fill="x", padx=12, pady=(0, 7))
        accent_line.bind("<Configure>", lambda _e=None: _paint_gradient(
            accent_line, PALETTE_GRADIENTS["blue_emerald_fusion"]))
    return frame


def _flat_entry(parent: tk.Widget, textvariable: tk.StringVar | None = None,
                width: int = 18, font_size: int = 11) -> tk.Entry:
    return tk.Entry(parent, textvariable=textvariable, width=width,
                    bg=C["panel"], fg=C["text"], insertbackground=C["text"],
                    selectbackground=C["sapphire_dark"], selectforeground=C["text"],
                    relief="flat", bd=0, highlightthickness=1,
                    highlightbackground=C["line"], highlightcolor=C["cyan"],
                    font=(MONO, font_size))


def _blend_hex(a: str, b: str, t: float) -> str:
    aa, bb = a.lstrip("#"), b.lstrip("#")
    av = [int(aa[i:i+2], 16) for i in (0, 2, 4)]
    bv = [int(bb[i:i+2], 16) for i in (0, 2, 4)]
    return "#" + "".join(f"{round(x + (y-x)*t):02X}" for x, y in zip(av, bv))


def _animate_bg(widget: tk.Widget, start: str, end: str, steps: int = 5, delay: int = 14) -> None:
    """Short native colour tween for polished hover/focus feedback."""
    try:
        if not widget.winfo_exists():
            return
        # Cancel an unfinished opposite-direction tween to avoid hover flicker.
        for job in getattr(widget, "_qc_anim_jobs", []):
            try:
                widget.after_cancel(job)
            except tk.TclError:
                pass
        jobs = []
        widget._qc_anim_jobs = jobs
        try:
            current = widget.cget("bg")
            if isinstance(current, str) and current.startswith("#"):
                start = current
        except tk.TclError:
            pass
        for step in range(1, steps + 1):
            colour = _blend_hex(start, end, step / steps)
            jobs.append(widget.after(delay * step,
                         lambda c=colour, w=widget: w.configure(bg=c) if w.winfo_exists() else None))
    except (tk.TclError, RuntimeError):
        pass


def self_theme_is_light(palette: dict[str, str]) -> bool:
    """Identify the light palette without relying on a Tk widget instance."""
    return palette.get("button_text") == "#17243A"


def _flat_button(parent: tk.Widget, text: str, command: Callable[[], None],
                 *, accent: str = "cyan", width: int | None = None,
                 height: int = 1, font_size: int = 10):
    label = text.strip().upper()
    positive = label in ("=", "CONVERT", "CALCULATE EMI", "CALCULATE SIP", "EXPORT", "SAVE") or label.startswith("CALCULATE")
    primary = label in ("PLOT", "GRAPH", "OPEN", "APPLY")
    bg = C.get("positive_surface", C["mint"]) if positive else (C.get("primary_surface", C["cyan"]) if primary else C["panel3"])
    hover = C.get("positive_hover", C.get("success_hover", C["mint_light"])) if positive else (C.get("primary_hover", C["sapphire_light"]) if primary else C.get("button_hover", C["sapphire_dark"]))
    fg = C.get("button_text", C["bg"]) if positive or primary else C["text"]
    active_fg = C.get("button_text", "#FFFFFF") if self_theme_is_light(C) else "#FFFFFF"
    btn = tk.Button(parent, text=text, command=command, bg=bg, fg=fg,
                    activebackground=hover, activeforeground=active_fg,
                    relief="flat", bd=0, highlightthickness=1,
                    highlightbackground=C["line"], highlightcolor=C["cyan2"],
                    cursor="hand2", takefocus=True,
                    font=(FONT, font_size), padx=9, pady=height * 5,
                    width=max(0, width or 0))
    btn.bind("<Enter>", lambda _e=None: _animate_bg(btn, bg, hover))
    btn.bind("<Leave>", lambda _e=None: _animate_bg(btn, hover, bg))
    btn.bind("<FocusIn>", lambda _e=None: btn.configure(highlightthickness=2, highlightbackground=C["cyan2"]))
    btn.bind("<FocusOut>", lambda _e=None: btn.configure(highlightthickness=1, highlightbackground=C["line"]))
    return btn


# Retained non-calculator tools resolve these shared helpers and inherit the Sapphire + Emerald signature.
card = _flat_card
styled_entry = _flat_entry
neon_button = _flat_button

def _resource_path(filename: str) -> str:
    """Resolve bundled assets in source mode and in a PyInstaller one-folder build."""
    base = getattr(sys, "_MEIPASS", os.path.dirname(os.path.abspath(__file__)))
    return os.path.join(base, filename)


def main() -> None:
    # Must run before Tk creates its first HWND; Windows will then render at the
    # monitor's real DPI instead of stretching a low-resolution bitmap.
    _enable_windows_dpi_awareness()
    root = tk.Tk()
    _configure_native_rendering(root)
    try:
        icon_file = _resource_path("QuantumCalc.ico")
        if os.path.isfile(icon_file):
            root.iconbitmap(default=icon_file)
    except tk.TclError:
        pass
    app = CalculatorApp(root)
    root.mainloop()


if __name__ == "__main__":
    main()
    

def _blend_hex(a: str, b: str, amount: float) -> str:
    """Blend two #RRGGBB colors for small, dependency-free Tk gradients."""
    amount = max(0.0, min(1.0, amount))
    aa = tuple(int(a[i:i+2], 16) for i in (1, 3, 5))
    bb = tuple(int(b[i:i+2], 16) for i in (1, 3, 5))
    rgb = tuple(round(x + (y - x) * amount) for x, y in zip(aa, bb))
    return "#%02X%02X%02X" % rgb


def _gradient_color(stops: tuple[str, ...], amount: float) -> str:
    """Return an interpolated color along a 2- or 3-stop horizontal gradient."""
    amount = max(0.0, min(1.0, amount))
    if len(stops) == 2:
        return _blend_hex(stops[0], stops[1], amount)
    if amount <= 0.5:
        return _blend_hex(stops[0], stops[1], amount * 2)
    return _blend_hex(stops[1], stops[2], (amount - 0.5) * 2)


def _paint_gradient(canvas: tk.Canvas, stops: tuple[str, ...]) -> None:
    """Paint a crisp horizontal gradient without Pillow or other dependencies."""
    canvas.delete("gradient")
    width = max(1, canvas.winfo_width())
    height = max(1, canvas.winfo_height())
    step = max(1, width // 180)
    for x in range(0, width, step):
        color = _gradient_color(stops, x / max(1, width - 1))
        canvas.create_rectangle(x, 0, min(width, x + step + 1), height,
                                fill=color, outline=color, tags="gradient")

# Runtime font selection prefers the current Windows 11 variable type family.
# On development systems, Inter provides a comparable contemporary appearance.
FONT = "Segoe UI Variable Text"
HEAD_FONT = "Segoe UI Variable Display"
MONO = "Cascadia Mono"


def _select_modern_fonts(root: tk.Tk) -> None:
    """Choose crisp modern fonts actually installed on the target computer."""
    global FONT, HEAD_FONT, MONO
    try:
        available = {name.casefold(): name for name in tkfont.families(root)}
    except Exception:
        available = {}

    def choose(candidates, fallback):
        for candidate in candidates:
            found = available.get(candidate.casefold())
            if found:
                return found
        return fallback

    FONT = choose(
        ["Segoe UI Variable Text", "Segoe UI Variable", "Segoe UI", "Aptos", "Inter", "Lato", "Arial"],
        "TkDefaultFont",
    )
    HEAD_FONT = choose(
        ["Segoe UI Variable Display", "Segoe UI Variable", "Segoe UI", "Inter Display", "Inter", FONT],
        FONT,
    )
    MONO = choose(["Cascadia Mono", "Cascadia Code", "Consolas", "SFMono-Regular", "DejaVu Sans Mono"], "TkFixedFont")

    # Refresh Tk's named defaults so native dialogs, menus, and text widgets
    # use the same modern family instead of an older platform default.
    defaults = {
        "TkDefaultFont": (FONT, 10),
        "TkTextFont": (FONT, 10),
        "TkMenuFont": (FONT, 10),
        "TkHeadingFont": (HEAD_FONT, 11, "bold"),
        "TkCaptionFont": (HEAD_FONT, 11, "bold"),
        "TkSmallCaptionFont": (FONT, 9),
        "TkIconFont": (FONT, 9),
        "TkTooltipFont": (FONT, 9),
        "TkFixedFont": (MONO, 10),
    }
    for name, spec in defaults.items():
        try:
            f = tkfont.nametofont(name, root=root)
            f.configure(family=spec[0], size=spec[1], weight=spec[2] if len(spec) > 2 else "normal")
        except Exception:
            pass


def _configure_native_rendering(root: tk.Tk) -> None:
    """Set Tk's point-to-pixel scaling from the monitor's actual DPI."""
    try:
        dpi = float(root.winfo_fpixels("1i"))
        if 48.0 <= dpi <= 480.0:
            root.tk.call("tk", "scaling", dpi / 72.0)
    except (tk.TclError, ValueError, TypeError):
        pass
    _select_modern_fonts(root)


# -----------------------------------------------------------------------------
# Safe expression evaluator: no eval(), no attribute access, no imports.
# Supports arithmetic and a curated set of scientific functions.
# -----------------------------------------------------------------------------
def cube_root(value: float) -> float:
    """Real cube root, including negative inputs (unlike value ** (1/3))."""
    value = float(value)
    return math.copysign(abs(value) ** (1.0 / 3.0), value) if value else 0.0


def nth_root(value: float, index: float) -> float:
    """Real y-th root of x, supporting negative x for odd integer y."""
    value = float(value)
    index = float(index)
    if not math.isfinite(value) or not math.isfinite(index):
        raise ValueError("Root inputs must be finite numbers.")
    if index == 0:
        raise ZeroDivisionError("The root index cannot be zero.")
    if value == 0 and index < 0:
        raise ZeroDivisionError("Zero cannot have a negative root index.")
    if value < 0:
        rounded = round(index)
        if not index.is_integer() or int(rounded) % 2 == 0:
            raise ValueError("A negative number has a real root only for an odd integer index.")
        return -((-value) ** (1.0 / index))
    return value ** (1.0 / index)



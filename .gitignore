        return [
            dict(title=a, category=b, formula=c, description=d, example=e)
            for a, b, c, d, e in rows
        ]

    def _formula_search_focus_in(self, _event: Any = None) -> None:
        if self.formula_search.get() == "Search formula or topic…":
            self.formula_search.set("")

    def _formula_search_focus_out(self, _event: Any = None) -> None:
        if not self.formula_search.get().strip():
            self.formula_search.set("Search formula or topic…")
            self._populate_formula_tree()

    def _populate_formula_tree(self) -> None:
        if not hasattr(self, "formula_tree"):
            return
        for item in self.formula_tree.get_children():
            self.formula_tree.delete(item)
        term = self.formula_search.get().strip().lower()
        if term == "search formula or topic…":
            term = ""
        category = self.formula_category.get()
        for i, f in enumerate(self.formulas):
            if category != "All categories" and f["category"] != category:
                continue
            hay = " ".join(f.values()).lower()
            if term and term not in hay:
                continue
            self.formula_tree.insert(
                "", "end", iid=str(i), text=f["title"], values=(f["category"],)
            )

    def _show_formula(self, _event: Any = None) -> None:
        selected = self.formula_tree.selection()
        if not selected:
            return
        f = self.formulas[int(selected[0])]
        self.selected_formula = f
        self.formula_title.set(f["title"])
        self.formula_expression.set(f["formula"])
        self.formula_explain.set(f["description"])
        self.formula_example.set("EXAMPLE  ·  " + f["example"])

    def copy_formula(self) -> None:
        if not self.selected_formula:
            return
        self.root.clipboard_clear()
        self.root.clipboard_append(self.selected_formula["formula"])
        self.formula_example.set("Copied formula to clipboard.")

    def insert_formula(self) -> None:
        if not self.selected_formula:
            return
        self.notebook.select(self.dashboard)
        self.display_var.set(self.selected_formula["formula"])
        self.formula_example.set(
            "Formula sent to the calculator display. Edit if needed before evaluating."
        )


    # ================= WINDOWS CALCULATOR-STYLE INTERFACE ==================
    # The UI below intentionally replaces the former neon cockpit.  The math,
    # graphing, finance, statistics, ODE and formula engines remain available.

    def _setup_style(self) -> None:
        style = ttk.Style()
        try:
            # clam exposes all colour options consistently; native bitmap themes
            # can ignore dark palette settings on some Windows builds.
            style.theme_use("clam")
        except tk.TclError:
            pass
        style.configure("TNotebook", background=C["bg"], borderwidth=0, tabmargins=2)
        style.configure("TNotebook.Tab", background=C["panel2"], foreground=C["muted"],
                        padding=(16, 9), font=(FONT, 10), borderwidth=0)
        style.map("TNotebook.Tab", background=[("selected", C["panel3"])],
                  foreground=[("selected", C["cyan2"])])
        style.configure("TCombobox", fieldbackground=C["panel2"], background=C["panel3"],
                        foreground=C["text"], arrowcolor=C["cyan2"], padding=(8, 7),
                        borderwidth=1, relief="flat", font=(FONT, 10))
        style.map("TCombobox", fieldbackground=[("readonly", C["panel2"])],
                  foreground=[("readonly", C["text"])])
        style.configure("TSpinbox", fieldbackground=C["panel2"], foreground=C["text"],
                        arrowsize=13, padding=6, font=(FONT, 10))
        style.configure("Treeview", background=C["panel2"], fieldbackground=C["panel2"],
                        foreground=C["text"], rowheight=32, borderwidth=0, font=(FONT, 10))
        style.configure("Treeview.Heading", background=C["panel3"], foreground=C["cyan2"],
                        font=(HEAD_FONT, 10, "bold"), relief="flat")
        style.map("Treeview", background=[("selected", C["sapphire_dark"])],
                  foreground=[("selected", C.get("button_text", "#FFFFFF") if C.get("bg") == "#F8FAFF" else "#FFFFFF")])
        style.configure("Vertical.TScrollbar", background=C["panel3"], troughcolor=C["bg2"],
                        bordercolor=C["bg2"], arrowcolor=C["cyan2"], relief="flat")
        style.map("Vertical.TScrollbar", background=[("active", C["line2"])])

    def _build_shell(self) -> None:
        self.root.title("Calculator")
        self.root.update_idletasks()
        sw, sh = self.root.winfo_screenwidth(), self.root.winfo_screenheight()
        ww, wh = min(1580, max(1120, int(sw * .94))), min(980, max(700, int(sh * .90)))
        self.root.geometry(f"{ww}x{wh}")
        self.root.minsize(980, 640)
        self.root.configure(bg=C["bg"])
        self.history: list[str] = getattr(self, "history", [])
        self.variables = getattr(self, "variables", {})
        self.ans = getattr(self, "ans", 0)
        self.angle_mode = getattr(self, "angle_mode", tk.StringVar(value="RAD"))
        self._setup_style()

        self.app_body = tk.Frame(self.root, bg=C["bg"])
        self.app_body.pack(fill="both", expand=True)
        self.sidebar = tk.Frame(self.app_body, bg=C["bg2"], width=255,
                                highlightthickness=1, highlightbackground=C["line"])
        self.sidebar.pack(side="left", fill="y")
        self.sidebar.pack_propagate(False)
        self.sidebar_visible = True

        self.main_area = tk.Frame(self.app_body, bg=C.get("bg_secondary", C["bg"]))
        self.main_area.pack(side="left", fill="both", expand=True)
        self.topbar = tk.Frame(self.main_area, bg=C.get("bg_secondary", C["bg"]), height=55)
        self.topbar.pack(fill="x", padx=10, pady=(5, 0))
        self.topbar.pack_propagate(False)
        self.menu_button = tk.Button(
            self.topbar, text="☰", command=self._toggle_sidebar,
            bg=C["bg"], fg=C["muted"], activebackground=C["panel3"],
            activeforeground=C["text"], relief="flat", bd=0,
            font=(FONT, 15), cursor="hand2", width=2, padx=4, pady=3,
            highlightthickness=0, takefocus=True
        )
        self.menu_button.pack(side="left", padx=(0, 5))
        self.page_title = tk.Label(self.topbar, text="Standard", bg=C["bg"], fg=C["cyan2"],
                                   font=(HEAD_FONT, 18, "bold"))
        self.page_title.pack(side="left", anchor="w")
        self.header_accent = tk.Canvas(self.topbar, height=3, bg=C["bg"],
                                       highlightthickness=0, bd=0)
        self.header_accent.pack(side="bottom", fill="x")
        self.header_accent.bind("<Configure>", lambda _e=None: _paint_gradient(
            self.header_accent, THEME_HEADER_GRADIENTS[self.theme_name]))
        self.view_container = tk.Frame(self.main_area, bg=C["bg"])
        self.view_container.pack(fill="both", expand=True, padx=7, pady=(0, 7))

        self._build_sidebar()
        self.current_page = "Standard"
        self.page_frames: dict[str, tk.Frame] = {}
        self._build_standard_windows()
        self._show_page("Standard", initial=True)

        # These aliases keep the retained formula/graph/finance engines working.
        self.dashboard = self.standard_page
        self.calculators_page = self.standard_page
        self.notebook = _NavigationProxy(self)
        self.var_r = tk.StringVar(value="R: —")
        self.var_t = tk.StringVar(value=f"T: {self.angle_mode.get()}")
        self.var_ans = tk.StringVar(value=f"Ans: {fmt(self.ans)}")
        self.root.bind("<Key>", self._global_keypress)
        self.root.after(120, self.root.focus_set)

    def _toggle_sidebar(self) -> None:
        if self.sidebar_visible:
            self.sidebar.pack_forget()
            self.sidebar_visible = False
        else:
            self.sidebar.pack(side="left", fill="y", before=self.main_area)
            self.sidebar_visible = True

    def _build_sidebar(self) -> None:
        for child in self.sidebar.winfo_children():
            child.destroy()
        brand = tk.Frame(self.sidebar, bg=C["bg2"])
        brand.pack(fill="x", padx=12, pady=(12, 14))
        brand_canvas = tk.Canvas(brand, height=78, bg=C["bg2"],
                                 highlightthickness=0, bd=0)
        brand_canvas.pack(fill="x")
        def paint_brand(_event=None):
            brand_stops, brand_text = THEME_BRAND_GRADIENTS[self.theme_name]
            _paint_gradient(brand_canvas, brand_stops)
            brand_canvas.create_text(14, 27, text="QUANTUMCALC", anchor="w",
                                     fill=brand_text, font=(HEAD_FONT, 15, "bold"))
            brand_canvas.create_text(15, 52, text="PRECISION  •  CLARITY  •  CONTROL",
                                     anchor="w", fill=brand_text, font=(FONT, 7, "bold"))
        brand_canvas.bind("<Configure>", paint_brand)

        # Pin Settings and the creator credit to the bottom of the sidebar.
        # Pack these before the expanding navigation canvas so they stay visible.
        self.nav_buttons: dict[str, tk.Button] = {}
        creator_footer = tk.Frame(self.sidebar, bg=C["bg2"])
        creator_footer.pack(side="bottom", fill="x", padx=13, pady=(2, 11))
        tk.Frame(creator_footer, bg=C.get("sidebar_rule", C["line"]), height=2 if self.theme_name == "Light" else 1).pack(fill="x", pady=(0, 8))
        tk.Label(creator_footer, text="QUANTUMCALC STUDIO", bg=C["bg2"], fg=C["muted"],
                 font=(FONT, 7, "bold"), anchor="w").pack(fill="x")
        tk.Label(creator_footer, text=f"Developed by {DEVELOPER_NAME}", bg=C["bg2"],
                 fg=C["text"], font=(FONT, 8), anchor="w").pack(fill="x", pady=(2, 0))
        settings_btn = tk.Button(self.sidebar, text="⚙    Settings", anchor="w",
                                 command=lambda: self._show_page("Settings"),
                                 bg=C.get("sidebar_settings", C["bg2"]),
                                 fg=C.get("sidebar_selected_text", C["text"]),
                                 activebackground=C.get("sidebar_hover", C["panel3"]),
                                 activeforeground=C.get("sidebar_selected_text", C["text"]), relief="flat", bd=0,
                                 padx=14, pady=11, font=(FONT, 10), cursor="hand2",
                                 takefocus=True, highlightthickness=1,
                                 highlightbackground=C["bg2"])
        settings_btn.pack(side="bottom", fill="x", padx=4, pady=(5, 3))
        self.nav_buttons["Settings"] = settings_btn

        nav_canvas = tk.Canvas(self.sidebar, bg=C["bg2"], highlightthickness=0, bd=0)
        nav_scroll = ttk.Scrollbar(self.sidebar, orient="vertical", command=nav_canvas.yview)
        nav_canvas.configure(yscrollcommand=nav_scroll.set)
        nav_scroll.pack(side="right", fill="y")
        nav_canvas.pack(side="left", fill="both", expand=True)
        nav = tk.Frame(nav_canvas, bg=C["bg2"])
        win = nav_canvas.create_window((0, 0), window=nav, anchor="nw")
        nav.bind("<Configure>", lambda _e=None: nav_canvas.configure(scrollregion=nav_canvas.bbox("all")))
        nav_canvas.bind("<Configure>", lambda e: nav_canvas.itemconfigure(win, width=e.width))

        # Keep the primary navigation compact and in the product's intended order.
        # All measurement families live inside the single Converter workspace.
        sections = [
            ("QUANTUMCALC TOOLS", [
                ("Standard", "▦"),
                ("Scientific", "⚗"),
                ("Financial tool", "₹"),
                ("Formula Library", "ƒ"),
                ("Graphing", "⌁"),
                ("Date Calculator", "▣"),
                ("Converter", "⇄"),
                ("Laboratories", "⌘"),
            ]),
        ]
        for section, items in sections:
            tk.Label(nav, text=section, bg=C["bg2"], fg=C.get("nav_heading", C["muted"]),
                     font=(FONT, 10, "bold"), anchor="w").pack(fill="x", padx=16, pady=(10, 6))
            for name, glyph in items:
                btn = tk.Button(nav, text=f"{glyph}    {name}", anchor="w",
                                command=lambda n=name: self._show_page(n),
                                bg=C["bg2"], fg=C["text"],
                                activebackground=C.get("sidebar_hover", C["panel3"]),
                                activeforeground=C["text"], relief="flat", bd=0,
                                padx=14, pady=9, font=(FONT, 10), cursor="hand2",
                                takefocus=True, highlightthickness=1, highlightbackground=C["bg2"],
                                highlightcolor=C["cyan2"])
                btn.pack(fill="x", padx=4, pady=1)
                btn.bind("<Enter>", lambda _e=None, w=btn: _animate_bg(w, C["bg2"], C.get("sidebar_hover", C["panel3"])))
                btn.bind("<Leave>", lambda _e=None, w=btn, n=name: _animate_bg(w, C.get("sidebar_selected", C["panel3"]) if self.current_page == n else C["bg2"], C.get("sidebar_selected", C["panel3"]) if self.current_page == n else C["bg2"]))
                btn.bind("<FocusIn>", lambda _e=None, w=btn: w.configure(highlightthickness=1, highlightbackground=C["cyan2"]))
                btn.bind("<FocusOut>", lambda _e=None, w=btn: w.configure(highlightthickness=0))
                self.nav_buttons[name] = btn
        nav_canvas.bind_all("<MouseWheel>", lambda e: nav_canvas.yview_scroll(int(-e.delta/120), "units"))

    def _set_nav_active(self, name: str) -> None:
        for key, btn in self.nav_buttons.items():
            selected = key == name
            btn.configure(bg=C.get("sidebar_selected", C["panel3"]) if selected else C["bg2"],
                          fg=C.get("sidebar_selected_text", C["cyan2"]) if selected else C["text"],
                          highlightthickness=1 if selected else 0,
                          highlightbackground=C.get("cyan", C["bg2"]) if selected else C["bg2"],
                          font=(FONT, 9, "bold" if selected else "normal"))

    def _clear_view(self) -> None:
        for child in self.view_container.winfo_children():
            child.destroy()

    def _show_page(self, name: str, initial: bool = False) -> None:
        self.current_page = name
        self.page_title.configure(text=name)
        self._set_nav_active(name)
        self._clear_view()
        # One Converter workspace contains every measurement and currency family.
        # Old category page names still route into the matching Converter tab for compatibility.
        converter_aliases = {"Weight and mass": "Mass", "Data": "Data storage"}
        if name == "Converter":
            if not self.sidebar_visible:
                self.sidebar.pack(side="left", fill="y", before=self.main_area)
                self.sidebar_visible = True
            self._build_converter_hub()
            return
        if name in ("Currency", "Temperature", "Weight and mass", "Data") or name in UNIT_SPECS:
            if not self.sidebar_visible:
                self.sidebar.pack(side="left", fill="y", before=self.main_area)
                self.sidebar_visible = True
            category = converter_aliases.get(name, name)
            self._build_converter_hub(category)
            return
        if not self.sidebar_visible:
            self.sidebar.pack(side="left", fill="y", before=self.main_area)
            self.sidebar_visible = True
        if name == "Standard":
            self._build_standard_windows()
        elif name == "Scientific":
            self._build_scientific_windows()
        elif name == "Graphing":
            self.graph_page = tk.Frame(self.view_container, bg=C["bg"])
            self.graph_page.pack(fill="both", expand=True)
            self._build_graph_workspace()
        elif name == "Date Calculator":
            self._build_date_windows()
        elif name == "Financial tool":
            self.finance_page = tk.Frame(self.view_container, bg=C["bg"])
            self.finance_page.pack(fill="both", expand=True)
            self._build_finance()
        elif name == "Laboratories":
            self.labs_page = tk.Frame(self.view_container, bg=C["bg"])
            self.labs_page.pack(fill="both", expand=True)
            self._build_laboratories()
        elif name == "Formula Library":
            self.formula_page = tk.Frame(self.view_container, bg=C["bg"])
            self.formula_page.pack(fill="both", expand=True)
            self._build_formula_library()
        elif name == "Settings":
            self._build_settings_windows()
        else:
            self._build_standard_windows()

    def _history_panel(self, parent: tk.Widget, history_attr: str) -> tk.Frame:
        """Minimal Windows-style History / Memory panel with underline tabs."""
        panel = tk.Frame(parent, bg=C["bg"], width=278,
                         highlightthickness=1, highlightbackground=C["line"])
        panel.pack_propagate(False)
        tabs = tk.Frame(panel, bg=C["bg"])
        tabs.pack(fill="x", padx=13, pady=(13, 8))
        self.history_mode = tk.StringVar(value="History")
        self.history_tab_buttons: dict[str, tk.Button] = {}
        for label in ("History", "Memory"):
            button = tk.Button(
                tabs, text=label,
                command=lambda mode=label: self._history_mode_changed(panel, history_attr, mode),
                bg=C["bg"], fg=C["text"] if label == "History" else C["muted"],
                activebackground=C["bg"], activeforeground=C["cyan"],
                relief="flat", bd=0, font=(FONT, 10), padx=12, pady=5, cursor="hand2"
            )
            button.pack(side="left")
            self.history_tab_buttons[label] = button
        self.history_tab_underline = tk.Frame(tabs, bg=C["cyan"], height=3, width=36)
        self.history_tab_underline.place(x=9, y=33)
        listing = tk.Frame(panel, bg=C["bg"])
        listing.pack(fill="both", expand=True, padx=13, pady=(5, 13))
        box = tk.Listbox(listing, bg=C["bg"], fg=C["text"], selectbackground=C["sapphire_dark"],
                         selectforeground=C["text"], font=(FONT, 10), relief="flat", bd=0,
                         highlightthickness=0, activestyle="none")
        box.pack(fill="both", expand=True)
        setattr(self, history_attr, box)
        if history_attr == "std_history_list":
            self.std_history_items = getattr(self, "std_history_items", [])
            box.bind("<Double-Button-1>", self._reuse_standard_history)
        elif history_attr == "sci_history_list":
            self.sci_history_items = getattr(self, "sci_history_items", [])
            box.bind("<Double-Button-1>", self._reuse_scientific_history)
        self._history_mode_changed(panel, history_attr, "History")
        return panel

    def _history_mode_changed(self, panel: tk.Frame, history_attr: str,
                              mode: str | None = None) -> None:
        if mode is not None:
            self.history_mode.set(mode)
        mode = self.history_mode.get()
        for label, button in self.history_tab_buttons.items():
            selected = label == mode
            button.configure(fg=C["text"] if selected else C["muted"],
                             font=(FONT, 10, "bold" if selected else "normal"))
        try:
            active = self.history_tab_buttons[mode]
            self.history_tab_underline.place_configure(x=active.winfo_x()+9)
        except tk.TclError:
            pass
        box = getattr(self, history_attr, None)
        if box is None:
            return
        box.delete(0, "end")
        if mode == "Memory":
            if history_attr == "std_history_list":
                memory = getattr(self, "std_memory", 0.0)
            else:
                memory = getattr(self, "sci_memory", 0.0)
            box.insert("end", f"Memory\n{fmt(memory)}")
            return
        items = self.std_history_items if history_attr == "std_history_list" else self.sci_history_items
        if items:
            for item in reversed(items[-100:]):
                box.insert("end", item)
        else:
            box.insert("end", "There’s no history yet.")

    def _readout(self, parent: tk.Widget, expression: tk.StringVar, result: tk.StringVar | None = None) -> tk.Frame:
        display = tk.Frame(parent, bg=C["bg"])
        display.pack(fill="x", padx=22, pady=(18, 14))
        expr_label = tk.Label(display, textvariable=expression, bg=C["bg"], fg=C["muted"],
                 font=(FONT, 13), anchor="e", justify="right")
        expr_label.pack(fill="x")
        if hasattr(self, "current_page"):
            if self.current_page == "Scientific": self.sci_display = expr_label
            else: self.std_display = expr_label
        if result is not None:
            tk.Label(display, textvariable=result, bg=C["bg"], fg=C["text"],
                     font=(HEAD_FONT, 44), anchor="e", justify="right").pack(fill="x", pady=(4, 0))
        return display

    def _flat_key(self, parent: tk.Widget, text: str, command: Callable[[], None], *,
                  bg: str | None = None, fg: str | None = None, font_size: int = 18) -> tk.Button:
        base = bg or C["panel3"]
        foreground = fg or C["text"]
        hover = C.get("button_hover", C["mint"] if base == C["cyan"] else C["sapphire_dark"])
        active_fg = C.get("button_text", "#FFFFFF") if self.theme_name == "Light" else "#FFFFFF"
        btn = tk.Button(parent, text=text, command=command, bg=base, fg=foreground,
                        activebackground=hover, activeforeground=active_fg,
                        relief="flat", bd=0, highlightthickness=1,
                        highlightbackground=C["line"], highlightcolor=C["cyan2"],
                        cursor="hand2", font=(FONT, font_size), padx=8, pady=11,
                        takefocus=True)
        btn.bind("<Enter>", lambda _e=None: _animate_bg(btn, base, hover))
        btn.bind("<Leave>", lambda _e=None: _animate_bg(btn, hover, base))
        btn.bind("<FocusIn>", lambda _e=None: btn.configure(highlightthickness=2, highlightbackground=C["cyan2"]))
        btn.bind("<FocusOut>", lambda _e=None: btn.configure(highlightthickness=1, highlightbackground=C["line"]))
        return btn

    def _build_standard_windows(self) -> None:
        self.standard_page = tk.Frame(self.view_container, bg=C["bg"])
        self.standard_page.pack(fill="both", expand=True)
        self.std_expr = tk.StringVar(value="")
        self.display_var = self.std_expr
        self.std_readout = tk.StringVar(value="0")
        self.std_status = tk.StringVar(value="Ready")
        self.std_memory = getattr(self, "std_memory", 0.0)
        self.std_last = getattr(self, "std_last", 0.0)
        self.std_result_shown = False
        self.std_error_shown = False
        layout = tk.Frame(self.standard_page, bg=C["bg"])
        layout.pack(fill="both", expand=True)
        history = self._history_panel(layout, "std_history_list")
        history.pack(side="right", fill="y")
        work = tk.Frame(layout, bg=C["bg"])
        work.pack(side="left", fill="both", expand=True)
        self._readout(work, self.std_expr, self.std_readout)
        memory = tk.Frame(work, bg=C["bg"])
        memory.pack(fill="x", padx=9, pady=(2, 6))
        for key in ("MC", "MR", "M+", "M-"):
            tk.Button(memory, text=key, command=lambda k=key: self.standard_key(k),
                      bg=C["bg"], fg=C["muted"], activebackground=C["panel3"],
                      relief="flat", bd=0, padx=13, pady=8, font=(FONT, 9)).pack(side="left")
        keypad = tk.Frame(work, bg=C["bg"])
        keypad.pack(side="bottom", fill="both", expand=True, padx=7, pady=(2, 5))
        rows = [
            ["%", "CE", "C", "⌫"],
            ["1/x", "x²", "x³", "√x"],
            ["∛x", "ʸ√x", "(", ")"],
            ["7", "8", "9", "÷"],
            ["4", "5", "6", "×"],
            ["1", "2", "3", "−"],
            ["±", "0", ".", "+"],
            ["(", ")", "Ans", "="],
        ]
        self._make_key_grid(keypad, rows, self.standard_key, columns=4, equals=True)
        self.std_status.set("Ready")

    def _make_key_grid(self, parent: tk.Widget, rows: list[list[str]], callback: Callable[[str], None],
                       columns: int, equals: bool = False) -> None:
        for col in range(columns):
            parent.grid_columnconfigure(col, weight=1, uniform="windows-key-columns")
        for r in range(len(rows)):
            parent.grid_rowconfigure(r, weight=1, uniform="windows-key-rows")
        for r, row in enumerate(rows):
            for col, key in enumerate(row):
                is_equal = equals and key == "="
                clear_keys = {"C", "CE", "AC", "⌫"}
                operation_keys = {"÷", "×", "−", "+", "=", "%"}
                function_keys = {"1/x", "x²", "x³", "√x", "∛x", "ʸ√x", "xʸ", "eˣ", "10ˣ", "ln", "log", "!"}
                if is_equal:
                    bg, fg = C.get("equals_surface", C["mint"]), C.get("button_text", C["bg"])
                elif key in clear_keys:
                    bg, fg = C["mint_dark"], C.get("clear_text", C["text"])
                elif key in operation_keys:
                    bg, fg = C.get("operation_surface", C["sapphire_dark"]), C.get("button_text", C["text"])
                elif key in function_keys:
                    bg, fg = C.get("function_surface", C["fusion_light"]), C.get("button_text", C["text"])
                else:
                    bg, fg = C.get("digit_surface", C["panel"]), C["text"]
                btn = self._flat_key(parent, key, lambda k=key: callback(k), bg=bg, fg=fg,
                                     font_size=19 if len(key) < 3 else 13)
                btn.grid(row=r, column=col, sticky="nsew", padx=1.5, pady=1.5)

    @staticmethod
    def _clear_current_entry_text(expression: str) -> str:
        """Remove the current operand without discarding earlier operations."""
        text = expression.rstrip()
        if not text:
            return ""
        # Remove a trailing numeric/scientific-notation literal.
        match = re.search(r"(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?$", text)
        if match:
            return text[:match.start()].rstrip()
        # Remove a trailing named constant or Ans token.
        match = re.search(r"(?:\bAns\b|\bpi\b|\be\b)$", text)
        if match:
            return text[:match.start()].rstrip()
        # If the current operand is a completed function call, remove that call.
        if text.endswith(")"):
            depth = 0
            for i in range(len(text)-1, -1, -1):
                if text[i] == ")": depth += 1
                elif text[i] == "(":
                    depth -= 1
                    if depth == 0:
                        j = i - 1
                        while j >= 0 and (text[j].isalpha() or text[j] == "_"):
                            j -= 1
                        return text[:j+1].rstrip()
        return text[:-1].rstrip()

    def _refresh_standard_memory_history(self) -> None:
        if getattr(self, "history_mode", None) is not None and self.history_mode.get() == "Memory" and hasattr(self, "std_history_list"):
            panel = self.std_history_list.master.master
            self._history_mode_changed(panel, "std_history_list", "Memory")

    def standard_key(self, key: str) -> None:
        current = self.std_expr.get()
        memory_keys = ("MC", "MR", "M+", "M-")

        if self.std_error_shown:
            if key in memory_keys and key != "MC":
                self.std_status.set("Clear the error before using memory.")
                return
            self.std_expr.set("")
            self.std_readout.set("0")
            current = ""
            self.std_error_shown = False
            if key in ("C", "AC", "CE", "⌫", "MC"):
                self.std_status.set("Ready")
                if key == "MC":
                    self.std_memory = 0.0
                return
            if key in ("÷", "×", "−", "+", "%"):
                current = "0"

        if key in memory_keys:
            if key == "MC":
                self.std_memory = 0.0
                self.std_status.set("Memory cleared")
            elif key == "MR":
                recalled = fmt(self.std_memory, 14)
                self.std_expr.set(recalled if self.std_result_shown else current + recalled)
                self.std_result_shown = False
                self.std_readout.set(self.std_expr.get() or "0")
            else:
                try:
                    value = self._standard_current_value()
                except CalculatorDivisionError as exc:
                    self.std_readout.set(exc.display_text)
                    self.std_status.set(str(exc))
                    self.std_error_shown = True
                    self.std_result_shown = False
                    return
                if key == "M+":
                    self.std_memory += value
                elif key == "M-":
                    self.std_memory -= value
                self.std_status.set(f"Memory: {fmt(self.std_memory)}")
            self._refresh_standard_memory_history()
            return

        if self.std_result_shown:
            shown = self.std_readout.get().replace(",", "")
            if key in tuple("0123456789") + (".", "00"):
                current = ""
                self.std_expr.set("")
                self.std_readout.set("0")
            elif key in ("C", "AC"):
                self.std_expr.set("")
                self.std_readout.set("0")
                self.std_result_shown = False
                self.std_status.set("Ready")
                return
            else:
                current = shown
                self.std_expr.set(current)
            self.std_result_shown = False

        if key in ("C", "AC"):
            self.std_expr.set("")
            self.std_readout.set("0")
            self.std_status.set("Ready")
        elif key == "CE":
            self.std_expr.set(self._clear_current_entry_text(current))
            self.std_readout.set("0")
        elif key == "⌫":
            self.std_expr.set(current[:-1])
            self.std_readout.set(self.std_expr.get() or "0")
        elif key == "=":
            self.standard_calculate()
            return
        elif key == "Ans":
            self.std_expr.set(current + str(self.std_last))
        elif key == "±":
            self.std_expr.set(apply_unary_expression(current, "negate"))
        elif key == "√x":
            self.std_expr.set(apply_unary_expression(current, "sqrt"))
        elif key == "∛x":
            self.std_expr.set(apply_unary_expression(current, "cbrt"))
        elif key == "ʸ√x":
            # Enter x first, select y-th root, then enter the index y.
            # Example: 27 → ʸ√x → 3 → = evaluates nthroot(27, 3).
            prefix, operand = split_last_operand(current)
            if operand is None:
                self.std_expr.set(current.rstrip() + "nthroot(")
            else:
                self.std_expr.set(prefix + f"nthroot({operand},")
        elif key == "x²":
            self.std_expr.set(apply_unary_expression(current, "square"))
        elif key == "x³":
            self.std_expr.set(apply_unary_expression(current, "cube"))
        elif key == "1/x":
            self.std_expr.set(apply_unary_expression(current, "reciprocal"))
        elif key == "%":
            self.std_expr.set(current + "%")
        elif key == "÷":
            self.std_expr.set(current + "/")
        elif key == "×":
            self.std_expr.set(current + "*")
        elif key == "−":
            self.std_expr.set(current + "-")
        else:
            # Includes the new opening/closing bracket keys.
            self.std_expr.set(current + key)
        self.std_readout.set(self.std_expr.get() or "0")

    def standard_calculate(self) -> None:
        expr = self.std_expr.get().strip()
        if not expr or expr.endswith("="):
            return
        try:
            completed_expr = close_open_parentheses(expr)
            cooked = normalize_standard_percent(completed_expr)
            cooked = re.sub(r"\bAns\b", str(self.std_last), cooked)
            value = safe_eval(cooked, self._eval_context())
            self.std_last = float(value)
            self.ans = value
            result = fmt(value, 12)
            self.std_readout.set(result)
            self.std_expr.set(completed_expr + " =")
            self.std_result_shown = True
            self.std_error_shown = False
            self.std_history_items = getattr(self, "std_history_items", [])
            self.std_history_items.append(f"{completed_expr} = {result}")
            self.std_history_items = self.std_history_items[-100:]
            if hasattr(self, "std_history_list") and self.history_mode.get() == "History":
                panel = self.std_history_list.master.master
                self._history_mode_changed(panel, "std_history_list", "History")
            self.std_status.set("Calculation complete")
            self._sync_variable_status()
        except CalculatorDivisionError as exc:
            label = exc.display_text
            self.std_expr.set(completed_expr + " =")
            self.std_readout.set(label)
            self.std_result_shown = False
            self.std_error_shown = True
            self.std_status.set(str(exc))
            self.std_history_items = getattr(self, "std_history_items", [])
            self.std_history_items.append(f"{completed_expr} = {label}")
            self.std_history_items = self.std_history_items[-100:]
            if hasattr(self, "std_history_list") and self.history_mode.get() == "History":
                panel = self.std_history_list.master.master
                self._history_mode_changed(panel, "std_history_list", "History")
        except Exception as exc:
            self.std_result_shown = False
            self.std_error_shown = True
            self.std_readout.set("Error")
            self.std_status.set(f"Error: {exc}")

    def _standard_current_value(self) -> float:
        if getattr(self, "std_result_shown", False):
            return float(self.std_readout.get().replace(",", ""))
        expr = self.std_expr.get().strip()
        if not expr:
            return float(self.std_last)
        return float(safe_eval(normalize_standard_percent(expr), self._eval_context()))

    def _reuse_standard_history(self, _event: Any = None) -> None:
        sel = self.std_history_list.curselection()
        if sel:
            item = self.std_history_list.get(sel[0]).split(" = ", 1)[0]
            self.std_expr.set(item); self.std_readout.set(item)



    def _build_scientific_windows(self) -> None:
        self.scientific_page = tk.Frame(self.view_container, bg=C["bg"])
        self.scientific_page.pack(fill="both", expand=True)
        self.sci_expr = tk.StringVar(value="")
        self.sci_readout = tk.StringVar(value="0")
        self.sci_result = tk.StringVar(value="")
        self.sci_angle_mode = tk.StringVar(value="DEG")
        self.angle_mode.set("DEG")
        self.sci_result_shown = False
        self.sci_error_shown = False
        self.sci_fe_mode = False
        self.sci_second = False
        self.sci_history = []
        layout = tk.Frame(self.scientific_page, bg=C["bg"])
        layout.pack(fill="both", expand=True)
        history = self._history_panel(layout, "sci_history_list"); history.pack(side="right", fill="y")
        work = tk.Frame(layout, bg=C["bg"]); work.pack(side="left", fill="both", expand=True)
        self._readout(work, self.sci_expr, self.sci_readout)
        controls = tk.Frame(work, bg=C["bg"]); controls.pack(fill="x", padx=12, pady=(0, 2))
        tk.Label(controls, text="ANGLE", bg=C["bg"], fg=C["muted"], font=(FONT, 9)).pack(side="left")
        ttk.Combobox(controls, textvariable=self.sci_angle_mode, state="readonly",
                     values=["DEG", "RAD"], width=6).pack(side="left", padx=7)
        self.sci_angle_mode.trace_add("write", lambda *_: self.angle_mode.set(self.sci_angle_mode.get()))
        tk.Button(controls, text="F-E", command=self._scientific_toggle_format,
                  bg=C["bg"], fg=C["text"], relief="flat", bd=0,
                  activebackground=C["panel3"], font=(FONT, 9)).pack(side="left", padx=12)
        memory = tk.Frame(work, bg=C["bg"]); memory.pack(fill="x", padx=10, pady=(0, 2))
        self.sci_memory = getattr(self, "sci_memory", 0.0)
        for key in ("MC", "MR", "M+", "M-"):
            tk.Button(memory, text=key, command=lambda k=key: self._scientific_memory_key(k),
                      bg=C["bg"], fg=C["muted"], relief="flat", bd=0,
                      activebackground=C["panel3"], font=(FONT, 9), padx=12, pady=5).pack(side="left")
        functions = tk.Frame(work, bg=C["bg"]); functions.pack(fill="x", padx=12, pady=(0, 4))
        trig_menu = tk.Menubutton(functions, text="△  Trigonometry  ▾", bg=C["bg"], fg=C["text"],
                                  activebackground=C["panel3"], relief="flat", bd=0,
                                  font=(FONT, 9), cursor="hand2")
        trig_drop = tk.Menu(trig_menu, tearoff=0)
        for fn in ("sin", "cos", "tan", "sec", "csc", "cot", "asin", "acos", "atan", "sinh", "cosh", "tanh"):
            trig_drop.add_command(label=fn, command=lambda f=fn: self.scientific_key(f))
        trig_menu.configure(menu=trig_drop); trig_menu.pack(side="left", padx=5)
        function_menu = tk.Menubutton(functions, text="ƒ  Function  ▾", bg=C["bg"], fg=C["text"],
                                      activebackground=C["panel3"], relief="flat", bd=0,
                                      font=(FONT, 9), cursor="hand2")
        function_drop = tk.Menu(function_menu, tearoff=0)
        for fn in ("abs", "floor", "ceil", "round", "factorial", "sqrt", "cbrt", "1/x", "log", "ln", "eˣ"):
            function_drop.add_command(label=fn, command=lambda f=fn: self.scientific_key(f))
        function_drop.add_command(label="y-th root of x", command=lambda: self.scientific_key("ʸ√x"))
        function_menu.configure(menu=function_drop); function_menu.pack(side="left", padx=10)
        deck = tk.Frame(work, bg=C["bg"]); deck.pack(side="bottom", fill="both", expand=True, padx=5, pady=5)
        rows = [
            ["2nd", "π", "e", "C", "⌫"],
            ["x²", "x³", "|x|", "x!", "mod"],
            ["√x", "∛x", "ʸ√x", "(", ")"],
            ["xʸ", "7", "8", "9", "÷"],
            ["eˣ", "4", "5", "6", "×"],
            ["log", "1", "2", "3", "−"],
            ["ln", "±", "0", ".", "+"],
            ["10ˣ", "Ans", "RAD", "DEG", "="],
        ]
        self._make_key_grid(deck, rows, self.scientific_key, columns=5, equals=True)

    def scientific_key(self, key: str) -> None:
        """Handle Scientific keypad and menu input, including roots and powers."""
        current = self.sci_expr.get()
        unary_keys = {
            "sin": "sin", "cos": "cos", "tan": "tan", "sec": "sec",
            "csc": "csc", "cot": "cot", "asin": "asin", "acos": "acos",
            "atan": "atan", "sinh": "sinh", "cosh": "cosh", "tanh": "tanh",
            "log": "log", "ln": "ln", "exp": "exp", "eˣ": "exp",
            "sqrt": "sqrt", "√x": "sqrt", "cbrt": "cbrt", "∛x": "cbrt",
            "|x|": "abs", "abs": "abs", "floor": "floor",
            "ceil": "ceil", "round": "round", "factorial": "factorial",
            "n!": "factorial", "x!": "factorial",
        }
        operators = ("÷", "×", "−", "+", "mod", "%", "xʸ", "^")

        if key == "2nd":
            self.sci_second = not getattr(self, "sci_second", False)
            if hasattr(self, "sci_status"):
                self.sci_status.set("2nd functions enabled" if self.sci_second else "")
            return

        # Start a fresh expression after an error, but let C clear the screen.
        if self.sci_error_shown:
            if key in ("C", "AC"):
                self.sci_expr.set("")
                self.sci_readout.set("0")
                self.sci_result.set("")
                self.sci_error_shown = False
                self.sci_result_shown = False
                return
            current = "0" if key in operators else ""
            self.sci_expr.set(current)
            self.sci_readout.set(current or "0")
            self.sci_error_shown = False

        # Use the previous result as the first operand for operators/functions,
        # but begin a new number when a digit, decimal or constant is entered.
        if self.sci_result_shown:
            shown = self.sci_readout.get().replace(",", "")
            if key in tuple("0123456789") + (".", "π", "e", "("):
                current = ""
                self.sci_expr.set("")
                self.sci_readout.set("0")
            elif key in ("C", "AC"):
                self.sci_expr.set("")
                self.sci_readout.set("0")
                self.sci_result.set("")
                self.sci_result_shown = False
                return
            else:
                current = shown
                self.sci_expr.set(current)
            self.sci_result_shown = False

        if key in ("C", "AC"):
            self.sci_expr.set("")
            self.sci_readout.set("0")
            self.sci_result.set("")
        elif key in ("⌫", "DEL"):
            self.sci_expr.set(current[:-1])
        elif key == "=":
            self.scientific_calculate()
            return
        elif key in ("RAD", "DEG"):
            self.sci_angle_mode.set(key)
            self.angle_mode.set(key)
            return
        elif key in unary_keys:
            operation = unary_keys[key]
            if self.sci_second and key in ("sin", "cos", "tan"):
                operation = {"sin": "asin", "cos": "acos", "tan": "atan"}[key]
                self.sci_second = False
            self.sci_expr.set(apply_unary_expression(current, operation))
        elif key == "ʸ√x":
            # Enter x first, press y-th root, then enter the index y.
            # Example: 27 → ʸ√x → 3 → = becomes nthroot(27,3).
            prefix, operand = split_last_operand(current)
            if operand is None:
                self.sci_expr.set(current.rstrip() + "nthroot(")
            else:
                self.sci_expr.set(prefix + f"nthroot({operand},")
        elif key == "π":
            prefix, operand = split_last_operand(current)
            self.sci_expr.set(current + ("*" if operand is not None else "") + "pi")
        elif key == "e":
            prefix, operand = split_last_operand(current)
            self.sci_expr.set(current + ("*" if operand is not None else "") + "e")
        elif key == "x²":
            self.sci_expr.set(apply_unary_expression(current, "square"))
        elif key == "x³":
            self.sci_expr.set(apply_unary_expression(current, "cube"))
        elif key == "xʸ":
            self.sci_expr.set(current + "**")
        elif key == "10ˣ":
            prefix, operand = split_last_operand(current)
            self.sci_expr.set(prefix + f"(10**({operand}))" if operand is not None else current + "10**")
        elif key == "1/x":
            self.sci_expr.set(apply_unary_expression(current, "reciprocal"))
        elif key == "mod":
            self.sci_expr.set(current + "%")
        elif key == "÷":
            self.sci_expr.set(current + "/")
        elif key == "×":
            self.sci_expr.set(current + "*")
        elif key == "−":
            self.sci_expr.set(current + "-")
        elif key == "±":
            self.sci_expr.set(apply_unary_expression(current, "negate"))
        elif key == "^":
            self.sci_expr.set(current + "**")
        else:
            # Implicit multiplication when a digit follows a constant or group.
            if key in tuple("0123456789") + ("(",) and current.rstrip().endswith(("pi", "e", "Ans", ")")):
                self.sci_expr.set(current + "*" + key)
            else:
                self.sci_expr.set(current + key)

        self.sci_fe_mode = False
        self.sci_readout.set(self.sci_expr.get() or "0")

    def scientific_calculate(self) -> None:
        expr = self.sci_expr.get().strip()
        if not expr:
            return
        try:
            self.angle_mode.set(self.sci_angle_mode.get())
            completed_expr = close_open_parentheses(expr)
            cooked = re.sub(r"\bAns\b", str(self.ans), completed_expr).replace("π", "pi")
            value = safe_eval(cooked, self._eval_context())
            self.ans = value
            result = fmt(value, 14)
            self.sci_readout.set(result)
            self.sci_result.set(result)
            self.sci_result_shown = True
            self.sci_error_shown = False
            self.sci_fe_mode = False
            self.sci_history_items = getattr(self, "sci_history_items", [])
            self.sci_history_items.append(f"{completed_expr} = {result}")
            self.sci_history_items = self.sci_history_items[-100:]
            if hasattr(self, "sci_history_list") and self.history_mode.get() == "History":
                panel = self.sci_history_list.master.master
                self._history_mode_changed(panel, "sci_history_list", "History")
            self._sync_variable_status()
        except CalculatorDivisionError as exc:
            label = exc.display_text
            self.sci_result.set(label)
            self.sci_readout.set(label)
            self.sci_result_shown = False
            self.sci_error_shown = True
            self.sci_fe_mode = False
            if hasattr(self, "sci_status"):
                self.sci_status.set(str(exc))
            self.sci_history_items = getattr(self, "sci_history_items", [])
            self.sci_history_items.append(f"{completed_expr} = {label}")
            self.sci_history_items = self.sci_history_items[-100:]
            if hasattr(self, "sci_history_list") and self.history_mode.get() == "History":
                panel = self.sci_history_list.master.master
                self._history_mode_changed(panel, "sci_history_list", "History")
        except Exception as exc:
            self.sci_result.set(f"Error: {exc}")
            self.sci_readout.set("Error")
            self.sci_result_shown = False
            self.sci_error_shown = True
            self.sci_fe_mode = False

    def _reuse_scientific_history(self, _event: Any = None) -> None:
        sel = self.sci_history_list.curselection()
        if sel:
            item = self.sci_history_list.get(sel[0]).split(" = ", 1)[0]
            self.sci_expr.set(item)
            self.sci_readout.set(item)
            self.sci_result_shown = False

    def _global_keypress(self, event: tk.Event):
        """Global keyboard map. Dispatches through the same logic as on-screen keys."""
        ctrl = bool(event.state & 0x4)
        shift = bool(event.state & 0x1)
        key = event.keysym.lower()
        if ctrl:
            pages = {"1": "Standard", "2": "Scientific", "3": "Graphing",
                     "4": "Date Calculator", "5": "Converter",
                     "6": "Financial tool", "7": "Formula Library",
                     "8": "Laboratories"}
            if key in pages:
                self._show_page(pages[key]); return "break"
            if key == "0" and self.current_page == "Graphing":
                self._reset_surface(); return "break"
            if shift and key == "s" and self.current_page == "Graphing":
                self._export_graph_image(); return "break"
            if key == "l":
                if self.current_page == "Scientific": self.scientific_key("C")
                elif self.current_page == "Standard": self.standard_key("C")
                elif self.current_page == "Graphing": self.draw_surface()
                return "break"
        if event.keysym == "F5" and self.current_page == "Graphing":
            self.draw_surface(); return "break"
        if event.keysym == "F6":
            try:
                target = self.sci_display if self.current_page == "Scientific" else self.std_display
                target.focus_set(); return "break"
            except Exception:
                pass
        if event.keysym in ("Return", "KP_Enter") or event.char == "=":
            if self.current_page == "Scientific": self.scientific_calculate()
            elif self.current_page == "Standard": self.standard_calculate()
            elif self.current_page == "Graphing": self.draw_surface()
            return "break"
        if event.keysym == "Escape":
            if self.current_page == "Scientific": self.scientific_key("C")
            elif self.current_page == "Standard": self.standard_key("C")
            return "break"
        if self.current_page not in ("Standard", "Scientific"):
            return
        if event.keysym == "BackSpace":
            self.standard_key("⌫") if self.current_page == "Standard" else self.scientific_key("DEL")
            return "break"
        if event.keysym == "Delete":
            self.standard_key("C") if self.current_page == "Standard" else self.scientific_key("C")
            return "break"
        char = event.char
        if not char:
            return
        if self.current_page == "Standard":
            mapping = {"*": "×", "/": "÷", "-": "−"}
            if char in "0123456789.+-*/()%":
                self.standard_key(mapping.get(char, char)); return "break"
            if char in "()": self.standard_key(char); return "break"
        else:
            mapping = {"*": "×", "/": "÷", "-": "−", "^": "xʸ"}
            if char in "0123456789.+-*/()%^()":
                self.scientific_key(mapping.get(char, char)); return "break"
        return

    # ----- Unified Converter workspace --------------------------------------
    def _converter_categories(self) -> list[str]:
        """Return every supported converter family in a predictable browse order."""
        preferred = [
            "Currency", "Length", "Area", "Volume", "Mass", "Temperature",
            "Speed", "Acceleration", "Force", "Pressure", "Energy", "Power",
            "Frequency", "Time", "Angle", "Data storage", "Data transfer rate",
            "Fuel economy", "Flow rate", "Mass flow rate", "Concentration",
            "Molar concentration", "Viscosity (kinematic)", "Dynamic viscosity",
            "Specific heat capacity", "Thermal conductivity", "Torque",
            "Electric current", "Voltage", "Electrical resistance", "Electric charge",
            "Capacitance", "Inductance", "Magnetic flux", "Magnetic flux density",
            "Electric field strength", "Amount of substance", "Luminous intensity",
            "Luminous flux", "Illuminance", "Luminance", "Radiation dose",
            "Equivalent dose", "Radioactivity"
        ]
        return [name for name in preferred if name == "Currency" or name == "Temperature" or name in UNIT_SPECS]

    def _build_converter_hub(self, initial_category: str = "Length") -> None:
        """Single Converter page with category switching and all unit families inside."""
        page = tk.Frame(self.view_container, bg=C["bg"])
        page.pack(fill="both", expand=True, padx=18, pady=12)
        heading = tk.Frame(page, bg=C["bg"])
        heading.pack(fill="x", pady=(0, 10))
        tk.Label(heading, text="CONVERTER", bg=C["bg"], fg=C["text"],
                 font=(HEAD_FONT, 20, "bold")).pack(anchor="w")
        tk.Label(heading,
                 text="One workspace for everyday, scientific, engineering and currency conversions.",
                 bg=C["bg"], fg=C["muted"], font=(FONT, 9)).pack(anchor="w", pady=(3, 0))

        selector = tk.Frame(page, bg=C["panel"], highlightthickness=1,
                            highlightbackground=C["line"])
        selector.pack(fill="x", pady=(0, 10))
        tk.Label(selector, text="CONVERSION CATEGORY", bg=C["panel"], fg=C["muted"],
                 font=(FONT, 8, "bold")).pack(side="left", padx=(14, 10), pady=11)
        categories = self._converter_categories()
        if initial_category not in categories:
            initial_category = "Length"
        self.converter_hub_category = tk.StringVar(value=initial_category)
        self.converter_category_box = ttk.Combobox(
            selector, textvariable=self.converter_hub_category, values=categories,
            state="readonly", width=30
        )
        self.converter_category_box.pack(side="left", padx=(0, 12), pady=7)
        tk.Label(selector, text=f"{len(categories)} conversion families", bg=C["panel"],
                 fg=C["cyan2"], font=(FONT, 9, "bold")).pack(side="left", padx=8)
        self.converter_work_area = tk.Frame(page, bg=C["bg"])
        self.converter_work_area.pack(fill="both", expand=True)
        self.converter_category_box.bind(
            "<<ComboboxSelected>>",
            lambda _e=None: self._open_converter_category(self.converter_hub_category.get())
        )
        self._open_converter_category(initial_category)

    def _open_converter_category(self, category: str) -> None:
        """Rebuild only the conversion panel when the category selector changes."""
        if not hasattr(self, "converter_work_area") or not self.converter_work_area.winfo_exists():
            return
        for child in self.converter_work_area.winfo_children():
            child.destroy()
        self._build_windows_converter(category, parent=self.converter_work_area)

    # ----- Windows-style converters -----------------------------------------
    def _build_windows_converter(self, category: str, parent: tk.Widget | None = None) -> None:
        self.converter_category_name = category
        self.converter_amount = getattr(self, "converter_amount", tk.StringVar(value="0"))
        self.converter_amount.set(getattr(self, "last_converter_amount", "0"))
        self.converter_from = tk.StringVar(value="United States - Dollar" if category == "Currency" else "Fahrenheit" if category == "Temperature" else "")
        self.converter_to = tk.StringVar(value="Europe - Euro" if category == "Currency" else "Celsius" if category == "Temperature" else "")
        if category not in ("Currency", "Temperature"):
            available_units = self._converter_units(category)
            if available_units:
                self.converter_from.set(available_units[0])
                self.converter_to.set(available_units[1] if len(available_units) > 1 else available_units[0])
        self.converter_result = tk.StringVar(value="0")
        self.converter_rate_info = tk.StringVar(value="")
        self.converter_input_display = tk.StringVar(value="0")
        self.converter_output_display = tk.StringVar(value="0")
        self.currency_rate = None

        host = parent if parent is not None else self.view_container
        shell = tk.Frame(host, bg=C["bg"])
        shell.pack(fill="both", expand=True)
        left = tk.Frame(shell, bg=C["bg"])
        left.pack(side="left", fill="both", expand=True, padx=(8, 12), pady=8)
        right = tk.Frame(shell, bg=C["bg"])
        right.pack(side="right", fill="both", expand=True, padx=(8, 0), pady=8)
        left.grid_columnconfigure(0, weight=1)
        left.grid_rowconfigure(0, weight=1)
        left.grid_rowconfigure(1, weight=1)

        source = tk.Frame(left, bg=C["bg"])
        source.grid(row=0, column=0, sticky="nsew", pady=(5, 6))
        target = tk.Frame(left, bg=C["bg"])
        target.grid(row=1, column=0, sticky="nsew", pady=(6, 5))

        source_symbol = self._currency_symbol(self.converter_from.get()) if category == "Currency" else ""
        target_symbol = self._currency_symbol(self.converter_to.get()) if category == "Currency" else ""
        source_row = tk.Frame(source, bg=C["bg"]); source_row.pack(fill="x", pady=(20, 5))
        self.source_symbol_label = tk.Label(source_row, text=source_symbol, bg=C["bg"], fg=C["text"], font=(FONT, 22))
        self.source_symbol_label.pack(side="left", padx=(5, 7))
        tk.Label(source_row, textvariable=self.converter_input_display, bg=C["bg"], fg=C["text"],
                 font=(FONT, 42), anchor="w").pack(side="left", fill="x", expand=True)
        units_from = self._converter_units(category)
        if category == "Currency":
            units_from = [CURRENCY_DISPLAY_NAMES.get(code, code) for code in CURRENCY_CODES]
        self.converter_from_box = ttk.Combobox(source, textvariable=self.converter_from,
                                               values=units_from, state="readonly", width=30)
        self.converter_from_box.pack(anchor="w", padx=6, pady=(0, 5))
        self.converter_from_box.bind("<<ComboboxSelected>>", lambda _e=None: self._converter_selection_changed())

        target_row = tk.Frame(target, bg=C["bg"]); target_row.pack(fill="x", pady=(28, 5))
        self.target_symbol_label = tk.Label(target_row, text=target_symbol, bg=C["bg"], fg=C["text"], font=(FONT, 22))
        self.target_symbol_label.pack(side="left", padx=(5, 7))
        tk.Label(target_row, textvariable=self.converter_output_display, bg=C["bg"], fg=C["text"],
                 font=(FONT, 34), anchor="w").pack(side="left", fill="x", expand=True)
        self.converter_to_box = ttk.Combobox(target, textvariable=self.converter_to,
                                             values=units_from, state="readonly", width=30)
        self.converter_to_box.pack(anchor="w", padx=6, pady=(0, 5))
        self.converter_to_box.bind("<<ComboboxSelected>>", lambda _e=None: self._converter_selection_changed())

        info = tk.Frame(target, bg=C["bg"]); info.pack(fill="x", side="bottom", pady=(12, 4))
        if category == "Currency":
            self.converter_rate_info.set("Rates are fetched from the Frankfurter reference-rate service.")
            tk.Label(info, textvariable=self.converter_rate_info, bg=C["bg"], fg=C["muted"],
                     font=(FONT, 8), justify="left", anchor="w").pack(fill="x")
            link = tk.Button(info, text="Update rates", command=self._request_currency_rate,
                             bg=C["bg"], fg=C["cyan"], relief="flat", bd=0,
                             activebackground=C["bg"], cursor="hand2", anchor="w")
            link.pack(anchor="w", pady=(5, 0))
        elif category == "Temperature":
            tk.Label(info, text="About equal to", bg=C["bg"], fg=C["muted"],
                     font=(FONT, 8)).pack(anchor="w")
            self.temperature_kelvin = tk.StringVar(value="")
            tk.Label(info, textvariable=self.temperature_kelvin, bg=C["bg"], fg=C["text"],
                     font=(FONT, 9, "bold")).pack(anchor="w")

        pad = tk.Frame(right, bg=C["bg"])
        pad.pack(fill="both", expand=True, padx=(6, 0), pady=(35, 5))
        actions = tk.Frame(pad, bg=C["bg"])
        actions.pack(fill="x", pady=(0, 3))
        for key in ("CE", "⌫"):
            self._flat_key(actions, key, lambda k=key: self._converter_key(k),
                           bg=C["panel3"], font_size=17).pack(side="left", fill="both", expand=True, padx=2, pady=2, ipady=18)
        digits = tk.Frame(pad, bg=C["bg"])
        digits.pack(fill="both", expand=True)
        rows = [["7", "8", "9"], ["4", "5", "6"], ["1", "2", "3"], ["±", "0", "."]]
        for c in range(3): digits.grid_columnconfigure(c, weight=1, uniform="convcols")
        for r in range(4): digits.grid_rowconfigure(r, weight=1, uniform="convrows")
        for r, row in enumerate(rows):
            for c, key in enumerate(row):
                self._flat_key(digits, key, lambda k=key: self._converter_key(k),
                               bg=C["panel"], font_size=21).grid(
                                   row=r, column=c, sticky="nsew", padx=2, pady=2)
        self._update_converter_display()
        if category == "Currency":
            self._request_currency_rate()

    def _converter_units(self, category: str) -> list[str]:
        if category == "Currency": return [CURRENCY_DISPLAY_NAMES.get(code, code) for code in CURRENCY_CODES]
        if category == "Temperature": return ["Fahrenheit", "Celsius", "Kelvin"]
        if category == "Weight and mass": category = "Mass"
        if category == "Data": category = "Data storage"
        return list(UNIT_SPECS.get(category, {}))

    @staticmethod
    def _currency_code(display: str) -> str:
        if display in CURRENCY_CODES:
            return display
        return CURRENCY_DISPLAY_TO_CODE.get(display, display.split(" - ", 1)[0])

    @staticmethod
    def _currency_symbol(code: str) -> str:
        code = CalculatorApp._currency_code(code)
        symbols = {"USD":"$", "EUR":"€", "GBP":"£", "INR":"₹", "JPY":"¥", "CNY":"¥",
                   "AUD":"$", "CAD":"$", "CHF":"CHF", "SGD":"$", "AED":"د.إ", "SAR":"﷼",
                   "NZD":"$", "KRW":"₩", "THB":"฿", "HKD":"$", "ZAR":"R", "BRL":"R$"}
        return symbols.get(code, code)

    def _converter_selection_changed(self) -> None:
        if self.converter_category_name == "Currency":
            self.source_symbol_label.configure(text=self._currency_symbol(self.converter_from.get()))
            self.target_symbol_label.configure(text=self._currency_symbol(self.converter_to.get()))
            self._request_currency_rate()
        self._update_converter_display()

    def _converter_key(self, key: str) -> None:
        raw = self.converter_amount.get()
        if key == "CE": raw = "0"
        elif key == "⌫": raw = raw[:-1] or "0"
        elif key == "±": raw = raw[1:] if raw.startswith("-") else "-" + raw
        elif key == ".":
            if "." not in raw: raw += "."
        else:
            raw = ("" if raw == "0" else raw) + key
        self.converter_amount.set(raw)
        self.last_converter_amount = raw
        self._update_converter_display()

    def _update_converter_display(self) -> None:
        try:
            amount = float(self.converter_amount.get() or "0")
            self.converter_input_display.set(fmt(amount, 10))
            cat = self.converter_category_name
            source, target = self.converter_from.get(), self.converter_to.get()
            if cat == "Currency":
                source = self._currency_code(source); target = self._currency_code(target)
                if source == target:
                    result = amount
                elif self.currency_rate is not None:
                    result = amount * self.currency_rate
                else:
                    result = 0.0
                self.converter_output_display.set(fmt(result, 10))
            else:
                keycat = "Mass" if cat == "Weight and mass" else "Data storage" if cat == "Data" else cat
                result = convert_unit_value(amount, keycat, source, target)
                self.converter_output_display.set(fmt(result, 10))
                if cat == "Temperature":
                    kelvin = convert_unit_value(amount, "Temperature", source, "Kelvin")
                    self.temperature_kelvin.set(f"{fmt(kelvin, 6)} K")
        except Exception as exc:
            self.converter_output_display.set("—")
            if hasattr(self, "converter_rate_info"):
                self.converter_rate_info.set(str(exc))

    def _request_currency_rate(self) -> None:
        source = self._currency_code(self.converter_from.get())
        target = self._currency_code(self.converter_to.get())
        if source == target:
            self.currency_rate = 1.0
            self._update_converter_display()
            self.converter_rate_info.set(f"1 {source} = 1 {target}")
            return
        self.converter_rate_info.set("Updating exchange rate…")
        self.currency_rate = None
        self._update_converter_display()
        threading.Thread(target=self._currency_worker, args=(source, target), daemon=True).start()

    def _currency_worker(self, source: str, target: str) -> None:
        try:
            url = f"https://api.frankfurter.dev/v2/rate/{source.lower()}/{target.lower()}"
            req = urllib.request.Request(url, headers={"User-Agent": "QuantumCalc/2.0"})
            with urllib.request.urlopen(req, timeout=12) as response:
                data = json.loads(response.read().decode("utf-8"))
            rate = float(data["rate"]); date = str(data.get("date", ""))
            self._background_queue.put(("currency_result", (source, target, rate, date)))
        except Exception as exc:
            self._background_queue.put(("currency_error", str(exc)))

    def _currency_error_safe(self, message: str) -> None:
        if hasattr(self, "converter_rate_info"):
            try:
                self.converter_rate_info.set(f"Rate unavailable: {message}")
            except tk.TclError:
                pass

    def _currency_rate_ready(self, source: str, target: str, rate: float, date: str) -> None:
        if source != self._currency_code(self.converter_from.get()) or target != self._currency_code(self.converter_to.get()): return
        self.currency_rate = rate
        self.converter_rate_info.set(f"1 {source} = {fmt(rate, 8)} {target}\nUpdated {date}")
        self._update_converter_display()

    # Compatibility methods used by retained finance/formula workspaces.
    def _refresh_converter_units(self) -> None:
        pass

    def swap_units(self) -> None:
        a, b = self.converter_from.get(), self.converter_to.get()
        self.converter_from.set(b); self.converter_to.set(a)
        self._converter_selection_changed()

    def convert_value(self) -> None:
        self._update_converter_display()

    # ----- Date, settings and secondary workspaces --------------------------
    def _build_date_windows(self) -> None:
        page = tk.Frame(self.view_container, bg=C["bg"]); page.pack(fill="both", expand=True, padx=25, pady=20)
        self.date_start = tk.StringVar(value=datetime.now().strftime("%Y-%m-%d"))
        self.date_end = tk.StringVar(value=datetime.now().strftime("%Y-%m-%d"))
        self.date_days = tk.StringVar(value="0")
        self.date_result = tk.StringVar(value="Choose two dates to calculate the difference.")
        tk.Label(page, text="Date Calculator", bg=C["bg"], fg=C["text"], font=(FONT, 22, "bold")).pack(anchor="w", pady=10)
        for label, var in (("Start date (YYYY-MM-DD)", self.date_start), ("End date (YYYY-MM-DD)", self.date_end), ("Days to add / subtract", self.date_days)):
            tk.Label(page, text=label, bg=C["bg"], fg=C["muted"], font=(FONT, 10)).pack(anchor="w", pady=(12, 4))
            styled_entry(page, var, width=24, font_size=14).pack(anchor="w", ipady=9)
        actions = tk.Frame(page, bg=C["bg"]); actions.pack(anchor="w", pady=17)
        neon_button(actions, "DIFFERENCE BETWEEN DATES", self._date_difference, width=25, height=2).pack(side="left", padx=3)
        neon_button(actions, "ADD DAYS TO START DATE", self._date_add_days, width=23, height=2).pack(side="left", padx=3)
        tk.Label(page, textvariable=self.date_result, bg=C["panel"], fg=C["text"],
                 font=(FONT, 14), padx=18, pady=18, justify="left").pack(fill="x", pady=10)

    def _date_difference(self) -> None:
        try:
            a = datetime.strptime(self.date_start.get(), "%Y-%m-%d").date()
            b = datetime.strptime(self.date_end.get(), "%Y-%m-%d").date()
            delta = (b-a).days
            self.date_result.set(f"Difference: {abs(delta):,} days\nDirection: {'after' if delta >= 0 else 'before'} the start date.")
        except Exception as exc: self.date_result.set(str(exc))

    def _date_add_days(self) -> None:
        try:
            a = datetime.strptime(self.date_start.get(), "%Y-%m-%d").date()
            result = a.fromordinal(a.toordinal()+int(self.date_days.get()))
            self.date_result.set(f"Result: {result.isoformat()}")
        except Exception as exc: self.date_result.set(str(exc))

    def _build_settings_windows(self) -> None:
        """Build appearance controls, shortcuts, accessibility and creator details."""
        page = tk.Frame(self.view_container, bg=C["bg"])
        page.pack(fill="both", expand=True)

        canvas = tk.Canvas(page, bg=C["bg"], highlightthickness=0, bd=0)
        scrollbar = ttk.Scrollbar(page, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=scrollbar.set)
        scrollbar.pack(side="right", fill="y")
        canvas.pack(side="left", fill="both", expand=True)
        content = tk.Frame(canvas, bg=C["bg"])
        window_id = canvas.create_window((0, 0), window=content, anchor="nw")
        content.bind("<Configure>", lambda _e=None: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<Configure>", lambda e=None: canvas.itemconfigure(window_id, width=(e.width if e is not None else canvas.winfo_width())))

        inner = tk.Frame(content, bg=C["bg"])
        inner.pack(fill="both", expand=True, padx=26, pady=23)
        tk.Label(inner, text="Settings", bg=C["bg"], fg=C["text"],
                 font=(HEAD_FONT, 25, "bold")).pack(anchor="w")
        tk.Label(inner, text="Personalize your QuantumCalc workspace and view application information.",
                 bg=C["bg"], fg=C["muted"], font=(FONT, 10)).pack(anchor="w", pady=(4, 18))

        # Appearance card.
        appearance = tk.Frame(inner, bg=C["panel"], highlightthickness=1,
                              highlightbackground=C["line"])
        appearance.pack(fill="x", pady=(0, 14))
        head = tk.Frame(appearance, bg=C.get("card_header_surface", C["panel"]))
        head.pack(fill="x", padx=13, pady=(13, 3))
        tk.Label(head, text="APPEARANCE", bg=C.get("card_header_surface", C["panel"]), fg=C["cyan2"],
                 font=(FONT, 11, "bold")).pack(side="left")
        tk.Label(head, text=f"Currently active: {self.theme_name} mode",
                 bg=C.get("card_header_surface", C["panel"]),
                 fg=C["muted"], font=(FONT, 9)).pack(side="right", padx=4)
        tk.Label(appearance, text="Choose the look that feels right. Your choice is saved and restored next time you open QuantumCalc.",
                 bg=C["panel"], fg=C["muted"], font=(FONT, 9), anchor="w",
                 justify="left", wraplength=900).pack(fill="x", padx=17, pady=(5, 12))

        choices = tk.Frame(appearance, bg=C["panel"])
        choices.pack(fill="x", padx=13, pady=(0, 15))
        choices.grid_columnconfigure(0, weight=1, uniform="themes")
        choices.grid_columnconfigure(1, weight=1, uniform="themes")

        def make_theme_card(parent: tk.Widget, col: int, name: str,
                            description: str, colors: tuple[str, str, str]) -> None:
            selected = self.theme_name == name
            card_bg = C.get("settings_selected_surface", C["panel3"]) if selected else C["panel2"]
            card_frame = tk.Frame(parent, bg=card_bg, highlightthickness=2 if selected else 1,
                                  highlightbackground=C.get("gold", C["cyan"]) if selected else C["line"])
            card_frame.grid(row=0, column=col, sticky="nsew", padx=4, pady=3)
            preview = tk.Frame(card_frame, bg=card_bg)
            preview.pack(fill="x", padx=12, pady=(12, 8))
            swatches = tk.Frame(preview, bg=card_bg)
            swatches.pack(anchor="w")
            for colour in colors:
                tk.Frame(swatches, bg=colour, width=38, height=22,
                         highlightthickness=0).pack(side="left", padx=(0, 5))
            tk.Label(card_frame, text=name.upper() + " MODE", bg=card_bg, fg=C["text"],
                     font=(FONT, 11, "bold")).pack(anchor="w", padx=12)
            tk.Label(card_frame, text=description, bg=card_bg, fg=C["muted"],
                     font=(FONT, 9), anchor="w", justify="left", wraplength=390).pack(
                         fill="x", padx=12, pady=(3, 10))
            action_text = "✓  CURRENT THEME" if selected else f"SWITCH TO {name.upper()}"
            action_bg = C.get("settings_action_surface", C["mint"]) if selected else C["cyan"]
            action_fg = C.get("button_text", C["text"]) if self.theme_name == "Light" else "#FFFFFF"
            action = tk.Button(card_frame, text=action_text,
                               command=lambda selected_name=name: self._change_theme(selected_name),
                               bg=action_bg, fg=action_fg,
                               activebackground=C.get("positive_hover", C.get("success_hover", C["mint_light"])),
                               activeforeground=action_fg, relief="flat", bd=0,
                               font=(FONT, 9, "bold"), padx=12, pady=9,
                               cursor="hand2", takefocus=True)
            action.pack(fill="x", padx=12, pady=(0, 12))

        make_theme_card(choices, 0, "Dark",
                        "Midnight Ocean surfaces with Sapphire blue and Emerald accents.",
                        ("#07131D", "#258EDB", "#13B98E"))
        make_theme_card(choices, 1, "Light",
                        "Pearl Frost surfaces, Champagne Gold accents and clear Midnight Navy text.",
                        ("#F8FAFF", "#D4AF72", "#B99559"))

        self.settings_status = tk.StringVar(value=f"{self.theme_name} mode is active.")
        tk.Label(appearance, textvariable=self.settings_status, bg=C["panel"], fg=C["mint"],
                 font=(FONT, 9, "bold"), anchor="w").pack(fill="x", padx=17, pady=(0, 13))

        # About / creator card.
        about = tk.Frame(inner, bg=C["panel"], highlightthickness=1,
                         highlightbackground=C["line"])
        about.pack(fill="x", pady=(0, 14))
        tk.Label(about, text="ABOUT QUANTUMCALC STUDIO", bg=C.get("card_header_surface", C["panel"]), fg=C["cyan2"],
                 font=(FONT, 11, "bold")).pack(fill="x", anchor="w", padx=13, pady=(13, 8), ipady=5)
        tk.Label(about, text="An integrated workspace for mathematics, science, finance, conversions, graphing and analytical experiments.",
                 bg=C["panel"], fg=C["text"], font=(FONT, 10), wraplength=950,
                 justify="left", anchor="w").pack(fill="x", padx=17, pady=(0, 10))
        info = tk.Frame(about, bg=C.get("developer_surface", C["panel2"]),
                        highlightthickness=1, highlightbackground=C.get("line2", C["line"]))
        info.pack(fill="x", padx=13, pady=(0, 13))
        info_bg = C.get("developer_surface", C["panel2"])
        tk.Label(info, text="CREATOR / DEVELOPER", bg=info_bg, fg=C["muted"],
                 font=(FONT, 8, "bold")).pack(anchor="w", padx=12, pady=(10, 2))
        tk.Label(info, text=DEVELOPER_NAME, bg=info_bg, fg=C["text"],
                 font=(HEAD_FONT, 15, "bold")).pack(anchor="w", padx=12)
        tk.Label(info, text=f"QuantumCalc Studio  •  Version {APP_VERSION}", bg=info_bg,
                 fg=C["cyan2"], font=(FONT, 9)).pack(anchor="w", padx=12, pady=(3, 10))

        # Keyboard shortcuts.
        shortcuts = [
            ("Ctrl + 1 … 8", "Open the eight primary workspaces in sidebar order"),
            ("Enter", "Calculate the current expression or render the graph"),
            ("Esc", "Clear the current calculator entry"),
            ("F5", "Refresh the graph"),
            ("Ctrl + Shift + S", "Export the graph as PNG, SVG or PDF"),
            ("Ctrl + 0", "Reset the graph view"),
            ("Tab / Shift + Tab", "Move keyboard focus through controls"),
            ("F6", "Focus the active calculator expression"),
        ]
        wrap = tk.Frame(inner, bg=C["panel"], highlightthickness=1,
                        highlightbackground=C["line"])
        wrap.pack(fill="x", pady=(0, 14))
        tk.Label(wrap, text="KEYBOARD SHORTCUTS", bg=C["panel"], fg=C["cyan2"],
                 font=(FONT, 11, "bold")).pack(anchor="w", padx=16, pady=(14, 8))
        for i, (key, description) in enumerate(shortcuts):
            row = tk.Frame(wrap, bg=C["panel2"] if i % 2 == 0 else C["panel"])
            row.pack(fill="x", padx=10, pady=1)
            tk.Label(row, text=key, bg=row.cget("bg"), fg=C["cyan2"],
                     font=(MONO, 9, "bold"), width=22, anchor="w", padx=8, pady=8).pack(side="left")
            tk.Label(row, text=description, bg=row.cget("bg"), fg=C["text"],
                     font=(FONT, 9), anchor="w", justify="left").pack(side="left", fill="x", expand=True, padx=8)

        accessibility = tk.Frame(inner, bg=C["panel"], highlightthickness=1,
                                  highlightbackground=C["line"])
        accessibility.pack(fill="x", pady=(0, 18))
        tk.Label(accessibility, text="ACCESSIBILITY & DISPLAY", bg=C["panel"], fg=C["cyan2"],
                 font=(FONT, 11, "bold")).pack(anchor="w", padx=16, pady=(13, 6))
        tk.Label(accessibility,
                 text="The interface uses native Tk widgets and per-monitor DPI awareness. Text is rendered as native UI text, not scaled screenshots. Use the recommended display resolution and scaling setting for the clearest result.",
                 bg=C["panel"], fg=C["muted"], font=(FONT, 9), justify="left", anchor="w",
                 wraplength=950, padx=16).pack(fill="x", pady=(0, 14))

    def _console_write(self, message: str) -> None:
        # Console output remains available even when the compact calculator page is active.
        if not hasattr(self, "console_log"):
            self.console_log = []
        self.console_log.append(message)
        if hasattr(self, "console"):
            try:
                self.console.configure(state="normal"); self.console.insert("end", message+"\n\n")
                self.console.see("end"); self.console.configure(state="disabled")
            except tk.TclError: pass

    def _sync_variable_status(self) -> None:
        if hasattr(self, "var_r"):
            self.var_r.set(f"R: {fmt(self.variables.get('R', '—'), 5)}")
            self.var_t.set(f"T: {self.angle_mode.get()}")
            self.var_ans.set(f"Ans: {fmt(self.ans, 8)}")

    def key_press(self, key: str) -> None:
        # Compatibility for formula library insertion and cockpit calls.
        if self.current_page == "Scientific": self.scientific_key(key)
        else: self.standard_key(key)

    def calculate(self) -> None:
        if self.current_page == "Scientific": self.scientific_calculate()
        else: self.standard_calculate()

    def _build_calculators_workspace(self) -> None:
        self._build_standard_windows()

    def _build_standard_calculator(self) -> None:
        self._build_standard_windows()

    def _build_scientific_calculator(self) -> None:
        self._build_scientific_windows()

    def _build_converter(self) -> None:
        self._build_converter_hub("Length")

    def _clear_standard_history(self) -> None:
        self.std_history_items = []
        if hasattr(self, "std_history_list") and self.std_history_list.winfo_exists():
            self.std_history_list.delete(0, "end")
            self._history_mode_changed(self.std_history_list.master.master, "std_history_list", "History")

    def _copy_standard_result(self) -> None:
        self.root.clipboard_clear(); self.root.clipboard_append(self.std_readout.get())




class CalculatorDivisionError(ZeroDivisionError):
    """A calculator-friendly representation of an undefined division."""

    def __init__(self, numerator: Any = None, *, operation: str = "division") -> None:
        self.operation = operation
        self.is_indeterminate = operation == "division" and numerator == 0
        self.display_text = "Indeterminate" if self.is_indeterminate else "Undefined"
        if self.is_indeterminate:
            message = "Indeterminate: 0 ÷ 0 has no defined value."
        elif operation == "remainder":
            message = "Undefined: remainder by zero is not defined."
        else:
            message = "Undefined: division by zero is not defined."
        super().__init__(message)



def convert_unit_value(value: float, category: str, source: str, target: str) -> float:
    if category == "Temperature":
        if source.startswith("Celsius"):
            celsius = value
        elif source.startswith("Fahrenheit"):
            celsius = (value - 32) * 5 / 9
        else:
            celsius = value - 273.15
        if target.startswith("Celsius"):
            return celsius
        if target.startswith("Fahrenheit"):
            return celsius * 9 / 5 + 32
        return celsius + 273.15
    if category == "Fuel economy":
        if value <= 0:
            raise ValueError("Fuel economy values must be greater than zero.")
        if source == "L/100 km":
            km_per_litre = 100 / value
        else:
            km_per_litre = value * UNIT_SPECS[category][source]
        if target == "L/100 km":
            if km_per_litre <= 0:
                raise ValueError("Fuel economy must be positive for L/100 km conversion.")
            return 100 / km_per_litre
        return km_per_litre / UNIT_SPECS[category][target]
    factors = UNIT_SPECS[category]
    return value * factors[source] / factors[target]


def parse_matrix(text: str) -> list[list[float]]:
    raw_rows = [row.strip() for row in text.strip().split(";") if row.strip()]
    if not raw_rows:
        raise ValueError("Enter a matrix such as 1,2;3,4")
    rows: list[list[float]] = []
    for row in raw_rows:
        tokens = [value.strip() for value in row.split(",")]
        if not tokens or any(not value for value in tokens):
            raise ValueError("Each matrix row must contain comma-separated numeric values without empty entries.")
        try:
            values = [float(value) for value in tokens]
        except ValueError as exc:
            raise ValueError("Matrix entries must be valid numbers.") from exc
        if any(not math.isfinite(value) for value in values):
            raise ValueError("Matrix entries must be finite real numbers.")
        rows.append(values)
    width = len(rows[0])
    if any(len(row) != width for row in rows):
        raise ValueError("Every matrix row must have the same number of columns.")
    if len(rows) > 8 or width > 8:
        raise ValueError("Matrices are limited to 8 × 8 in this workspace.")
    return rows


def matrix_det(matrix: list[list[float]]) -> float:
    n = len(matrix)
    if any(len(row) != n for row in matrix):
        raise ValueError("Determinant requires a square matrix.")
    a = [row[:] for row in matrix]
    det, sign = 1.0, 1
    for i in range(n):
        pivot = max(range(i, n), key=lambda r: abs(a[r][i]))
        if abs(a[pivot][i]) < 1e-12:
            return 0.0
        if pivot != i:
            a[i], a[pivot] = a[pivot], a[i]
            sign *= -1
        p = a[i][i]
        det *= p
        for r in range(i + 1, n):
            factor = a[r][i] / p
            for col in range(i + 1, n):
                a[r][col] -= factor * a[i][col]
    return det * sign


def matrix_inverse(matrix: list[list[float]]) -> list[list[float]]:
    n = len(matrix)
    if any(len(row) != n for row in matrix):
        raise ValueError("Inverse requires a square matrix.")
    a = [row[:] + [1.0 if i == j else 0.0 for j in range(n)] for i, row in enumerate(matrix)]
    for i in range(n):
        pivot = max(range(i, n), key=lambda r: abs(a[r][i]))
        if abs(a[pivot][i]) < 1e-12:
            raise ValueError("This matrix is singular and has no inverse.")
        a[i], a[pivot] = a[pivot], a[i]
        div = a[i][i]
        a[i] = [v/div for v in a[i]]
        for r in range(n):
            if r != i:
                factor = a[r][i]
                a[r] = [a[r][c] - factor*a[i][c] for c in range(2*n)]
    return [row[n:] for row in a]


def matrix_rank(matrix: list[list[float]], tolerance: float = 1e-10) -> int:
    """Return the numerical rank using partial-pivot Gaussian elimination."""
    if not matrix or not matrix[0]:
        return 0
    a = [list(map(float, row)) for row in matrix]
    rows, cols = len(a), len(a[0])
    if any(len(row) != cols for row in a):
        raise ValueError("Every matrix row must have the same number of columns.")
    rank = 0
    for col in range(cols):
        pivot = max(range(rank, rows), key=lambda r: abs(a[r][col]), default=rank)
        if rank >= rows or abs(a[pivot][col]) <= tolerance:
            continue
        a[rank], a[pivot] = a[pivot], a[rank]
        pivot_value = a[rank][col]
        for r in range(rank + 1, rows):
            factor = a[r][col] / pivot_value
            for c in range(col, cols):
                a[r][c] -= factor * a[rank][c]
        rank += 1
        if rank == rows:
            break
    return rank


def matrix_solve(matrix: list[list[float]], rhs: list[float], tolerance: float = 1e-12) -> list[float]:
    """Solve a square linear system A·x=b with partial pivoting."""
    n = len(matrix)
    if n == 0 or any(len(row) != n for row in matrix):
        raise ValueError("Solving A·x=b requires a non-empty square matrix A.")
    if len(rhs) != n:
        raise ValueError("The right-hand-side vector must have one value per matrix row.")
    a = [list(map(float, matrix[i])) + [float(rhs[i])] for i in range(n)]
    for col in range(n):
        pivot = max(range(col, n), key=lambda r: abs(a[r][col]))
        if abs(a[pivot][col]) <= tolerance:
            raise ValueError("This system has no unique solution (matrix is singular).")
        a[col], a[pivot] = a[pivot], a[col]
        scale = a[col][col]
        a[col] = [v / scale for v in a[col]]
        for row in range(n):
            if row == col:
                continue
            factor = a[row][col]
            a[row] = [a[row][j] - factor * a[col][j] for j in range(n + 1)]
    return [a[i][-1] for i in range(n)]


def safe_eval(expression: str, variables: dict[str, Any] | None = None) -> Any:
    """Evaluate a restricted mathematical expression safely."""
    expr = expression.strip().replace("^", "**").replace("π", "pi").replace("√(", "sqrt(")
    expr = re.sub(r"√\s*((?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?)", r"sqrt(\1)", expr)
    expr = expr.replace("×", "*").replace("÷", "/").replace("−", "-")
    if not expr:
        raise ValueError("Enter an expression first.")
    tree = ast.parse(expr, mode="eval")
    names = dict(CONSTS)
    names.update(variables or {})

    def walk(node: ast.AST) -> Any:
        if isinstance(node, ast.Expression):
            return walk(node.body)
        if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
            return node.value
        if isinstance(node, ast.Name):
            if node.id in names:
                return names[node.id]
            raise ValueError(f"Unknown variable or constant: {node.id}")
        if isinstance(node, ast.BinOp) and type(node.op) in BINOPS:
            left, right = walk(node.left), walk(node.right)
            if isinstance(node.op, ast.Pow) and abs(float(right)) > 1000:
                raise ValueError("Exponent is too large.")
            if isinstance(node.op, (ast.Div, ast.FloorDiv)) and right == 0:
                raise CalculatorDivisionError(left, operation="division")
            if isinstance(node.op, ast.Mod) and right == 0:
                raise CalculatorDivisionError(left, operation="remainder")
            try:
                result = BINOPS[type(node.op)](left, right)
            except ZeroDivisionError as exc:
                # Also normalize a zero-division raised by an unusual numeric value.
                raise CalculatorDivisionError(left, operation="division") from exc
            if isinstance(result, int) and result.bit_length() > 14000:
                raise ValueError("Integer result is too large to display safely.")
            return result
        if isinstance(node, ast.UnaryOp) and type(node.op) in UNOPS:
            return UNOPS[type(node.op)](walk(node.operand))
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name):
            fn = names.get(node.func.id, FUNCS.get(node.func.id))
            if not callable(fn) or node.keywords:
                raise ValueError("Function is not allowed.")
            args = [walk(a) for a in node.args]
            if node.func.id == "factorial" and args:
                n = args[0]
                if isinstance(n, bool) or not isinstance(n, (int, float)):
                    raise ValueError("Factorial requires a whole number.")
                if isinstance(n, float) and (not math.isfinite(n) or not n.is_integer()):
                    raise ValueError("Factorial requires a whole number.")
                if n < 0 or n > 1500:
                    raise ValueError("Factorial accepts whole numbers from 0 to 1500.")
                args[0] = int(n)
            try:
                return fn(*args)
            except ZeroDivisionError as exc:
                raise CalculatorDivisionError(operation="division") from exc
        raise ValueError("Unsupported expression. Use numbers, operators and scientific functions.")

    result = walk(tree)
    if isinstance(result, complex):
        raise ValueError("This calculator currently displays real-number results only.")
    if isinstance(result, float) and not math.isfinite(result):
        raise ValueError("The result is not finite.")
    return result


def close_open_parentheses(expression: str) -> str:
    """Close only unmatched opening parentheses at the end of an expression."""
    balance = 0
    for char in expression:
        if char == "(":
            balance += 1
        elif char == ")":
            balance -= 1
    if balance < 0:
        return expression
    return expression + (")" * min(balance, 64))


def split_last_operand(expression: str) -> tuple[str, str | None]:
    """Split an expression into its prefix and final operand.

    Recognises numeric literals (including scientific notation), constants,
    Ans, grouped expressions, and complete function calls. If the expression
    ends in an operator or an opening parenthesis, no operand is returned.
    """
    text = expression.rstrip()
    if not text:
        return "", None
    if text.endswith(("+", "-", "*", "/", "%", "**", "(", ",")):
        return text, None

    if text.endswith(")"):
        depth = 0
        start = None
        for index in range(len(text) - 1, -1, -1):
            char = text[index]
            if char == ")":
                depth += 1
            elif char == "(":
                depth -= 1
                if depth == 0:
                    start = index
                    break
        if start is not None:
            # Include a function name immediately before the opening bracket.
            fn_start = start
            while fn_start > 0 and (text[fn_start - 1].isalnum() or text[fn_start - 1] == "_"):
                fn_start -= 1
            if fn_start < start:
                start = fn_start
            # Preserve a unary minus before a grouped operand, but not a binary subtraction.
            if start > 0 and text[start - 1] == "-" and (start - 1 == 0 or text[start - 2] in "+-*/%( "):
                start -= 1
            return text[:start].rstrip(), text[start:]

    match = re.search(r"(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?$", text)
    if match:
        start = match.start()
        # Keep a leading sign when it is unary (start of input or after an operator).
        if start > 0 and text[start - 1] == "-" and (start - 1 == 0 or text[start - 2] in "+-*/%( "):
            start -= 1
        return text[:start].rstrip(), text[start:]

    match = re.search(r"[A-Za-z_]\w*$", text)
    if match:
        start = match.start()
        if start > 0 and text[start - 1] == "-" and (start - 1 == 0 or text[start - 2] in "+-*/%( "):
            start -= 1
        return text[:start].rstrip(), text[start:]
    return text, None


def apply_unary_expression(expression: str, operation: str) -> str:
    """Apply a unary operation to the last operand, or start its entry prefix."""
    prefix, operand = split_last_operand(expression)
    if operand is None:
        if operation == "reciprocal":
            return expression.rstrip() + "1/("
        if operation == "sqrt":
            return expression.rstrip() + "sqrt("
        if operation in ("abs", "factorial", "cbrt", "sin", "cos", "tan", "sec", "csc", "cot",
                         "asin", "acos", "atan", "sinh", "cosh", "tanh", "ln", "log",
                         "exp", "floor", "ceil", "round"):
            return expression.rstrip() + operation + "("
        return expression

    if operation == "reciprocal":
        replacement = f"(1/({operand}))"
    elif operation == "sqrt":
        replacement = f"sqrt({operand})"
    elif operation == "square":
        replacement = f"({operand})**2"
    elif operation == "cube":
        replacement = f"({operand})**3"
    elif operation == "negate":
        replacement = operand[1:] if operand.startswith("-") else f"-({operand})"
    elif operation == "percent":
        replacement = f"({operand}/100)"
    else:
        replacement = f"{operation}({operand})"
    return (prefix + (" " if prefix and prefix[-1].isalnum() and replacement[0].isalpha() else "") + replacement)


def normalize_standard_percent(expression: str) -> str:
    """Handle common calculator percentage entry such as 250 + 10% or 80 * 5%."""
    expr = expression.strip()
    terminal = re.fullmatch(r"(.*?)([+\-*/])\s*(\d+(?:\.\d*)?|\.\d+)\s*%", expr)
    if terminal:
        left, op, number = terminal.groups()
        left = left.strip()
        if left:
            pct = f"(({number})/100)"
            if op == "+":
                return f"(({left}) + (({left})*{pct}))"
            if op == "-":
                return f"(({left}) - (({left})*{pct}))"
            if op == "*":
                return f"(({left}) * {pct})"
            if op == "/":
                return f"(({left}) / {pct})"
    # A standalone percentage, or percentages inside a longer expression.
    return re.sub(r"(\d+(?:\.\d*)?|\.\d+)\s*%", r"(\1/100)", expr)


def fmt(value: Any, digits: int = 8) -> str:
    if isinstance(value, int):
        return str(value)
    try:
        x = float(value)
        if not math.isfinite(x):
            return str(x)
        if abs(x) >= 1e9 or (0 < abs(x) < 1e-6):
            return f"{x:.{digits}g}"
        return f"{x:,.{digits}g}"
    except Exception:
        return str(value)


def money(value: float) -> str:
    return f"₹ {value:,.2f}"


def emi_payment(principal: float, annual_rate: float, months: float) -> float:
    if principal <= 0 or months <= 0 or annual_rate < 0:
        raise ValueError("Principal and tenure must be positive; rate cannot be negative.")
    r = annual_rate / 1200.0
    if abs(r) < 1e-14:
        return principal / months
    power = (1 + r) ** months
    return principal * r * power / (power - 1)


def solve_loan_rate(principal: float, payment: float, months: float) -> float:
    """Return nominal annual rate in percent, solved by bisection."""
    if principal <= 0 or payment <= 0 or months <= 0:
        raise ValueError("Principal, EMI and tenure must be positive.")
    min_payment = principal / months
    if payment < min_payment - 1e-9:
        raise ValueError("EMI is too small: it cannot repay the principal within this tenure, even at 0% interest.")
    if abs(payment - min_payment) < 1e-9:
        return 0.0

    def pmt(r: float) -> float:
        if r == 0:
            return principal / months
        q = (1 + r) ** months
        return principal * r * q / (q - 1)

    low, high = 0.0, 0.01
    while pmt(high) < payment and high < 10:
        high *= 2
    if pmt(high) < payment:
        raise ValueError("The implied interest rate is outside the supported range.")
    for _ in range(160):
        mid = (low + high) / 2
        if pmt(mid) < payment:
            low = mid
        else:
            high = mid
    return ((low + high) / 2) * 1200


def solve_loan_months(principal: float, payment: float, annual_rate: float) -> float:
    if principal <= 0 or payment <= 0 or annual_rate < 0:
        raise ValueError("Principal and EMI must be positive; rate cannot be negative.")
    r = annual_rate / 1200.0
    if r == 0:
        return principal / payment
    if payment <= principal * r:
        raise ValueError("EMI must be greater than the monthly interest amount.")
    return -math.log(1 - (principal * r / payment)) / math.log(1 + r)


# -----------------------------------------------------------------------------
# Reusable UI helpers
# -----------------------------------------------------------------------------
def card(parent: tk.Widget, title: str | None = None, subtitle: str | None = None,
         accent: str = "cyan") -> tk.Frame:
    """Raised Midnight Ocean card with a crisp Sapphire title rail."""
    frame = tk.Frame(parent, bg=C["panel"], relief="ridge", bd=2,
                     highlightthickness=1, highlightbackground=C["line"],
                     highlightcolor=C["cyan"])
    if title:
        head = tk.Frame(frame, bg=C["panel2"], relief="raised", bd=1,
                        highlightthickness=1, highlightbackground=C["line"])
        head.pack(fill="x", padx=8, pady=(8, 5))
        tk.Frame(head, bg=C["cyan"], width=2).pack(side="left", fill="y", padx=(0, 8))
        labels = tk.Frame(head, bg=C["panel2"])
        labels.pack(side="left", fill="both", expand=True, padx=(0, 8), pady=7)
        long_title = len(title) > 18
        tk.Label(labels, text=title, bg=C["panel2"], fg=C["text"],
                 font=(FONT, 10 if long_title else 12, "bold")).pack(side="left")
        if subtitle and not long_title:
            tk.Label(labels, text=subtitle, bg=C["panel2"], fg=C["cyan2"],
                     font=(FONT, 7 if len(title) > 15 else 8, "bold")).pack(side="right")
        tk.Frame(frame, bg=C["line"], height=2).pack(fill="x", padx=12, pady=(2, 6))
    return frame


def section_label(parent: tk.Widget, text: str) -> tk.Label:
    return tk.Label(parent, text=text.upper(), bg=C["panel"], fg=C["cyan2"],
                    font=(FONT, 8, "bold"))


def styled_entry(parent: tk.Widget, textvariable: tk.StringVar | None = None,
                 width: int = 18, font_size: int = 11) -> tk.Entry:
    """Inset control with Sapphire focus and a visibly recessed Ocean edge."""
    return tk.Entry(parent, textvariable=textvariable, width=width,
                    bg=C["bg2"], fg=C["text"], insertbackground=C["cyan"],
                    selectbackground=C["cyan"], selectforeground=C["black"],
                    relief="sunken", bd=3, highlightthickness=1,
                    highlightbackground=C["line"], highlightcolor=C["cyan"],
                    font=(MONO, font_size), disabledbackground=C["panel2"],
                    disabledforeground=C["muted"])


class Neon3DButton(tk.Frame):
    """Hexagonal graphite keycap with a layered turquoise glow and tactile press."""
    def __init__(self, parent: tk.Widget, text: str, command: Callable[[], None],
                 *, accent: str = "cyan", width: int | None = None,
                 height: int = 1, font_size: int = 10):
        parent_bg = parent.cget("bg") if "bg" in parent.keys() else C["panel"]
        super().__init__(parent, bg=parent_bg, bd=0, highlightthickness=0)
        self.label = text
        self.command = command
        self.font_size = font_size
        self.parent_bg = parent_bg
        self.base_width = max(38, (width * 7 + 22) if width else min(150, len(text) * 6 + 20))
        self.base_height = 38 + max(0, height - 1) * 4
        self.configure(width=self.base_width, height=self.base_height)
        self.pack_propagate(False)
        self.grid_propagate(False)
        self.hover = False
        self.pressed = False
        self.canvas = tk.Canvas(self, bg=parent_bg, highlightthickness=0,
                                width=self.base_width, height=self.base_height,
                                cursor="hand2", bd=0)
        self.canvas.pack(fill="both", expand=True)
        self.canvas.bind("<Configure>", lambda _e=None: self.draw())
        for widget in (self, self.canvas):
            widget.bind("<Enter>", self._enter)
            widget.bind("<Leave>", self._leave)
            widget.bind("<ButtonPress-1>", self._press)
            widget.bind("<ButtonRelease-1>", self._release)
        self.bind("<Configure>", lambda _e=None: self.draw())
        self.draw()

    def _enter(self, _event: Any = None) -> None:
        self.hover = True
        self.draw()

    def _leave(self, _event: Any = None) -> None:
        self.hover = False
        self.pressed = False
        self.draw()

    def _press(self, _event: Any = None) -> None:
        self.pressed = True
        self.draw()

    def _release(self, event: Any = None) -> None:
        was_pressed = self.pressed
        self.pressed = False
        self.draw()
        if was_pressed and event is not None:
            x, y = event.x, event.y
            if 0 <= x <= self.winfo_width() and 0 <= y <= self.winfo_height():
                self.command()

    @staticmethod
    def _hex_points(x0: float, y0: float, x1: float, y1: float) -> list[float]:
        """Flat-top six-sided keycap with clipped corners, like the reference keys."""
        cut = min((x1 - x0) * 0.24, (y1 - y0) * 0.30)
        mid = (y0 + y1) / 2
        return [x0 + cut, y0, x1 - cut, y0, x1, mid,
                x1 - cut, y1, x0 + cut, y1, x0, mid]

    def draw(self) -> None:
        if not self.winfo_exists():
            return
        c = self.canvas
        # Use the real cell allocation (not the requested size) so keys shrink
        # gracefully and remain aligned in narrow windows.
        w = max(1, c.winfo_width())
        h = max(1, c.winfo_height())
        if w < 8 or h < 8:
            return
        c.delete("all")

        # Keycaps are centered in their equal grid cells. Numeric keys remain
        # compact and near-regular; long command captions get a wider silhouette.
        avail_w = max(18, w - 5)
        avail_h = max(18, h - 5)
        key_h = min(46.0, avail_h)
        if len(self.label) <= 4:
            desired_w = key_h * 1.42
        else:
            desired_w = max(key_h * 1.42, len(self.label) * self.font_size * 0.52 + 18)
        key_w = min(avail_w, desired_w)
        # If width is the limiting dimension, scale height down to retain a
        # well-proportioned six-sided shape and keep the entire glow in-cell.
        key_h = min(key_h, key_w / (1.42 if len(self.label) <= 4 else 1.12))
        key_h = max(17.0, key_h)
        key_w = min(avail_w, max(key_w, key_h * 1.12))

        cx = w / 2
        cy = h / 2 + (1.5 if self.pressed else 0)
        x0, x1 = cx - key_w / 2, cx + key_w / 2
        y0, y1 = cy - key_h / 2, cy + key_h / 2
        if self.pressed:
            y0 += 1.5
            y1 += 1.5
        shape = self._hex_points

        # Sapphire halo and Emerald edge highlight, restrained to each key cell.
        for pad, color, line_w in ((3.2, C["shadow"], 3), (1.8, C["line"], 2),
                                   (0.5, C["cyan"], 1)):
            c.create_polygon(*shape(x0-pad, y0-pad, x1+pad, y1+pad),
                             fill="", outline=color, width=line_w)

        # Midnight Ocean extrusion, sapphire face and a cool top glint.
        c.create_polygon(*shape(x0+0.5, y0+3, x1-0.5, y1+4),
                         fill=C["shadow"], outline=C["line"], width=1)
        face = C["panel3"] if self.hover else C["panel"]
        if self.pressed:
            face = C["bg2"]
        c.create_polygon(*shape(x0, y0, x1, y1), fill=face,
                         outline=C["cyan2"] if self.hover else C["line2"], width=1.7)
        inset = min(2.5, key_h * 0.08)
        if key_w > 2*inset+8 and key_h > 2*inset+8:
            c.create_polygon(*shape(x0+inset, y0+inset, x1-inset, y1-inset),
                             fill="", outline=C["line"], width=1)
        c.create_line(cx-key_w*.20, y0+3, cx+key_w*.20, y0+3,
                      fill=C["mint_light"] if self.hover else C["cyan2"], width=1)
        ty = cy + (1 if self.pressed else -0.5)
        fsize = self.font_size
        # Fit long labels without clipping or sacrificing the hex silhouette.
        if len(self.label) > 9:
            fsize = max(6, fsize-3)
        elif len(self.label) > 5:
            fsize = max(7, fsize-2)
        elif len(self.label) > 3:
            fsize = max(8, fsize-1)
        c.create_text(cx+1, ty+1.5, text=self.label, fill=C["shadow"],
                      font=(FONT, fsize, "bold"))
        c.create_text(cx, ty, text=self.label,
                      fill="#FFFFFF" if self.hover else C["cyan2"],
                      font=(FONT, fsize, "bold"))


def neon_button(parent: tk.Widget, text: str, command: Callable[[], None],
                *, accent: str = "cyan", width: int | None = None,
                height: int = 2, font_size: int = 10) -> Neon3DButton:
    # All controls share the Sapphire & Emerald Signature keycap treatment.
    return Neon3DButton(parent, text, command, accent="fusion", width=width,
                        height=height, font_size=font_size)


def add_field(parent: tk.Widget, label: str, default: str = "", width: int = 18,
              row: int = 0, column: int = 0) -> tk.Entry:
    wrap = tk.Frame(parent, bg=C["panel"])
    wrap.grid(row=row, column=column, sticky="ew", padx=7, pady=6)
    tk.Label(wrap, text=label, bg=C["panel"], fg=C["muted"],
             font=(FONT, 9, "bold")).pack(anchor="w", pady=(0, 5))
    var = tk.StringVar(value=default)
    ent = styled_entry(wrap, var, width=width)
    ent.pack(fill="x", ipady=8)
    ent.var = var  # type: ignore[attr-defined]
    return ent


# -----------------------------------------------------------------------------
# Main application
# -----------------------------------------------------------------------------
class CalculatorApp:
    def __init__(self, root: tk.Tk):
        self.root = root
        self.theme_settings_path = os.path.join(
            os.path.dirname(os.path.abspath(__file__)), THEME_SETTINGS_FILENAME
        )
        self.theme_name = self._load_theme_preference()
        C.clear()
        C.update(THEME_PALETTES[self.theme_name])
        _configure_native_rendering(root)
        root.title("calculator | QuantumCalc — Scientific • Financial • Analytics")
        root.update_idletasks()
        screen_w, screen_h = root.winfo_screenwidth(), root.winfo_screenheight()
        window_w = min(1480, max(1080, int(screen_w * 0.96)))
        window_h = min(930, max(750, int(screen_h * 0.90)))
        root.geometry(f"{window_w}x{window_h}")
        root.minsize(min(1080, window_w), min(750, window_h))
        root.configure(bg=C["bg"])
        self.history: list[str] = []
        self.variables: dict[str, Any] = {}
        self.ans: Any = 0
        self.angle_mode = tk.StringVar(value="RAD")
        self._setup_style()
        self._background_queue = queue.Queue()
        self._queue_poll_after = None
        self._build_shell()
        self._schedule_background_queue_poll()

    def _load_theme_preference(self) -> str:
        """Load the last selected appearance; default safely to Dark."""
        try:
            with open(self.theme_settings_path, "r", encoding="utf-8") as handle:
                saved = json.load(handle)
            theme = str(saved.get("theme", "Dark")).title()
            return theme if theme in THEME_PALETTES else "Dark"
        except (OSError, ValueError, TypeError, AttributeError):
            return "Dark"

    def _save_theme_preference(self) -> None:
        """Persist the selected appearance beside the application source."""
        try:
            with open(self.theme_settings_path, "w", encoding="utf-8") as handle:
                json.dump({"theme": self.theme_name}, handle, indent=2)
        except OSError as exc:
            # A read-only installation can still switch themes for this session.
            if hasattr(self, "settings_status"):
                self.settings_status.set(f"Theme changed for this session; preference could not be saved: {exc}")

    def _change_theme(self, theme: str) -> None:
        """Switch the full application palette and rebuild the active workspace."""
        theme = str(theme).title()
        if theme not in THEME_PALETTES:
            return
        if theme == self.theme_name:
            if hasattr(self, "settings_status"):
                self.settings_status.set(f"{theme} mode is already active.")
            return

        self.theme_name = theme
        C.clear()
        C.update(THEME_PALETTES[theme])
        self._save_theme_preference()

        # Repaint the persistent shell first, then recreate the selected page so
        # every native Tk control picks up the new palette consistently.
        for widget_name, colour in (
            ("app_body", C["bg"]), ("sidebar", C["bg2"]),
            ("main_area", C.get("bg_secondary", C["bg"])),
            ("topbar", C.get("bg_secondary", C["bg"])),
            ("view_container", C["bg"]),
        ):
            widget = getattr(self, widget_name, None)
            if widget is not None:
                try:
                    widget.configure(bg=colour)
                except tk.TclError:
                    pass
        try:
            self.root.configure(bg=C["bg"])
            self.menu_button.configure(bg=C["bg"], fg=C["muted"],
                                       activebackground=C["panel3"], activeforeground=C["text"])
            self.page_title.configure(bg=C["bg"], fg=C["cyan2"])
            self.header_accent.configure(bg=C["bg"])
            self.header_accent.delete("all")
            _paint_gradient(self.header_accent, THEME_HEADER_GRADIENTS[self.theme_name])
        except (tk.TclError, AttributeError):
            pass

        self._setup_style()
        self._build_sidebar()
        active_page = getattr(self, "current_page", "Settings")
        self._show_page(active_page)

    def _schedule_background_queue_poll(self) -> None:
        try:
            self._queue_poll_after = self.root.after(80, self._drain_background_queue)
        except tk.TclError:
            self._queue_poll_after = None

    def _drain_background_queue(self) -> None:
        """Apply worker results on Tk's main thread; workers never call Tk directly."""
        try:
            while True:
                kind, payload = self._background_queue.get_nowait()
                if kind == "currency_result":
                    source, target, rate, date = payload
                    self._currency_rate_ready(source, target, rate, date)
                elif kind == "currency_error":
                    self._currency_error_safe(str(payload))
        except queue.Empty:
            pass
        except tk.TclError:
            return
        self._schedule_background_queue_poll()



    # ----- Separate standard and scientific calculators ---------------------








    def _scientific_memory_key(self, key: str) -> None:
        try:
            if key == "MC":
                self.sci_memory = 0.0
            elif key == "MR":
                recalled = fmt(self.sci_memory, 14)
                if getattr(self, "sci_result_shown", False):
                    self.sci_expr.set(recalled)
                else:
                    self.sci_expr.set(self.sci_expr.get() + recalled)
                self.sci_result_shown = False
                self.sci_fe_mode = False
                self.sci_readout.set(self.sci_expr.get() or "0")
            else:
                if getattr(self, "sci_error_shown", False):
                    raise ValueError("Clear the calculation error before using memory.")
                if getattr(self, "sci_result_shown", False):
                    current = float(self.sci_readout.get().replace(",", ""))
                else:
                    current = float(safe_eval(close_open_parentheses(self.sci_expr.get()), self._eval_context())) if self.sci_expr.get().strip() else float(self.ans)
                if key == "M+": self.sci_memory += current
                elif key == "M-": self.sci_memory -= current
            if getattr(self, "history_mode", None) is not None and self.history_mode.get() == "Memory" and hasattr(self, "sci_history_list"):
                self._history_mode_changed(self.sci_history_list.master.master, "sci_history_list", "Memory")
        except Exception as exc:
            self.sci_result.set(f"Memory: {exc}")

    def _scientific_toggle_format(self) -> None:
        """Toggle the displayed scientific answer between standard and E notation."""
        try:
            if self.sci_error_shown:
                return
            value = float(self.sci_readout.get().replace(",", ""))
            self.sci_fe_mode = not getattr(self, "sci_fe_mode", False)
            self.sci_readout.set(f"{value:.8E}" if self.sci_fe_mode else fmt(value, 14))
        except (ValueError, TypeError):
            self.sci_result.set("F-E is available after a numeric result.")



    # ----- Reverse Polish Notation (RPN) calculator -------------------------
    def _build_rpn_calculator(self) -> None:
        page = self.rpn_page
        page.grid_columnconfigure(0, weight=3)
        page.grid_columnconfigure(1, weight=2)
        page.grid_rowconfigure(0, weight=1)
        deck = card(page, "RPN SCIENTIFIC STACK", "POSTFIX NOTATION · NO PARENTHESES REQUIRED")
        side = card(page, "STACK MEMORY", "TOP OF STACK IS LAST")
        deck.grid(row=0, column=0, sticky="nsew", padx=(0, 8), pady=5)
        side.grid(row=0, column=1, sticky="nsew", padx=(8, 0), pady=5)
        body = tk.Frame(deck, bg=C["panel"])
        body.pack(fill="both", expand=True, padx=15, pady=(0, 14))
        self.rpn_entry = tk.StringVar(value="")
        entry = styled_entry(body, self.rpn_entry, width=28, font_size=22)
        entry.pack(fill="x", ipady=15, pady=(4, 8))
        entry.bind("<Return>", lambda _e=None: self.rpn_enter())
        entry.bind("<Escape>", lambda _e=None: self.rpn_clear_entry())
        self.rpn_status = tk.StringVar(value="Enter a number, then press ENTER. Example: 5 1 2 + 4 * +")
        tk.Label(body, textvariable=self.rpn_status, bg=C["bg2"], fg=C["cyan2"],
                 font=(MONO, 9), anchor="w", justify="left", padx=10, pady=9,
                 wraplength=680, relief="sunken", bd=2).pack(fill="x", pady=(0, 8))
        key_rows = [
            ["7", "8", "9", "÷", "ENTER"],
            ["4", "5", "6", "×", "−"],
            ["1", "2", "3", "+", "^"],
            ["0", ".", "±", "sqrt", "%"],
            ["sin", "cos", "tan", "ln", "log"],
            ["pi", "e", "DUP", "SWAP", "DROP"],
            ["CLEAR STACK", "BACKSPACE", "AC ENTRY", "UNDO", "DEG/RAD"],
        ]
        grid = tk.Frame(body, bg=C["panel2"], width=410, height=410, bd=1, relief="ridge",
                        highlightthickness=2, highlightbackground=C["edge"],
                        highlightcolor=C["cyan"])
        grid.pack(expand=True, padx=1, pady=1)
        grid.pack_propagate(False)
        for col in range(5):
            grid.grid_columnconfigure(col, weight=1, uniform="rpncols", minsize=80)
        for row, keys in enumerate(key_rows):
            grid.grid_rowconfigure(row, weight=1, uniform="rpnrows", minsize=57)
            for col, key in enumerate(keys):
                neon_button(grid, key, lambda k=key: self.rpn_key(k),
                            height=2, font_size=10 if len(key) < 7 else 8).grid(
                                row=row, column=col, sticky="nsew", padx=1, pady=1)
        stack_body = tk.Frame(side, bg=C["panel"])
        stack_body.pack(fill="both", expand=True, padx=13, pady=(0, 13))
        tk.Label(stack_body, text="STACK SNAPSHOT", bg=C["panel"], fg=C["cyan2"],
                 font=(FONT, 9, "bold")).pack(anchor="w", pady=(2, 6))
        self.rpn_stack_list = tk.Listbox(stack_body, bg=C["bg2"], fg=C["cyan2"],
                                         selectbackground=C["line"], selectforeground=C["text"],
                                         font=(MONO, 12), relief="sunken", bd=3,
                                         highlightthickness=1, highlightbackground=C["line2"])
        self.rpn_stack_list.pack(fill="both", expand=True, pady=(0, 8))
        self.rpn_stack: list[float] = []
        self.rpn_undo: list[list[float]] = []
        self._rpn_refresh()
        tk.Label(stack_body, text="Example:  5  1  2  +  4  *  +  3  −\nResult:  14",
                 bg=C["bg2"], fg=C["muted"], font=(MONO, 9), justify="left",
                 anchor="w", padx=10, pady=10, relief="sunken", bd=2).pack(fill="x")

    def _rpn_snapshot(self) -> None:
        self.rpn_undo.append(self.rpn_stack[:])
        if len(self.rpn_undo) > 50:
            self.rpn_undo.pop(0)

    def _rpn_refresh(self) -> None:
        if not hasattr(self, "rpn_stack_list"):
            return
        self.rpn_stack_list.delete(0, "end")
        for i, value in enumerate(reversed(self.rpn_stack)):
            tag = "  ← TOP" if i == 0 else ""
            self.rpn_stack_list.insert("end", f"{len(self.rpn_stack)-i:02d}   {fmt(value, 14)}{tag}")
        if not self.rpn_stack:
            self.rpn_stack_list.insert("end", "   [ EMPTY STACK ]")

    def _rpn_apply(self, token: str) -> None:
        binary = {"+": operator.add, "−": operator.sub, "-": operator.sub,
                  "×": operator.mul, "*": operator.mul, "÷": operator.truediv,
                  "/": operator.truediv, "^": operator.pow, "%": operator.mod}
        unary = {
            "sqrt": math.sqrt, "abs": abs, "ln": math.log,
            "log": math.log10, "floor": math.floor, "ceil": math.ceil,
            "factorial": math.factorial,
        }
        if token in binary:
            if len(self.rpn_stack) < 2:
                raise ValueError(f"{token} needs two stack values.")
            b, a = self.rpn_stack.pop(), self.rpn_stack.pop()
            if token in ("÷", "/") and b == 0:
                raise CalculatorDivisionError(a, operation="division")
            if token == "%" and b == 0:
                raise CalculatorDivisionError(a, operation="remainder")
            self.rpn_stack.append(binary[token](a, b))
        elif token in ("sin", "cos", "tan"):
            if not self.rpn_stack:
                raise ValueError(f"{token} needs one stack value.")
            x = self.rpn_stack.pop()
            if self.angle_mode.get() == "DEG":
                x = math.radians(x)
            self.rpn_stack.append(getattr(math, token)(x))
        elif token in unary:
            if not self.rpn_stack:
                raise ValueError(f"{token} needs one stack value.")
            x = self.rpn_stack.pop()
            if token == "factorial" and (not float(x).is_integer() or x < 0 or x > 1500):
                raise ValueError("Factorial requires an integer from 0 to 1500.")
            self.rpn_stack.append(unary[token](int(x) if token == "factorial" else x))
        elif token == "DUP":
            if not self.rpn_stack: raise ValueError("Stack is empty.")
            self.rpn_stack.append(self.rpn_stack[-1])
        elif token == "SWAP":
            if len(self.rpn_stack) < 2: raise ValueError("SWAP needs two stack values.")
            self.rpn_stack[-1], self.rpn_stack[-2] = self.rpn_stack[-2], self.rpn_stack[-1]
        elif token == "DROP":
            if not self.rpn_stack: raise ValueError("Stack is empty.")
            self.rpn_stack.pop()
        elif token == "pi": self.rpn_stack.append(math.pi)
        elif token == "e": self.rpn_stack.append(math.e)
        elif token == "±":
            if not self.rpn_stack: raise ValueError("Stack is empty.")
            self.rpn_stack[-1] = -self.rpn_stack[-1]
        elif token == "DEG/RAD":
            new_mode = "DEG" if self.angle_mode.get() == "RAD" else "RAD"
            self.angle_mode.set(new_mode)
        else:
            try:
                self.rpn_stack.append(float(token))
            except ValueError:
                raise ValueError(f"Unknown RPN token: {token}")
        if self.rpn_stack and isinstance(self.rpn_stack[-1], float) and not math.isfinite(self.rpn_stack[-1]):
            raise ValueError("Operation produced a non-finite result.")

    def rpn_enter(self) -> None:
        raw = self.rpn_entry.get().strip()
        if not raw:
            self.rpn_status.set("Type a number or a space-separated RPN expression.")
            return
        self._rpn_snapshot()
        try:
            for token in raw.replace(",", " ").split():
                self._rpn_apply(token)
            self.rpn_entry.set("")
            self._rpn_refresh()
            self.rpn_status.set(f"STACK DEPTH  {len(self.rpn_stack)}   ·   TOP  {fmt(self.rpn_stack[-1]) if self.rpn_stack else '—'}")
            if self.rpn_stack:
                self.ans = self.rpn_stack[-1]
                self._sync_variable_status()
        except Exception as exc:
            if self.rpn_undo:
                self.rpn_stack = self.rpn_undo.pop()
            self._rpn_refresh()
            if isinstance(exc, CalculatorDivisionError):
                self.rpn_status.set(f"{exc.display_text}  ·  {exc}")
            else:
                self.rpn_status.set(f"RPN ERROR  ·  {exc}")

    def rpn_key(self, key: str) -> None:
        if key == "ENTER":
            if self.rpn_entry.get().strip():
                self.rpn_enter()
            elif self.rpn_stack:
                self._rpn_snapshot(); self.rpn_stack.append(self.rpn_stack[-1]); self._rpn_refresh()
            return
        if key in ("CLEAR STACK", "UNDO"):
            if key == "UNDO" and self.rpn_undo:
                self.rpn_stack = self.rpn_undo.pop()
            elif key == "CLEAR STACK":
                self._rpn_snapshot(); self.rpn_stack.clear()
            self._rpn_refresh(); return
        if key == "AC ENTRY": self.rpn_entry.set(""); return
        if key == "BACKSPACE": self.rpn_entry.set(self.rpn_entry.get()[:-1]); return
        if key == "DEG/RAD": self._rpn_apply(key); self.rpn_status.set(f"Angle mode: {self.angle_mode.get()}"); return
        if key in ("+", "−", "×", "÷", "^", "%", "sqrt", "sin", "cos", "tan", "ln", "log", "DUP", "SWAP", "DROP", "pi", "e", "±"):
            if self.rpn_entry.get().strip():
                self.rpn_enter()
            self._rpn_snapshot()
            try:
                self._rpn_apply(key); self._rpn_refresh()
                self.rpn_status.set(f"Applied {key}  ·  stack depth {len(self.rpn_stack)}")
            except Exception as exc:
                if self.rpn_undo: self.rpn_stack = self.rpn_undo.pop()
                self._rpn_refresh()
                if isinstance(exc, CalculatorDivisionError):
                    self.rpn_status.set(f"{exc.display_text}  ·  {exc}")
                else:
                    self.rpn_status.set(f"RPN ERROR  ·  {exc}")
            return
        if key == "±":
            self.rpn_entry.set(self.rpn_entry.get()[1:] if self.rpn_entry.get().startswith("-") else "-" + self.rpn_entry.get())
        else:
            self.rpn_entry.set(self.rpn_entry.get() + key)

    def rpn_clear_entry(self) -> None:
        self.rpn_entry.set("")

    # ----- Expanded unit and currency converter -----------------------------




    def _fetch_currency_rate(self, amount: float, source: str, target: str) -> None:
        try:
            if source == target:
                data = {"date": datetime.now().date().isoformat(), "rate": 1.0}
            else:
                url = f"https://api.frankfurter.dev/v2/rate/{source.lower()}/{target.lower()}"
                request = urllib.request.Request(url, headers={"User-Agent": "QuantumCalc/1.0"})
                with urllib.request.urlopen(request, timeout=10) as response:
                    data = json.loads(response.read().decode("utf-8"))
            rate = float(data["rate"])
            rate_date = str(data.get("date", "Unknown date"))
            result = amount * rate
            self.root.after(0, lambda: self._currency_result(amount, source, target, rate, rate_date, result))
        except Exception as exc:
            self.root.after(0, lambda err=exc: self._currency_error(err))

    def _currency_result(self, amount: float, source: str, target: str,
                         rate: float, rate_date: str, result: float) -> None:
        self.converter_result.set(f"{fmt(amount, 12)} {source}\n\n1 {source} = {fmt(rate, 10)} {target}\n\n= {fmt(result, 12)} {target}")
        self.converter_rate_info.set(f"Rate date: {rate_date}\nSource: Frankfurter API · reference exchange rates. Internet connection required. Rates may not be transaction/bank rates.")

    def _currency_error(self, exc: Exception) -> None:
        self.converter_result.set(f"Currency rate unavailable\n\n{exc}\n\nCheck your internet connection or try again later.")
        self.converter_rate_info.set("No stale or invented exchange rate is used. Currency conversion requires a successful rate lookup.")


def _enable_windows_dpi_awareness() -> None:
    """Opt into native per-monitor DPI rendering before creating any Tk windows.

    This prevents Windows from bitmap-stretching the whole application when the
    display scale is 125%, 150%, 175%, etc. Tk widgets and text remain vector/native.
    """
    if os.name != "nt":
        return
    try:
        # Windows 10/11: Per-Monitor DPI Awareness V2.
        ctypes.windll.user32.SetProcessDpiAwarenessContext(ctypes.c_void_p(-4))
        return
    except Exception:
        pass
    try:
        # Windows 8.1 fallback: per-monitor awareness.
        ctypes.windll.shcore.SetProcessDpiAwareness(2)
        return
    except Exception:
        pass
    try:
        # Older Windows fallback: system DPI awareness (still avoids bitmap blur).
        ctypes.windll.user32.SetProcessDPIAware()
    except Exception:
        pass



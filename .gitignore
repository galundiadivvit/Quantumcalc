    def _parse_lab_series(self, raw: str, label: str = "Dataset") -> list[float]:
        """Parse comma-, semicolon-, or whitespace-separated finite numbers."""
        tokens = [item for item in re.split(r"[,;\s]+", raw.strip()) if item]
        if not tokens:
            raise ValueError(f"Enter at least one value for {label}.")
        try:
            values = [float(item) for item in tokens]
        except ValueError as exc:
            raise ValueError(f"{label} contains a value that is not a valid number.") from exc
        if any(not math.isfinite(value) for value in values):
            raise ValueError(f"{label} must contain only finite numbers.")
        if len(values) > 10000:
            raise ValueError("A dataset is limited to 10,000 values.")
        return values


    def run_matrix(self) -> None:
        try:
            a = parse_matrix(self.matrix_a.get("1.0", "end"))
            op_name = self.matrix_op.get()
            if op_name == "Transpose A":
                out: Any = [list(row) for row in zip(*a)]
            elif op_name == "Determinant A":
                out = matrix_det(a)
            elif op_name == "Inverse A":
                out = matrix_inverse(a)
            elif op_name == "Trace A":
                if any(len(row) != len(a) for row in a):
                    raise ValueError("Trace requires a square matrix.")
                out = sum(a[i][i] for i in range(len(a)))
            elif op_name == "Rank A":
                out = matrix_rank(a)
            elif op_name == "Frobenius norm A":
                out = math.sqrt(sum(value * value for row in a for value in row))
            elif op_name == "Scalar × A":
                scalar = float(self.matrix_scalar.get())
                if not math.isfinite(scalar):
                    raise ValueError("Scalar must be a finite number.")
                out = [[scalar * value for value in row] for row in a]
            elif op_name == "Solve A·x = b":
                if any(len(row) != len(a) for row in a):
                    raise ValueError("A must be square to solve A·x = b.")
                b_matrix = parse_matrix(self.matrix_b.get("1.0", "end"))
                if any(len(row) != 1 for row in b_matrix):
                    raise ValueError("Enter b as a column vector, for example 5;7.")
                out = [[value] for value in matrix_solve(a, [row[0] for row in b_matrix])]
            else:
                b = parse_matrix(self.matrix_b.get("1.0", "end"))
                if op_name in ("A + B", "A − B", "Hadamard A ⊙ B"):
                    if len(a) != len(b) or len(a[0]) != len(b[0]):
                        raise ValueError("This operation requires matrices of the same dimensions.")
                    if op_name == "Hadamard A ⊙ B":
                        out = [[a[i][j] * b[i][j] for j in range(len(a[0]))] for i in range(len(a))]
                    else:
                        sign = 1 if op_name == "A + B" else -1
                        out = [[a[i][j] + sign*b[i][j] for j in range(len(a[0]))] for i in range(len(a))]
                else:
                    if len(a[0]) != len(b):
                        raise ValueError("A × B requires columns in A to equal rows in B.")
                    out = [[sum(a[i][k]*b[k][j] for k in range(len(b)))
                            for j in range(len(b[0]))] for i in range(len(a))]
            if isinstance(out, list):
                text = "\n".join("[ " + "   ".join(fmt(x, 7) for x in row) + " ]" for row in out)
            else:
                text = fmt(out, 12)
            self._set_matrix_result(text)
        except Exception as exc:
            self._set_matrix_result(f"MATRIX ERROR\n\n{exc}")

    def _set_matrix_result(self, text: str) -> None:
        self.matrix_result.set(text)
        if hasattr(self, "matrix_result_text"):
            self.matrix_result_text.configure(state="normal")
            self.matrix_result_text.delete("1.0", "end")
            self.matrix_result_text.insert("1.0", text)
            self.matrix_result_text.configure(state="disabled")

    def copy_matrix_result(self) -> None:
        try:
            self.root.clipboard_clear()
            self.root.clipboard_append(self.matrix_result.get())
            self._console_write("Matrix result copied to clipboard.")
        except tk.TclError:
            pass

    def _load_matrix_example(self) -> None:
        self.matrix_a.delete("1.0", "end")
        self.matrix_a.insert("1.0", "2,1;1,3")
        self.matrix_b.delete("1.0", "end")
        self.matrix_b.insert("1.0", "5;6")
        self.matrix_scalar.set("2")
        self.matrix_op.set("Solve A·x = b")
        self.run_matrix()

    # ----- Dashboard ---------------------------------------------------------
    def _build_dashboard(self) -> None:
        """Three-column QuantumCalc cockpit matching the supplied reference."""
        page = self.dashboard
        page.grid_columnconfigure(0, weight=40, uniform="cockpit")
        page.grid_columnconfigure(1, weight=38, uniform="cockpit")
        page.grid_columnconfigure(2, weight=27, uniform="cockpit")
        page.grid_rowconfigure(0, weight=1)

        left = tk.Frame(page, bg=C["bg"])
        center = tk.Frame(page, bg=C["bg"])
        right = tk.Frame(page, bg=C["bg"])
        left.grid(row=0, column=0, sticky="nsew", padx=(0, 7), pady=4)
        center.grid(row=0, column=1, sticky="nsew", padx=7, pady=4)
        right.grid(row=0, column=2, sticky="nsew", padx=(7, 0), pady=4)

        # LEFT: interactive 3D preview, matching the reference's dominant panel.
        visual = card(left, "3D VISUALIZATION", "LIVE SURFACE  ·  DRAG TO ORBIT")
        visual.pack(fill="both", expand=True, pady=(0, 8))
        self.preview_canvas = tk.Canvas(
            visual, bg=C["panel2"], height=390, highlightthickness=1,
            highlightbackground=C["line"], cursor="fleur"
        )
        self.preview_canvas.pack(fill="both", expand=True, padx=12, pady=(0, 7))
        self.preview_formula = tk.StringVar(value="z = sin(1.7x) · cos(1.7y)")
        tk.Label(visual, textvariable=self.preview_formula, bg=C["panel"],
                 fg=C["cyan2"], font=("Cambria Math", 14, "italic"),
                 anchor="w").pack(fill="x", padx=13, pady=(0, 3))
        preview_controls = tk.Frame(visual, bg=C["panel"])
        preview_controls.pack(fill="x", padx=10, pady=(2, 10))
        self.preview_rot_x, self.preview_rot_y, self.preview_zoom = 0.88, -0.68, 1.0
        self.preview_drag = None

        def draw_preview(_event=None):
            c = self.preview_canvas
            if not c.winfo_exists():
                return
            w, h = max(c.winfo_width(), 280), max(c.winfo_height(), 260)
            c.delete("all")
            cx, cy = w * .50, h * .51
            scale = min(w, h) * .105 * self.preview_zoom
            rx, ry = self.preview_rot_x, self.preview_rot_y
            crx, srx, cry, sry = math.cos(rx), math.sin(rx), math.cos(ry), math.sin(ry)
            def project(x, y, z):
                x1 = x * cry - y * sry
                y1 = x * sry + y * cry
                y2 = y1 * crx - z * srx
                z2 = y1 * srx + z * crx
                perspective = 1 / (1 + (z2 + .5) * .012)
                return cx + x1 * scale * perspective, cy - z2 * scale * perspective
            # Perspective floor grid.
            for k in range(-4, 5):
                a, b = project(k, -4, -1.25), project(k, 4, -1.25)
                d, e = project(-4, k, -1.25), project(4, k, -1.25)
                c.create_line(*a, *b, fill=C["line"], width=1)
                c.create_line(*d, *e, fill=C["line"], width=1)
            # Holographic wireframe surface.
            n = 22
            coords = [-3.5 + 7*i/(n-1) for i in range(n)]
            mesh = [[project(x, y, math.sin(1.7*x)*math.cos(1.7*y)) for y in coords] for x in coords]
            for i in range(n):
                c.create_line(*(v for point in mesh[i] for v in point),
                              fill=C["blue"], width=1)
                row = [mesh[j][i] for j in range(n)]
                c.create_line(*(v for point in row for v in point),
                              fill=C["cyan2"], width=1)
            origin = project(-4, -4, -1.25)
            for end, label, color in ((project(4.5,-4,-1.25), "X", C["cyan"]),
                                      (project(-4,4.5,-1.25), "Y", C["mint"]),
                                      (project(-4,-4,2), "Z", C["cyan2"])):
                c.create_line(*origin, *end, fill=color, width=2, arrow="last")
                c.create_text(end[0]+8, end[1], text=label, fill=color,
                              font=(FONT, 9, "bold"))
            c.create_text(12, 12, text="HOLOGRAPHIC SURFACE  /  z = sin(1.7x) cos(1.7y)",
                          anchor="nw", fill=C["cyan2"], font=(FONT, 8, "bold"))

        def preview_down(event):
            self.preview_drag = (event.x, event.y)
        def preview_move(event):
            if self.preview_drag:
                ox, oy = self.preview_drag
                self.preview_rot_y += (event.x-ox)*.009
                self.preview_rot_x += (event.y-oy)*.009
                self.preview_drag = (event.x, event.y)
                draw_preview()
        def preview_up(_event):
            self.preview_drag = None
        def preview_zoom(event):
            self.preview_zoom = min(1.7, max(.55, self.preview_zoom * (1.08 if event.delta > 0 else .92)))
            draw_preview()
        self.preview_canvas.bind("<Configure>", draw_preview)
        self.preview_canvas.bind("<ButtonPress-1>", preview_down)
        self.preview_canvas.bind("<B1-Motion>", preview_move)
        self.preview_canvas.bind("<ButtonRelease-1>", preview_up)
        self.preview_canvas.bind("<MouseWheel>", preview_zoom)
        neon_button(preview_controls, "−", lambda: (setattr(self, "preview_zoom", max(.55, self.preview_zoom*.9)), draw_preview()), width=4, height=1, font_size=9).pack(side="left", padx=2)
        neon_button(preview_controls, "+", lambda: (setattr(self, "preview_zoom", min(1.7, self.preview_zoom*1.1)), draw_preview()), width=4, height=1, font_size=9).pack(side="left", padx=2)
        neon_button(preview_controls, "RESET VIEW", lambda: (setattr(self, "preview_rot_x", .88), setattr(self, "preview_rot_y", -.68), setattr(self, "preview_zoom", 1.0), draw_preview()), width=11, height=1, font_size=8).pack(side="right", padx=2)
        neon_button(preview_controls, "OPEN 3D LAB", lambda: self.notebook.select(self.graph_page), width=12, height=1, font_size=8).pack(side="right", padx=2)
        self.root.after(280, draw_preview)

        # CENTER: calculus panel and tactile, four-column scientific keypad.
        calc = card(center, "CALCULUS & ALGEBRA", "SYMBOLIC + NUMERIC")
        calc.pack(fill="x", pady=(0, 9))
        body = tk.Frame(calc, bg=C["panel"])
        body.pack(fill="both", expand=True, padx=12, pady=(0, 11))
        formula_deck = tk.Frame(body, bg=C["panel2"], relief="sunken", bd=2,
                                highlightthickness=1, highlightbackground=C["line"])
        formula_deck.grid(row=0, column=0, columnspan=4, sticky="ew", pady=(0, 8))
        for formula in (
            "∫ x² sin(x) dx  =  −x² cos(x) + ∫ 2x cos(x) dx",
            "∇ · E  =  ρ / ε₀",
            "d/dx (e³ˣ + ln x)  =  3e³ˣ + 1/x",
        ):
            tk.Label(formula_deck, text=formula, bg=C["panel2"], fg=C["cyan2"],
                     font=("Cambria Math", 10), anchor="center").pack(fill="x", padx=7, pady=3)
        tk.Label(body, text="FUNCTION  f(x)", bg=C["panel"], fg=C["cyan2"],
                 font=(FONT, 8, "bold")).grid(row=1, column=0, sticky="w")
        self.calculus_expr = tk.StringVar(value="x**3 * sin(x)")
        styled_entry(body, self.calculus_expr, width=30, font_size=10).grid(
            row=2, column=0, columnspan=4, sticky="ew", pady=(3, 7), ipady=7)
        tk.Label(body, text="OPERATION", bg=C["panel"], fg=C["cyan2"],
                 font=(FONT, 8, "bold")).grid(row=3, column=0, sticky="w")
        self.calculus_op = tk.StringVar(value="Differentiate")
        ttk.Combobox(body, textvariable=self.calculus_op, state="readonly",
                     values=["Differentiate", "Integrate (definite)", "Evaluate at x", "Expand", "Factor"],
                     width=15).grid(row=4, column=0, sticky="ew", pady=4)
        self.calc_order = tk.StringVar(value="1")
        tk.Label(body, text="DERIVATIVE ORDER", bg=C["panel"], fg=C["muted"],
                 font=(FONT, 7, "bold")).grid(row=3, column=1, sticky="w", padx=5)
        tk.Spinbox(body, from_=1, to=5, textvariable=self.calc_order, width=4,
                   bg=C["bg2"], fg=C["cyan2"], buttonbackground=C["panel3"],
                   insertbackground=C["cyan"], relief="sunken", bd=2,
                   highlightthickness=1, highlightbackground=C["line2"],
                   font=(MONO, 9)).grid(row=4, column=1, sticky="ew", padx=4, pady=4, ipady=5)
        self.calc_x1 = tk.StringVar(value="2")
        self.calc_x2 = tk.StringVar(value="5")
        tk.Label(body, text="X / LOWER", bg=C["panel"], fg=C["muted"], font=(FONT, 7, "bold")).grid(row=3, column=2, sticky="w", padx=5)
        styled_entry(body, self.calc_x1, width=7, font_size=9).grid(row=4, column=2, sticky="ew", padx=4, ipady=6)
        tk.Label(body, text="UPPER", bg=C["panel"], fg=C["muted"], font=(FONT, 7, "bold")).grid(row=3, column=3, sticky="w")
        styled_entry(body, self.calc_x2, width=7, font_size=9).grid(row=4, column=3, sticky="ew", padx=3, ipady=6)
        neon_button(body, "EVALUATE  ↗", self.run_calculus, width=14, height=1, font_size=8).grid(row=5, column=0, columnspan=4, sticky="ew", pady=(6, 5))
        self.calculus_result = tk.StringVar(value="∂ / ∫   Your result will appear here")
        tk.Label(body, textvariable=self.calculus_result, bg=C["bg2"], fg=C["cyan2"],
                 font=(MONO, 9), anchor="w", justify="left", padx=9, pady=8,
                 wraplength=430, relief="sunken", bd=2).grid(row=6, column=0, columnspan=4, sticky="ew", pady=(3, 0))
        for col in range(4):
            body.grid_columnconfigure(col, weight=1)

        keypad = card(center, "SCIENTIFIC KEYPAD", "MIDNIGHT AMETHYST CONTROL DECK")
        keypad.configure(highlightthickness=2, highlightbackground=C["line2"],
                         highlightcolor=C["cyan2"], bd=2)
        keypad.pack(fill="both", expand=True)
        # Nested graphite rim creates a stronger teal halo around the complete keypad deck.
        keypad.configure(bg=C["bg2"])
        controls = tk.Frame(keypad, bg=C["panel"])
        controls.pack(fill="x", padx=10, pady=(0, 3))
        self.display_var = tk.StringVar(value="")
        display = styled_entry(controls, self.display_var, width=26, font_size=14)
        display.pack(fill="x", ipady=5)
        display.bind("<Return>", lambda _e=None: self.calculate())
        display.bind("<Escape>", lambda _e=None: self.clear_display())
        mode_row = tk.Frame(keypad, bg=C["panel"])
        mode_row.pack(fill="x", padx=11, pady=(0, 2))
        tk.Label(mode_row, text="ANGLE", bg=C["panel"], fg=C["cyan2"], font=(FONT, 7, "bold")).pack(side="left")
        ttk.Combobox(mode_row, textvariable=self.angle_mode, state="readonly", values=["RAD", "DEG"], width=5).pack(side="left", padx=6)
        tk.Label(mode_row, text="ANS = PREVIOUS RESULT  ·  ^ = POWER", bg=C["panel"], fg=C["muted"], font=(FONT, 7, "bold")).pack(side="right")
        # Reference-style keypad: three compact banks, each key a separate
        # luminous rounded keycap rather than a stretched generic button.
        banks = tk.Frame(keypad, bg=C["panel2"], bd=1, relief="ridge",
                         highlightthickness=1, highlightbackground=C["line2"],
                         highlightcolor=C["cyan"])
        banks.pack(fill="both", expand=True, padx=8, pady=(0, 8))
        banks.grid_columnconfigure(0, weight=2, uniform="keybanks")
        banks.grid_columnconfigure(1, weight=2, uniform="keybanks")
        banks.grid_columnconfigure(2, weight=4, uniform="keybanks")

        def make_key_bank(parent, title, keys, columns, bank_name, bank_col):
            bank = tk.Frame(parent, bg=C["panel"])
            bank.grid(row=0, column=bank_col, sticky="nsew", padx=2, pady=1)
            tk.Label(bank, text=title, bg=C["panel"], fg=C["mint"],
                     font=(FONT, 10, "bold")).pack(fill="x", pady=(0, 3))
            deck = tk.Frame(bank, bg=C["panel"])
            deck.pack(fill="both", expand=True)
            for col in range(columns):
                deck.grid_columnconfigure(col, weight=1, uniform=f"{bank_name}cols")
            rows = (len(keys) + columns - 1) // columns
            for r in range(rows):
                deck.grid_rowconfigure(r, weight=1, uniform=f"{bank_name}rows")
            for index, key in enumerate(keys):
                r, col = divmod(index, columns)
                neon_button(deck, key, lambda k=key: self.key_press(k),
                            height=1, font_size=8 if len(key) > 3 else 9).grid(
                                row=r, column=col, sticky="nsew", padx=1, pady=1)

        make_key_bank(banks, "Trig", ["sin", "cos", "tan", "sec", "cot", "csc", "asin", "acos", "atan", "sinh"], 2, "dashtrig", 0)
        make_key_bank(banks, "Math", ["π", "e", "√", "^", "ln", "log", "∫", "Σ", "x!", "1/x"], 2, "dashmath", 1)
        make_key_bank(banks, "Num", ["7", "8", "9", "/", "4", "5", "6", "÷",
                                      "1", "2", "3", "×", "0", ".", "±", "−",
                                      "=", "DEL", "AC", "+"], 4, "dashnum", 2)

        # RIGHT: analytics, then compact live variables/result terminal.
        stats = card(right, "STATISTICAL ANALYTICS", "LIVE DATA")
        stats.pack(fill="both", expand=True, pady=(0, 9))
        sbody = tk.Frame(stats, bg=C["panel"])
        sbody.pack(fill="both", expand=True, padx=10, pady=(0, 9))
        tk.Label(sbody, text="DATA SET · COMMA SEPARATED", bg=C["panel"], fg=C["cyan2"],
                 font=(FONT, 7, "bold")).pack(anchor="w")
        self.stats_input = tk.StringVar(value="12, 15, 18, 18, 21, 24, 24, 24, 30")
        styled_entry(sbody, self.stats_input, width=22, font_size=9).pack(fill="x", pady=5, ipady=7)
        neon_button(sbody, "ANALYZE DATA", self.update_stats, width=14, height=1, font_size=8).pack(anchor="e", pady=(0, 5))
        self.stats_summary = tk.StringVar(value="Mean —   Median —   Std Dev —")
        tk.Label(sbody, textvariable=self.stats_summary, bg=C["bg2"], fg=C["cyan2"],
                 font=(MONO, 8), justify="left", anchor="w", wraplength=290,
                 padx=8, pady=7, relief="sunken", bd=2).pack(fill="x", pady=(0, 5))
        self.stats_canvas = tk.Canvas(sbody, bg=C["bg2"], highlightthickness=1,
                                      highlightbackground=C["line2"], height=175)
        self.stats_canvas.pack(fill="both", expand=True)
        self.stats_canvas.bind("<Configure>", lambda _e=None: self.update_stats())

        console = card(right, "VARIABLES & RESULTS", "SESSION CONSOLE")
        console.pack(fill="both", expand=True)
        status = tk.Frame(console, bg=C["panel2"], relief="sunken", bd=2,
                          highlightthickness=1, highlightbackground=C["line"])
        status.pack(fill="x", padx=9, pady=(0, 6))
        self.var_r = tk.StringVar(value="R: —")
        self.var_t = tk.StringVar(value="T: RAD")
        self.var_ans = tk.StringVar(value="Ans: 0")
        for variable in (self.var_r, self.var_t, self.var_ans):
            tk.Label(status, textvariable=variable, bg=C["panel2"], fg=C["cyan2"],
                     font=(MONO, 8, "bold"), padx=4, pady=6).pack(side="left", expand=True)
        self.console = tk.Text(console, height=5, bg=C["bg2"], fg=C["cyan2"],
                               insertbackground=C["cyan"], relief="sunken", bd=2,
                               highlightthickness=1, highlightbackground=C["line2"],
                               font=(MONO, 8), wrap="word", padx=8, pady=7,
                               state="disabled")
        self.console.pack(fill="both", expand=True, padx=9, pady=(0, 6))
        cmdrow = tk.Frame(console, bg=C["panel"])
        cmdrow.pack(fill="x", padx=9, pady=(0, 9))
        self.console_input = tk.StringVar()
        ce = styled_entry(cmdrow, self.console_input, width=15, font_size=9)
        ce.pack(side="left", fill="x", expand=True, ipady=6)
        ce.bind("<Return>", lambda _e=None: self.run_console())
        neon_button(cmdrow, "RUN", self.run_console, width=5, height=1, font_size=8).pack(side="left", padx=(5, 0))
        self._console_write("QUANTUM CORE ONLINE\nScientific workspace ready.")
        self.update_stats()

    def _build_graph_workspace(self) -> None:
        """Responsive interactive graph workbench with 2D multi-curve and 3D modes."""
        page = self.graph_page
        page.grid_columnconfigure(0, weight=70, minsize=480)
        page.grid_columnconfigure(1, weight=30, minsize=290)
        page.grid_rowconfigure(0, weight=1)

        self.surface_expr = tk.StringVar(value="sin(x) * cos(y)")
        self.surface_xmin = tk.StringVar(value="-6.28")
        self.surface_xmax = tk.StringVar(value="6.28")
        self.surface_ymin = tk.StringVar(value="-4")
        self.surface_ymax = tk.StringVar(value="4")
        self.surface_density = tk.StringVar(value="31")
        self.surface_preset = tk.StringVar(value="Sine × cosine")
        self.surface_kind = tk.StringVar(value="z = f(x, y)")
        self.slice_z = tk.StringVar(value="0")
        self.graph_mode = tk.StringVar(value="2D Multi-function")
        self.graph_ymin = tk.StringVar(value="")
        self.graph_ymax = tk.StringVar(value="")
        self.graph_function_rows: list[dict[str, Any]] = []
        self.graph_series_colors = [C["blue"], C["mint"], C["cyan2"], C["fusion"], C["sapphire_dark"], C["mint_light"]]
        self._graph_redraw_after = None

        plot = card(page, "GRAPH STUDIO", "INTERACTIVE 2D / 3D  ·  ZOOM  ·  PAN  ·  EXPORT")
        controls = tk.Frame(page, bg=C["bg"])
        plot.grid(row=0, column=0, sticky="nsew", padx=(0, 8), pady=5)
        controls.grid(row=0, column=1, sticky="nsew", padx=(8, 0), pady=5)

        toolbar = tk.Frame(plot, bg=C["panel"])
        toolbar.pack(fill="x", padx=13, pady=(0, 8))
        tk.Label(toolbar, text="VIEW", bg=C["panel"], fg=C["muted"],
                 font=(FONT, 8, "bold")).pack(side="left", padx=(0, 6))
        mode_box = ttk.Combobox(toolbar, textvariable=self.graph_mode, state="readonly",
                                values=["2D Multi-function", "3D Surface"], width=19)
        mode_box.pack(side="left", padx=(0, 10))
        mode_box.bind("<<ComboboxSelected>>", lambda _e=None: self._graph_mode_changed())
        self.graph_geometry_box = ttk.Combobox(
            toolbar, textvariable=self.surface_kind, state="readonly", width=20,
            values=["z = f(x, y)", "Sphere", "Sphere + cross-section", "Cylinder", "Torus", "Parametric surface"]
        )
        self.graph_geometry_box.pack(side="left", padx=(0, 7))
        self.graph_geometry_box.bind("<<ComboboxSelected>>", lambda _e=None: self._graph_kind_changed())
        self.graph_surface_expr = styled_entry(toolbar, self.surface_expr, width=24, font_size=10)
        self.graph_surface_expr.pack(side="left", fill="x", expand=True, ipady=6, padx=(0, 7))
        self.graph_surface_expr.bind("<Return>", lambda _e=None: self.draw_surface())
        neon_button(toolbar, "PLOT", self.draw_surface, width=7, height=1, font_size=9).pack(side="left", padx=(0, 5))
        neon_button(toolbar, "EXPORT", self._export_graph_image, width=9, height=1, font_size=9).pack(side="left")

        self.surface_canvas = tk.Canvas(
            plot, bg=C["panel2"], highlightthickness=1,
            highlightbackground=C["line"], height=470, cursor="crosshair"
        )
        self.surface_canvas.pack(fill="both", expand=True, padx=12, pady=(0, 7))
        self.surface_canvas.bind("<Configure>", self._schedule_graph_redraw)
        self.surface_canvas.bind("<ButtonPress-1>", self._surface_start_drag)
        self.surface_canvas.bind("<B1-Motion>", self._surface_drag)
        self.surface_canvas.bind("<ButtonRelease-1>", lambda _e=None: setattr(self, "_drag_origin", None))
        self.surface_canvas.bind("<ButtonPress-3>", self._surface_start_pan)
        self.surface_canvas.bind("<B3-Motion>", self._surface_pan)
        self.surface_canvas.bind("<ButtonRelease-3>", lambda _e=None: setattr(self, "_pan_origin", None))
        self.surface_canvas.bind("<MouseWheel>", self._surface_zoom)
        self.surface_canvas.bind("<Button-4>", lambda _e=None: self._surface_zoom_step(1.08))
        self.surface_canvas.bind("<Button-5>", lambda _e=None: self._surface_zoom_step(0.92))

        footer = tk.Frame(plot, bg=C["panel"])
        footer.pack(fill="x", padx=13, pady=(0, 10))
        self.graph_status = tk.StringVar(value="Ready · left-drag to pan / orbit · mouse wheel to zoom")
        tk.Label(footer, textvariable=self.graph_status, bg=C["panel"], fg=C["muted"],
                 font=(FONT, 8), anchor="w").pack(side="left", fill="x", expand=True)
        neon_button(footer, "RESET VIEW", self._reset_surface, width=11, height=1, font_size=8).pack(side="right", padx=3)
        neon_button(footer, "−", lambda: self._surface_zoom_step(.9), width=4, height=1, font_size=9).pack(side="right", padx=2)
        neon_button(footer, "+", lambda: self._surface_zoom_step(1.1), width=4, height=1, font_size=9).pack(side="right", padx=2)

        settings = card(controls, "GRAPH CONTROLS", "DOMAIN · CURVES · QUALITY")
        settings.pack(fill="both", expand=True, pady=5)
        control_shell = tk.Frame(settings, bg=C["panel"])
        control_shell.pack(fill="both", expand=True, padx=(10, 4), pady=(0, 10))
        control_canvas = tk.Canvas(control_shell, bg=C["panel"], highlightthickness=0, bd=0)
        control_scroll = ttk.Scrollbar(control_shell, orient="vertical", command=control_canvas.yview)
        control_canvas.configure(yscrollcommand=control_scroll.set)
        control_scroll.pack(side="right", fill="y")
        control_canvas.pack(side="left", fill="both", expand=True)
        cb = tk.Frame(control_canvas, bg=C["panel"])
        cb_window = control_canvas.create_window((0, 0), window=cb, anchor="nw")
        cb.bind("<Configure>", lambda _e=None: control_canvas.configure(scrollregion=control_canvas.bbox("all")))
        control_canvas.bind("<Configure>", lambda e: control_canvas.itemconfigure(cb_window, width=e.width))
        control_canvas.bind("<MouseWheel>", lambda e: control_canvas.yview_scroll(int(-e.delta / 120), "units"))

        self.graph_function_panel = tk.Frame(cb, bg=C["panel"])
        self.graph_function_panel.pack(fill="x", pady=(0, 8))
        function_header = tk.Frame(self.graph_function_panel, bg=C["panel"])
        function_header.pack(fill="x", pady=(2, 6))
        tk.Label(function_header, text="2D FUNCTIONS", bg=C["panel"], fg=C["cyan2"],
                 font=(FONT, 9, "bold")).pack(side="left")
        neon_button(function_header, "+ CURVE", self._add_graph_function_row,
                    width=9, height=1, font_size=8).pack(side="right")
        self.graph_function_rows_frame = tk.Frame(self.graph_function_panel, bg=C["panel2"],
                                                  highlightthickness=1, highlightbackground=C["line"])
        self.graph_function_rows_frame.pack(fill="x", pady=(0, 4))
        for initial in ("sin(x)", "cos(x)", "0.25*x"):
            self._add_graph_function_row(initial)
        tk.Label(self.graph_function_panel, text="Toggle curves on/off. Up to six functions can be plotted together.",
                 bg=C["panel"], fg=C["muted"], font=(FONT, 8), wraplength=245,
                 justify="left").pack(anchor="w", pady=(3, 0))

        self.graph_surface_panel = tk.Frame(cb, bg=C["panel"])
        self.graph_surface_panel.pack(fill="x", pady=(0, 8))
        tk.Label(self.graph_surface_panel, text="3D SURFACE PRESET", bg=C["panel"], fg=C["cyan2"],
                 font=(FONT, 8, "bold")).pack(anchor="w", pady=(2, 5))
        presets = {
            "Sine × cosine": "sin(x) * cos(y)",
            "Ripple dome": "sin(sqrt(x**2 + y**2))",
            "Paraboloid": "(x**2 + y**2) / 8",
            "Saddle": "(x**2 - y**2) / 8",
            "Radial ripple": "cos(sqrt(x**2 + y**2))",
            "Wave field": "sin(x) + cos(y)",
            "Saddle waves": "sin(x*y) / (1 + 0.15*(x**2+y**2))",
        }
        preset_box = ttk.Combobox(self.graph_surface_panel, textvariable=self.surface_preset,
                                  values=list(presets.keys()), state="readonly")
        preset_box.pack(fill="x", pady=(0, 6))
        preset_box.bind("<<ComboboxSelected>>", lambda _e=None: self._graph_preset_selected(presets))
        self.graph_slice_row = tk.Frame(self.graph_surface_panel, bg=C["panel"])
        tk.Label(self.graph_slice_row, text="Sphere cross-section z", bg=C["panel"], fg=C["muted"],
                 font=(FONT, 8)).pack(side="left")
        styled_entry(self.graph_slice_row, self.slice_z, width=8, font_size=9).pack(side="right", ipady=4)

        domain = card(cb, "DOMAIN & RANGE", "X / Y")
        self.graph_domain_panel = domain
        domain.pack(fill="x", pady=(4, 8))
        db = tk.Frame(domain, bg=C["panel"])
        db.pack(fill="x", padx=9, pady=(0, 8))
        fields = [
            ("X MIN", self.surface_xmin), ("X MAX", self.surface_xmax),
            ("Y MIN", self.surface_ymin), ("Y MAX", self.surface_ymax),
        ]
        for i, (label, var) in enumerate(fields):
            wrap = tk.Frame(db, bg=C["panel"])
            wrap.grid(row=i//2, column=i%2, sticky="ew", padx=3, pady=3)
            tk.Label(wrap, text=label, bg=C["panel"], fg=C["muted"],
                     font=(FONT, 7, "bold")).pack(anchor="w")
            styled_entry(wrap, var, width=9, font_size=9).pack(fill="x", ipady=5)
        for col in range(2):
            db.grid_columnconfigure(col, weight=1)

        yrange = tk.Frame(cb, bg=C["panel"])
        self.graph_2d_y_range_panel = yrange
        yrange.pack(fill="x", pady=(0, 7))
        tk.Label(yrange, text="2D Y MIN / MAX (blank = auto)", bg=C["panel"], fg=C["muted"],
                 font=(FONT, 8, "bold")).pack(anchor="w", pady=(2, 4))
        yrow = tk.Frame(yrange, bg=C["panel"])
        yrow.pack(fill="x")
        styled_entry(yrow, self.graph_ymin, width=10, font_size=9).pack(side="left", fill="x", expand=True, ipady=5, padx=(0, 4))
        styled_entry(yrow, self.graph_ymax, width=10, font_size=9).pack(side="left", fill="x", expand=True, ipady=5, padx=(4, 0))

        self.graph_3d_quality_panel = tk.Frame(cb, bg=C["panel"])
        self.graph_3d_quality_panel.pack(fill="x", pady=(4, 0))
        tk.Label(self.graph_3d_quality_panel, text="3D MESH QUALITY", bg=C["panel"], fg=C["muted"],
                 font=(FONT, 8, "bold")).pack(anchor="w", pady=(4, 4))
        tk.Spinbox(self.graph_3d_quality_panel, from_=12, to=61, textvariable=self.surface_density,
                   bg=C["panel2"], fg=C["text"], insertbackground=C["cyan2"],
                   buttonbackground=C["panel3"], relief="flat", bd=1,
                   highlightthickness=1, highlightbackground=C["line"],
                   font=(MONO, 10), width=8).pack(anchor="w", ipady=5)
        self.graph_camera = tk.StringVar(value="3D orbit  ·  drag to rotate")
        tk.Label(self.graph_3d_quality_panel, textvariable=self.graph_camera, bg=C["panel2"], fg=C["cyan2"],
                 font=(MONO, 8), justify="left", anchor="w", padx=9, pady=8,
                 highlightthickness=1, highlightbackground=C["line"]).pack(fill="x", pady=(8, 0))
        tk.Label(cb, text="2D: drag to pan · wheel to zoom\n3D: drag to orbit · right-drag to pan",
                 bg=C["panel"], fg=C["muted"], font=(FONT, 8), justify="left",
                 anchor="w").pack(fill="x", pady=(7, 0))

        self.rot_x, self.rot_y, self.surface_zoom = 0.92, -0.72, 1.0
        self.pan_x, self.pan_y = 0.0, 0.0
        self._drag_origin = None
        self._pan_origin = None
        self._graph_mode_changed()
        self.root.after(180, self.draw_surface)

    def _add_graph_function_row(self, expression: str = "") -> None:
        if not hasattr(self, "graph_function_rows_frame"):
            return
        if len(self.graph_function_rows) >= 6:
            self.graph_status.set("You can plot up to six functions at once.")
            return
        index = len(self.graph_function_rows)
        variable = tk.StringVar(value=expression)
        visible = tk.BooleanVar(value=True)
        color = self.graph_series_colors[index % len(self.graph_series_colors)]
        row = tk.Frame(self.graph_function_rows_frame, bg=C["panel2"])
        row.pack(fill="x", padx=5, pady=3)
        marker = tk.Label(row, text=f"f{index+1}", bg=C["panel2"], fg=color,
                          font=(MONO, 9, "bold"), width=3)
        marker.pack(side="left")
        check = tk.Checkbutton(row, variable=visible, command=self._schedule_graph_redraw,
                               bg=C["panel2"], fg=C["text"], activebackground=C["panel2"],
                               activeforeground=C["cyan2"], selectcolor=C["panel3"],
                               relief="flat", bd=0, highlightthickness=0, takefocus=True)
        check.pack(side="left", padx=(0, 2))
        entry = styled_entry(row, variable, width=17, font_size=9)
        entry.pack(side="left", fill="x", expand=True, ipady=4)
        entry.bind("<Return>", lambda _e=None: self.draw_surface())
        self.graph_function_rows.append({"var": variable, "visible": visible, "frame": row, "color": color})

    def _graph_mode_changed(self) -> None:
        """Switch graph controls without relying on a temporarily hidden pack sibling."""
        is_2d = self.graph_mode.get().startswith("2D")
        # The domain card remains packed in both modes and is a stable anchor.
        # Using it as the insertion point avoids TclError when the other mode's
        # control panel has been pack-forgotten.
        if is_2d:
            self.graph_surface_panel.pack_forget()
            self.graph_function_panel.pack(fill="x", pady=(0, 8), before=self.graph_domain_panel)
            self.graph_3d_quality_panel.pack_forget()
            self.graph_surface_expr.pack_forget()
            self.graph_geometry_box.pack_forget()
            self.graph_2d_y_range_panel.pack(fill="x", pady=(0, 7), before=self.graph_domain_panel)
        else:
            self.graph_function_panel.pack_forget()
            self.graph_2d_y_range_panel.pack_forget()
            self.graph_surface_panel.pack(fill="x", pady=(0, 8), before=self.graph_domain_panel)
            self.graph_3d_quality_panel.pack(fill="x", pady=(4, 0))
            self.graph_surface_expr.pack(side="left", fill="x", expand=True, ipady=6, padx=(0, 7))
            self.graph_geometry_box.pack(side="left", padx=(0, 7))
            self.draw_surface()
        self._schedule_graph_redraw()

    def _graph_preset_selected(self, presets: dict[str, str]) -> None:
        self.surface_expr.set(presets.get(self.surface_preset.get(), "sin(x)*cos(y)"))
        self.graph_mode.set("3D Surface")
        self._graph_mode_changed()
        self.draw_surface()

    def _schedule_graph_redraw(self, _event=None) -> None:
        try:
            if self._graph_redraw_after:
                self.root.after_cancel(self._graph_redraw_after)
        except tk.TclError:
            pass
        try:
            self._graph_redraw_after = self.root.after(45, self.draw_surface)
        except tk.TclError:
            pass

    def _export_graph_image(self) -> None:
        """Export the current native Tk graph canvas using only the standard library."""
        path = filedialog.asksaveasfilename(
            parent=self.root, title="Export graph",
            defaultextension=".svg",
            filetypes=[("SVG vector image", "*.svg"), ("PDF document", "*.pdf"),
                       ("PostScript / EPS", "*.eps *.ps")]
        )
        if not path:
            return
        try:
            canvas = self.surface_canvas
            canvas.update_idletasks()
            width = max(1, canvas.winfo_width())
            height = max(1, canvas.winfo_height())
            ext = os.path.splitext(path)[1].lower()
            if ext in (".eps", ".ps"):
                canvas.postscript(file=path, colormode="color", pagewidth=f"{width}p",
                                  pageheight=f"{height}p")
            else:
                items = []
                for item in canvas.find_all():
                    kind = canvas.type(item)
                    coords = canvas.coords(item)
                    options = {}
                    for option in ("fill", "outline", "width", "text", "font", "anchor"):
                        try:
                            options[option] = canvas.itemcget(item, option)
                        except tk.TclError:
                            options[option] = ""
                    items.append((kind, coords, options))

                bg = canvas.cget("bg") or C["bg"]
                if ext == ".svg":
                    import html
                    chunks = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" viewBox="0 0 {width} {height}">',
                              f'<rect width="100%" height="100%" fill="{html.escape(bg)}"/>']
                    for kind, xy, opt in items:
                        fill = opt.get("fill") or "none"
                        stroke = opt.get("outline") or (opt.get("fill") if kind == "line" else "none")
                        sw = opt.get("width") or "1"
                        if kind == "line" and len(xy) >= 4:
                            pts = " ".join(f"{xy[i]:.2f},{xy[i+1]:.2f}" for i in range(0, len(xy)-1, 2))
                            chunks.append(f'<polyline points="{pts}" fill="none" stroke="{html.escape(stroke)}" stroke-width="{sw}" stroke-linecap="round" stroke-linejoin="round"/>')
                        elif kind == "rectangle" and len(xy) >= 4:
                            x0,y0,x1,y1=xy[:4]
                            chunks.append(f'<rect x="{min(x0,x1):.2f}" y="{min(y0,y1):.2f}" width="{abs(x1-x0):.2f}" height="{abs(y1-y0):.2f}" fill="{html.escape(fill)}" stroke="{html.escape(opt.get("outline") or "none")}" stroke-width="{sw}"/>')
                        elif kind == "oval" and len(xy) >= 4:
                            x0,y0,x1,y1=xy[:4]
                            chunks.append(f'<ellipse cx="{(x0+x1)/2:.2f}" cy="{(y0+y1)/2:.2f}" rx="{abs(x1-x0)/2:.2f}" ry="{abs(y1-y0)/2:.2f}" fill="{html.escape(fill)}" stroke="{html.escape(opt.get("outline") or "none")}" stroke-width="{sw}"/>')
                        elif kind == "polygon" and len(xy) >= 6:
                            pts = " ".join(f"{xy[i]:.2f},{xy[i+1]:.2f}" for i in range(0, len(xy)-1, 2))
                            chunks.append(f'<polygon points="{pts}" fill="{html.escape(fill)}" stroke="{html.escape(opt.get("outline") or "none")}" stroke-width="{sw}"/>')
                        elif kind == "text" and len(xy) >= 2:
                            text_value = html.escape(opt.get("text", ""))
                            anchor = opt.get("anchor") or "center"
                            anchor_map = {"w":"start", "nw":"start", "sw":"start", "e":"end", "ne":"end", "se":"end"}
                            font_size = 11
                            try:
                                parts = str(opt.get("font", "")).split()
                                for part in parts:
                                    if part.isdigit(): font_size = int(part)
                            except Exception: pass
                            chunks.append(f'<text x="{xy[0]:.2f}" y="{xy[1]:.2f}" fill="{html.escape(fill)}" font-family="Segoe UI,Arial,sans-serif" font-size="{font_size}" text-anchor="{anchor_map.get(anchor,"middle")}" dominant-baseline="middle">{text_value}</text>')
                    chunks.append("</svg>")
                    with open(path, "w", encoding="utf-8") as handle:
                        handle.write("\n".join(chunks))
                elif ext == ".pdf":
                    # Minimal vector PDF writer (no external graphics packages).
                    def rgb(value: str) -> tuple[float,float,float]:
                        try:
                            v=value.lstrip("#")
                            return tuple(int(v[i:i+2],16)/255 for i in (0,2,4))
                        except Exception:
                            return (0.0,0.0,0.0)
                    def esc(value: str) -> str:
                        return value.encode("latin-1", "replace").decode("latin-1").replace("\\", "\\\\").replace("(", "\\(").replace(")", "\\)")
                    commands=[]
                    r,g,b=rgb(bg); commands.append(f"{r:.3f} {g:.3f} {b:.3f} rg 0 0 {width} {height} re f")
                    for kind, xy, opt in items:
                        fill=opt.get("fill") or ""
                        stroke=opt.get("outline") or (fill if kind=="line" else "")
                        sw=float(opt.get("width") or 1)
                        if kind == "line" and len(xy)>=4:
                            rr,gg,bb=rgb(stroke or fill or "#FFFFFF")
                            commands.append(f"{rr:.3f} {gg:.3f} {bb:.3f} RG {sw:.2f} w")
                            commands.append(f"{xy[0]:.2f} {height-xy[1]:.2f} m")
                            for i in range(2,len(xy)-1,2): commands.append(f"{xy[i]:.2f} {height-xy[i+1]:.2f} l")
                            commands.append("S")
                        elif kind in ("rectangle","oval") and len(xy)>=4:
                            x0,y0,x1,y1=xy[:4]; x=min(x0,x1); y=height-max(y0,y1); w=abs(x1-x0); h=abs(y1-y0)
                            if kind == "rectangle":
                                rr,gg,bb=rgb(fill or stroke or bg); commands.append(f"{rr:.3f} {gg:.3f} {bb:.3f} rg {x:.2f} {y:.2f} {w:.2f} {h:.2f} re {'f' if fill else 'S'}")
                            else:
                                rr,gg,bb=rgb(stroke or fill or bg); cx=x+w/2; cy=y+h/2; k=.55228475
                                commands.append(f"{rr:.3f} {gg:.3f} {bb:.3f} RG {max(0.5,sw):.2f} w {cx+w/2:.2f} {cy:.2f} m {cx+w/2:.2f} {cy+k*h/2:.2f} {cx+k*w/2:.2f} {cy+h/2:.2f} {cx:.2f} {cy+h/2:.2f} c {cx-k*w/2:.2f} {cy+h/2:.2f} {cx-w/2:.2f} {cy+k*h/2:.2f} {cx-w/2:.2f} {cy:.2f} c {cx-w/2:.2f} {cy-k*h/2:.2f} {cx-k*w/2:.2f} {cy-h/2:.2f} {cx:.2f} {cy-h/2:.2f} c {cx+k*w/2:.2f} {cy-h/2:.2f} {cx+w/2:.2f} {cy-k*h/2:.2f} {cx+w/2:.2f} {cy:.2f} c S")
                        elif kind == "polygon" and len(xy)>=6:
                            rr,gg,bb=rgb(fill or stroke or bg); commands.append(f"{rr:.3f} {gg:.3f} {bb:.3f} rg")
                            commands.append(f"{xy[0]:.2f} {height-xy[1]:.2f} m")
                            for i in range(2,len(xy)-1,2): commands.append(f"{xy[i]:.2f} {height-xy[i+1]:.2f} l")
                            commands.append("h f")
                        elif kind == "text" and len(xy)>=2 and opt.get("text"):
                            rr,gg,bb=rgb(fill or "#FFFFFF")
                            commands.append(f"{rr:.3f} {gg:.3f} {bb:.3f} rg BT /F1 10 Tf {xy[0]:.2f} {height-xy[1]:.2f} Td ({esc(opt['text'])}) Tj ET")
                    stream="\n".join(commands).encode("latin-1", "replace")
                    objects=[b"<< /Type /Catalog /Pages 2 0 R >>",
                             b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
                             f"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 {width} {height}] /Resources << /Font << /F1 5 0 R >> >> /Contents 4 0 R >>".encode(),
                             b"<< /Length "+str(len(stream)).encode()+b" >>\nstream\n"+stream+b"\nendstream",
                             b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>"]
                    pdf=bytearray(b"%PDF-1.4\n%\xe2\xe3\xcf\xd3\n"); offsets=[0]
                    for idx,obj in enumerate(objects,1):
                        offsets.append(len(pdf)); pdf.extend(f"{idx} 0 obj\n".encode()); pdf.extend(obj); pdf.extend(b"\nendobj\n")
                    xref=len(pdf); pdf.extend(f"xref\n0 {len(objects)+1}\n0000000000 65535 f \n".encode())
                    for off in offsets[1:]: pdf.extend(f"{off:010d} 00000 n \n".encode())
                    pdf.extend(f"trailer\n<< /Size {len(objects)+1} /Root 1 0 R >>\nstartxref\n{xref}\n%%EOF".encode())
                    with open(path,"wb") as handle: handle.write(pdf)
                else:
                    raise ValueError("Choose SVG, PDF or EPS export format.")
            messagebox.showinfo("Graph exported", f"Graph saved successfully:\n{path}", parent=self.root)
        except Exception as exc:
            messagebox.showerror("Graph export failed", str(exc), parent=self.root)

    # ----- 2D multi-function plot -------------------------------------------
    def _draw_2d_function(self, canvas: tk.Canvas, w: int, h: int) -> None:
        canvas.delete("all")
        left, right, top, bottom = 66, w-28, 38, h-54
        try:
            xmin, xmax = float(self.surface_xmin.get()), float(self.surface_xmax.get())
            if not xmin < xmax:
                raise ValueError("X minimum must be smaller than maximum.")
            curves = []
            for index, item in enumerate(self.graph_function_rows):
                expr = item["var"].get().strip()
                if not expr or not item["visible"].get():
                    continue
                samples = []
                for i in range(601):
                    x = xmin + (xmax-xmin)*i/600
                    try:
                        y = float(safe_eval(expr, {**self._eval_context(), "x": x}))
                        samples.append((x, y if math.isfinite(y) and abs(y) < 1e7 else None))
                    except Exception:
                        samples.append((x, None))
                curves.append((index, expr, samples, item["color"]))
            if not curves:
                raise ValueError("Add a visible function such as sin(x) or x**2.")
            finite = [y for _i, _e, samples, _color in curves for _x, y in samples if y is not None]
            if not finite:
                raise ValueError("No real values were found in the selected range.")
            ylo, yhi = min(finite), max(finite)
            override_lo, override_hi = self.graph_ymin.get().strip(), self.graph_ymax.get().strip()
            if override_lo and override_hi:
                ylo, yhi = float(override_lo), float(override_hi)
            if not ylo < yhi:
                raise ValueError("Y minimum must be smaller than Y maximum.")
            if abs(yhi-ylo) < 1e-10:
                ylo -= 1; yhi += 1
            pad = (yhi-ylo)*.08
            if not (override_lo and override_hi):
                ylo, yhi = ylo-pad, yhi+pad

            def px(x): return left + (x-xmin)/(xmax-xmin)*(right-left)
            def py(y): return bottom - (y-ylo)/(yhi-ylo)*(bottom-top)

            canvas.create_rectangle(left, top, right, bottom, fill=C["panel2"], outline=C["line"])
            for i in range(11):
                gx = left + (right-left)*i/10
                gy = top + (bottom-top)*i/10
                canvas.create_line(gx, top, gx, bottom, fill=C["line"], width=1)
                canvas.create_line(left, gy, right, gy, fill=C["line"], width=1)
                xval = xmin + (xmax-xmin)*i/10
                yval = ylo + (yhi-ylo)*(9-i)/10
                x_label = "0" if abs(xval) < 1e-10 else f"{xval:.3g}"
                y_label = "0" if abs(yval) < 1e-10 else f"{yval:.3g}"
                canvas.create_text(gx, bottom+17, text=x_label, fill=C["muted"], font=(MONO, 8))
                if i % 2 == 0:
                    canvas.create_text(left-9, gy, text=y_label, fill=C["muted"], font=(MONO, 8), anchor="e")
            if xmin <= 0 <= xmax:
                canvas.create_line(px(0), top, px(0), bottom, fill=C["cyan2"], width=1.4)
            if ylo <= 0 <= yhi:
                canvas.create_line(left, py(0), right, py(0), fill=C["cyan2"], width=1.4)

            for index, expr, samples, color in curves:
                segment = []
                for x, y in samples:
                    if y is None or y < ylo-(yhi-ylo)*2 or y > yhi+(yhi-ylo)*2:
                        if len(segment) >= 4:
                            canvas.create_line(*segment, fill=color, width=2.5, smooth=False)
                        segment = []
                    else:
                        segment.extend((px(x), py(y)))
                if len(segment) >= 4:
                    canvas.create_line(*segment, fill=color, width=2.5, smooth=False)
            # Compact, legible legend overlay.
            legend_x = right - 12
            legend_y = top + 12
            for index, expr, _samples, color in curves:
                label = f"f{index+1}(x) = {expr}"
                tw = min(260, max(100, len(label)*6.1))
                canvas.create_rectangle(legend_x-tw-14, legend_y-7, legend_x+2, legend_y+13,
                                        fill=C["panel"], outline=C["line"])
                canvas.create_line(legend_x-tw-5, legend_y+3, legend_x-tw+7, legend_y+3,
                                   fill=color, width=3)
                canvas.create_text(legend_x-tw+13, legend_y+3, text=label,
                                   fill=C["text"], font=(FONT, 8), anchor="w")
                legend_y += 24
            canvas.create_text(14, 13, text="2D MULTI-FUNCTION PLOT", anchor="nw",
                               fill=C["cyan2"], font=(HEAD_FONT, 10, "bold"))
            self._last_graph_bounds = (xmin, xmax, ylo, yhi)
            self._last_graph_series = curves
            self.graph_status.set(f"Plotted {len(curves)} function(s)  ·  x ∈ [{fmt(xmin)}, {fmt(xmax)}]  ·  wheel to zoom")
        except Exception as exc:
            canvas.create_text(w/2, h/2, text=f"GRAPH ERROR\n{exc}", fill=C["red"],
                               font=(FONT, 10, "bold"), width=w-70, justify="center")
            self.graph_status.set(f"Graph error: {exc}")

    def _graph_kind_changed(self) -> None:
        kind = self.surface_kind.get()
        presets = {
            "z = f(x, y)": "sin(x) * cos(y)",
            "Sphere": "",
            "Sphere + cross-section": "",
            "Cylinder": "",
            "Torus": "",
            "Parametric surface": "cos(u)*(2+0.5*cos(v)); sin(u)*(2+0.5*cos(v)); 0.5*sin(v)",
        }
        if kind in presets:
            self.surface_expr.set(presets[kind])
        if hasattr(self, "graph_slice_row"):
            if kind == "Sphere + cross-section":
                self.graph_slice_row.pack(fill="x", pady=(4, 2))
            else:
                self.graph_slice_row.pack_forget()
        self.graph_status.set(f"Geometry selected: {kind}")
        self.draw_surface()

    def _surface_start_pan(self, event: tk.Event) -> None:
        self._pan_origin = (event.x, event.y)

    def _surface_pan(self, event: tk.Event) -> None:
        if self._pan_origin:
            ox, oy = self._pan_origin
            self.pan_x += event.x - ox
            self.pan_y += event.y - oy
            self._pan_origin = (event.x, event.y)
            self.draw_surface()

    # ----- Surface plot ------------------------------------------------------
    def _surface_start_drag(self, event: tk.Event) -> None:
        self._drag_origin = (event.x, event.y)

    def _surface_drag(self, event: tk.Event) -> None:
        if self._drag_origin:
            ox, oy = self._drag_origin
            dx, dy = event.x - ox, event.y - oy
            if self.graph_mode.get().startswith("2D"):
                try:
                    lo, hi = float(self.surface_xmin.get()), float(self.surface_xmax.get())
                    shift = -dx * (hi-lo) / max(250, self.surface_canvas.winfo_width())
                    self.surface_xmin.set(str(lo + shift))
                    self.surface_xmax.set(str(hi + shift))
                except Exception:
                    pass
            else:
                self.rot_y += dx * 0.008
                self.rot_x += dy * 0.008
            self._drag_origin = (event.x, event.y)
            self.draw_surface()

    def _surface_zoom(self, event: tk.Event) -> None:
        factor = 1.08 if event.delta > 0 else 0.92
        if self.graph_mode.get().startswith("2D"):
            try:
                lo, hi = float(self.surface_xmin.get()), float(self.surface_xmax.get())
                center = (lo + hi) / 2
                half = (hi - lo) / 2 / factor
                self.surface_xmin.set(str(center-half))
                self.surface_xmax.set(str(center+half))
                self.draw_surface()
            except Exception:
                self.graph_status.set("Enter valid numeric x-range values to zoom.")
        else:
            self._surface_zoom_step(factor)

    def _surface_zoom_step(self, factor: float) -> None:
        if getattr(self, "graph_mode", None) and self.graph_mode.get().startswith("2D"):
            try:
                lo, hi = float(self.surface_xmin.get()), float(self.surface_xmax.get())
                center = (lo + hi) / 2
                half = (hi - lo) / 2 / factor
                self.surface_xmin.set(str(center - half))
                self.surface_xmax.set(str(center + half))
            except (ValueError, ZeroDivisionError):
                self.graph_status.set("Enter valid X domain bounds before zooming.")
                return
        else:
            self.surface_zoom = min(2.4, max(0.35, self.surface_zoom * factor))
        self.draw_surface()

    def _reset_surface(self) -> None:
        self.rot_x, self.rot_y, self.surface_zoom = 0.92, -0.72, 1.0
        self.pan_x, self.pan_y = 0.0, 0.0
        if getattr(self, "graph_mode", None) and self.graph_mode.get().startswith("2D"):
            self.surface_xmin.set("-6.28")
            self.surface_xmax.set("6.28")
            self.graph_ymin.set("")
            self.graph_ymax.set("")
        self.draw_surface()

    def draw_surface(self) -> None:
        if not hasattr(self, "surface_canvas"):
            return
        try:
            if not self.surface_canvas.winfo_exists():
                return
        except tk.TclError:
            return
        canvas = self.surface_canvas
        w, h = max(canvas.winfo_width(), 300), max(canvas.winfo_height(), 300)
        canvas.delete("all")
        if getattr(self, "graph_mode", None) and self.graph_mode.get().startswith("2D"):
            self._draw_2d_function(canvas, w, h)
            return
        # Layered cyan atmosphere behind the projected 3D wireframe.
        canvas.create_oval(w * .19, h * .08, w * .82, h * .92,
                           fill=C["panel3"], outline="")
        canvas.create_oval(w * .29, h * .18, w * .72, h * .82,
                           fill=C["panel2"], outline="")
        cx, cy = w * 0.51, h * 0.51
        scale = min(w, h) * 0.095 * self.surface_zoom
        rx, ry = self.rot_x, self.rot_y
        crx, srx, cry, sry = math.cos(rx), math.sin(rx), math.cos(ry), math.sin(ry)

        def project(x: float, y: float, z: float) -> tuple[float, float, float]:
            # Rotate Y then X; z is slightly compressed for a neat dashboard view.
            x1 = x * cry - y * sry
            y1 = x * sry + y * cry
            z1 = z * 1.0
            y2 = y1 * crx - z1 * srx
            z2 = y1 * srx + z1 * crx
            perspective = 1.0 / (1.0 + (z2 + 0.5) * 0.012)
            return cx + x1 * scale * perspective + self.pan_x, cy - z2 * scale * perspective + self.pan_y, z2

        # Editable domain and mesh settings.
        try:
            xmin, xmax = float(self.surface_xmin.get()), float(self.surface_xmax.get())
            ymin, ymax = float(self.surface_ymin.get()), float(self.surface_ymax.get())
            if not xmin < xmax or not ymin < ymax:
                raise ValueError("Minimum must be smaller than maximum.")
            n = max(12, min(41, int(self.surface_density.get())))
        except Exception as exc:
            self.graph_status.set(f"Graph settings error: {exc}")
            canvas.create_text(cx, cy, text="CHECK DOMAIN / MESH SETTINGS",
                               fill=C["cyan2"], font=(FONT, 13, "bold"))
            return
        # Ground reference grid follows the user-selected domain.
        z_floor = -1.5
        for k in range(9):
            xv = xmin + (xmax - xmin) * k / 8
            yv = ymin + (ymax - ymin) * k / 8
            p1, p2 = project(xv, ymin, z_floor), project(xv, ymax, z_floor)
            p3, p4 = project(xmin, yv, z_floor), project(xmax, yv, z_floor)
            canvas.create_line(p1[0], p1[1], p2[0], p2[1], fill=C["sapphire_dark"], width=1)
            canvas.create_line(p3[0], p3[1], p4[0], p4[1], fill=C["sapphire_dark"], width=1)
        kind = self.surface_kind.get() if hasattr(self, "surface_kind") else "z = f(x, y)"
        expr = self.surface_expr.get().strip() or "sin(x)*cos(y)"
        vertices: list[list[tuple[float, float, float]]] = []
        cross_section_line: list[float] | None = None
        invalid_samples = 0
        # The 3D lab supports height fields plus classic parametric solids/surfaces.
        try:
            if kind in ("Sphere", "Sphere + cross-section"):
                us = [2*math.pi*i/(n-1) for i in range(n)]
                vs = [-math.pi/2 + math.pi*j/(n-1) for j in range(n)]
                for u in us:
                    col = []
                    for v in vs:
                        x = 2*math.cos(v)*math.cos(u)
                        y = 2*math.cos(v)*math.sin(u)
                        z = 2*math.sin(v)
                        col.append(project(x, y, z))
                    vertices.append(col)
            elif kind == "Cylinder":
                us = [2*math.pi*i/(n-1) for i in range(n)]
                vs = [-2.5 + 5*j/(n-1) for j in range(n)]
                for u in us:
                    vertices.append([project(math.cos(u), math.sin(u), v) for v in vs])
            elif kind == "Torus":
                us = [2*math.pi*i/(n-1) for i in range(n)]
                vs = [2*math.pi*j/(n-1) for j in range(n)]
                for u in us:
                    col = []
                    for v in vs:
                        ring = 1.5 + 0.58*math.cos(v)
                        col.append(project(ring*math.cos(u), ring*math.sin(u), 0.58*math.sin(v)))
                    vertices.append(col)
            elif kind == "Parametric surface":
                parts = [part.strip() for part in expr.split(";")]
                if len(parts) != 3:
                    raise ValueError("Parametric format: x(u,v); y(u,v); z(u,v)")
                us = [xmin + (xmax-xmin)*i/(n-1) for i in range(n)]
                vs = [ymin + (ymax-ymin)*j/(n-1) for j in range(n)]
                for u in us:
                    col = []
                    for v in vs:
                        env = {"u": u, "v": v}
                        x = float(safe_eval(parts[0], env))
                        y = float(safe_eval(parts[1], env))
                        z = float(safe_eval(parts[2], env))
                        col.append(project(x, y, max(-5.0, min(5.0, z))))
                    vertices.append(col)
            else:
                xs = [xmin + (xmax - xmin) * i / (n - 1) for i in range(n)]
                ys = [ymin + (ymax - ymin) * j / (n - 1) for j in range(n)]
                for x in xs:
                    col = []
                    for y in ys:
                        try:
                            z = float(safe_eval(expr, {"x": x, "y": y}))
                            if not math.isfinite(z):
                                raise ValueError("non-finite value")
                            z = max(-2.5, min(2.5, z))
                        except Exception:
                            invalid_samples += 1
                            z = 0.0
                        col.append(project(x, y, z))
                    vertices.append(col)
        except Exception as exc:
            vertices = []
            self.graph_status.set(f"Geometry error: {exc}")
        if kind in ("Sphere", "Sphere + cross-section") and vertices and kind == "Sphere + cross-section":
            try:
                z_slice = float(self.slice_z.get())
                if abs(z_slice) > 2:
                    raise ValueError("For a radius-2 sphere, use a slice between −2 and 2.")
                radius = math.sqrt(max(0.0, 4-z_slice*z_slice))
                ring_points = []
                for i in range(121):
                    theta = 2*math.pi*i/120
                    point = project(radius*math.cos(theta), radius*math.sin(theta), z_slice)
                    ring_points.extend(point[:2])
                cross_section_line = ring_points
                canvas.create_text(18, 38, text=f"SPHERE CROSS-SECTION  /  z = {fmt(z_slice)}",
                                   anchor="nw", fill=C["cyan2"], font=(FONT, 8, "bold"))
            except Exception as exc:
                self.graph_status.set(f"Cross-section input: {exc}")
        if invalid_samples > (n * n * 0.80):
            vertices = []
        if vertices:
            # Draw the more distant mesh rows first for a stronger 3D impression.
            for i in range(n):
                pts = []
                for j in range(n):
                    pts.extend(vertices[i][j][:2])
                canvas.create_line(*pts, fill=C["sapphire_dark"], width=3, smooth=False)
                canvas.create_line(*pts, fill=C["cyan"], width=1.15, smooth=False)
            for j in range(n):
                pts = []
                for i in range(n):
                    pts.extend(vertices[i][j][:2])
                canvas.create_line(*pts, fill=C["sapphire_dark"], width=3, smooth=False)
                canvas.create_line(*pts, fill=C["cyan2"], width=1.0, smooth=False)
            # Sparse luminous vertices create a holographic point-cloud impression.
            stride = max(3, n // 8)
            for i in range(0, n, stride):
                for j in range(0, n, stride):
                    px, py, _pz = vertices[i][j]
                    canvas.create_oval(px-2, py-2, px+2, py+2,
                                       fill=C["cyan2"], outline=C["cyan"])
        if cross_section_line:
            canvas.create_line(*cross_section_line, fill=C["cyan2"], width=2, smooth=True)
        # Axes and labels.
        origin = project(0, 0, z_floor)
        xend = project(xmax + (xmax-xmin)*.12, 0, z_floor)
        yend = project(0, ymax + (ymax-ymin)*.12, z_floor)
        zend = project(0, 0, 2.1)
        for end, color in [(xend, C["blue"]), (yend, C["mint"]), (zend, C["cyan2"])]:
            canvas.create_line(origin[0], origin[1], end[0], end[1],
                               fill=color, width=2, arrow="last")
        canvas.create_text(xend[0] + 8, xend[1] + 4, text="x",
                           fill=C["blue"], font=(FONT, 10, "bold"))
        canvas.create_text(yend[0] + 8, yend[1], text="y",
                           fill=C["mint"], font=(FONT, 10, "bold"))
        canvas.create_text(zend[0], zend[1] - 12, text="z",
                           fill=C["cyan2"], font=(FONT, 10, "bold"))
        canvas.create_text(18, 18, text=f"HOLOGRAPHIC 3D  /  {kind.upper()}",
                           anchor="nw", fill=C["cyan2"], font=(FONT, 9, "bold"))
        if not vertices:
            canvas.create_text(cx, cy, text="INVALID EXPRESSION — TRY sin(x)*cos(y)",
                               fill=C["red"], font=(FONT, 10, "bold"))
        if vertices:
            detail = expr if kind in ("z = f(x, y)", "Parametric surface") else kind
            self.graph_status.set(f"Rendered {n} × {n} mesh  ·  {detail}")
        else:
            self.graph_status.set("Expression error · check function names and domain")
        if hasattr(self, "graph_camera"):
            self.graph_camera.set(
                f"ORBIT X  {self.rot_x: .2f}   ·   ORBIT Y  {self.rot_y: .2f}\n"
                f"ZOOM  {self.surface_zoom: .2f}×"
            )

    # ----- Scientific calculator --------------------------------------------

    def clear_display(self) -> None:
        self.display_var.set("")


    # ----- Calculus / algebra ------------------------------------------------
    def run_calculus(self) -> None:
        expr = self.calculus_expr.get().strip()
        op_name = self.calculus_op.get()
        try:
            x1 = float(self.calc_x1.get())
            x2 = float(self.calc_x2.get())
            if op_name == "Evaluate at x":
                value = safe_eval(expr, {"x": x1})
                out = f"f({fmt(x1)}) = {fmt(value, 12)}"
            elif op_name == "Integrate (definite)":
                value = self._simpson_integral(expr, x1, x2)
                out = f"∫[{fmt(x1)}, {fmt(x2)}] f(x) dx  ≈  {fmt(value, 12)}"
                if sp is not None:
                    try:
                        symx = sp.symbols("x")
                        exact = sp.integrate(sp.sympify(expr.replace("^", "**")), (symx, x1, x2))
                        out += f"\nExact: {exact}"
                    except Exception:
                        pass
            elif op_name == "Differentiate":
                order = max(1, min(5, int(self.calc_order.get()))) if hasattr(self, "calc_order") else 1
                if sp is not None:
                    symx = sp.symbols("x")
                    derived = sp.diff(sp.sympify(expr.replace("^", "**")), symx, order)
                    numeric = safe_eval(str(derived), {"x": x1})
                    out = f"d^{order}f/dx^{order} = {derived}\nAt x={fmt(x1)}  →  {fmt(numeric, 12)}"
                elif order == 1:
                    h = 1e-5
                    f1 = safe_eval(expr, {"x": x1 + h})
                    f0 = safe_eval(expr, {"x": x1 - h})
                    out = (f"Numerical first derivative at x={fmt(x1)}  ≈  "
                           f"{fmt((f1-f0)/(2*h), 12)}\nInstall SymPy for symbolic derivatives up to 5th order.")
                else:
                    raise ValueError("Install SymPy to calculate symbolic derivatives above first order: pip install sympy")
            elif op_name in ("Expand", "Factor"):
                if sp is None:
                    out = "Install SymPy for symbolic expand/factor:  pip install sympy"
                else:
                    symx = sp.symbols("x")
                    parsed = sp.sympify(expr.replace("^", "**"))
                    out = str(sp.expand(parsed) if op_name == "Expand" else sp.factor(parsed))
            else:
                out = "Choose a valid operation."
            self.calculus_result.set(out)
            self._console_write(f"{op_name}: {out}")
        except Exception as exc:
            self.calculus_result.set(f"Error: {exc}")

    @staticmethod
    def _simpson_integral(expr: str, a: float, b: float, n: int = 1000) -> float:
        if a == b:
            return 0.0
        if n % 2:
            n += 1
        h = (b - a) / n
        total = safe_eval(expr, {"x": a}) + safe_eval(expr, {"x": b})
        for i in range(1, n):
            x = a + i * h
            total += (4 if i % 2 else 2) * safe_eval(expr, {"x": x})
        return float(total * h / 3)

    # ----- Statistics --------------------------------------------------------
    def update_stats(self) -> None:
        if not hasattr(self, "stats_canvas"):
            return
        try:
            data = [float(v.strip()) for v in self.stats_input.get().split(",") if v.strip()]
            if not data:
                raise ValueError("Enter comma-separated numbers.")
            mean = statistics.mean(data)
            median = statistics.median(data)
            modes = statistics.multimode(data)
            variance = statistics.pvariance(data) if len(data) > 1 else 0.0
            sd = math.sqrt(variance)
            self.stats_summary.set(
                f"N     {len(data)}     MEAN    {fmt(mean, 6)}\n"
                f"MED   {fmt(median, 6)}   STD DEV {fmt(sd, 6)}\n"
                f"VAR   {fmt(variance, 6)}   RANGE   {fmt(max(data)-min(data), 6)}\n"
                f"MIN   {fmt(min(data))}     MAX     {fmt(max(data))}\n"
                f"MODE  {', '.join(fmt(m) for m in modes)}"
            )
            self._draw_stats_chart(data)
        except Exception as exc:
            self.stats_summary.set(f"Data error: {exc}")
            self.stats_canvas.delete("all")

    def _draw_stats_chart(self, data: list[float]) -> None:
        c = self.stats_canvas
        c.delete("all")
        w, h = max(c.winfo_width(), 240), max(c.winfo_height(), 220)
        left, right = 30, w - 14
        top, mid, bottom = 19, int(h * 0.49), h - 22

        unique = sorted(set(data))
        if len(unique) <= 9:
            labels = unique
            counts = [data.count(x) for x in unique]
        else:
            bins = min(8, max(4, round(math.sqrt(len(data)))))
            lo, hi = min(data), max(data)
            bucket_width = (hi - lo) / bins if hi != lo else 1
            counts = [0] * bins
            for value in data:
                idx = min(bins - 1, int((value - lo) / bucket_width))
                counts[idx] += 1
            labels = [lo + bucket_width * (i + .5) for i in range(bins)]
        max_count = max(counts) if counts else 1

        for g in range(3):
            y = mid - 8 - (mid - 8 - top) * g / 2
            c.create_line(left, y, right, y, fill=C["line"])

        slot = (right - left) / max(1, len(counts))
        for i, count in enumerate(counts):
            x0 = left + i * slot + slot * .19
            x1 = left + (i + 1) * slot - slot * .19
            y1 = mid - 8 - (mid - 8 - top) * count / max_count
            c.create_rectangle(x0 + 2, y1 + 2, x1 + 2, mid - 8 + 2,
                               fill=C["bg"], outline="")
            c.create_rectangle(x0, y1, x1, mid - 8,
                               fill=C["sapphire_dark"], outline=C["cyan"], width=1.3)
            c.create_text((x0 + x1) / 2, max(top, y1 - 8), text=str(count),
                          fill=C["cyan2"], font=(MONO, 7))
            c.create_text((x0 + x1) / 2, mid + 1, text=fmt(labels[i], 3),
                          fill=C["muted"], font=(MONO, 7))

        c.create_text(left, 4, text="FREQUENCY", fill=C["muted"],
                      anchor="nw", font=(FONT, 7, "bold"))
        c.create_line(left, mid + 17, right, mid + 17, fill=C["line"])
        c.create_text(left, mid + 21, text="DATA TREND OVER TIME",
                      fill=C["muted"], anchor="nw", font=(FONT, 7, "bold"))

        plot_top, plot_bottom = mid + 45, bottom - 3
        lo, hi = min(data), max(data)
        if hi == lo:
            hi = lo + 1
        for g in range(3):
            y = plot_bottom - (plot_bottom - plot_top) * g / 2
            c.create_line(left, y, right, y, fill=C["line"])

        points: list[float] = []
        for i, value in enumerate(data):
            x = left + (right - left) * i / max(1, len(data) - 1)
            y = plot_bottom - (value - lo) / (hi - lo) * (plot_bottom - plot_top)
            points.extend((x, y))
        if len(points) >= 4:
            c.create_line(*points, fill=C["cyan"], width=2, smooth=True)
        for i in range(0, len(points), 2):
            c.create_oval(points[i] - 2.3, points[i+1] - 2.3,
                          points[i] + 2.3, points[i+1] + 2.3,
                          fill=C["mint"], outline="")

    # ----- Console -----------------------------------------------------------

    def _eval_context(self) -> dict[str, Any]:
        context: dict[str, Any] = {**self.variables, "Ans": self.ans}
        if self.angle_mode.get() == "DEG":
            sin_d = lambda value: math.sin(math.radians(value))
            cos_d = lambda value: math.cos(math.radians(value))
            tan_d = lambda value: math.tan(math.radians(value))
            context.update({
                "sin": sin_d, "cos": cos_d, "tan": tan_d,
                "sec": lambda value: 1/cos_d(value),
                "csc": lambda value: 1/sin_d(value),
                "cot": lambda value: 1/tan_d(value),
                "asin": lambda value: math.degrees(math.asin(value)),
                "acos": lambda value: math.degrees(math.acos(value)),
                "atan": lambda value: math.degrees(math.atan(value)),
            })
        return context


    def run_console(self) -> None:
        expr = self.console_input.get().strip()
        if not expr:
            return
        try:
            assignment = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.+)", expr)
            if assignment:
                name, rhs = assignment.group(1), assignment.group(2)
                if name in CONSTS or name in FUNCS or name == "Ans":
                    raise ValueError("That name is reserved. Try R, T, x, y, a or b.")
                result = safe_eval(rhs, self._eval_context())
                self.variables[name] = result
                self.ans = result
                self._sync_variable_status()
                self._console_write(f"> {expr}\n{name} = {fmt(result, 12)}  ·  variable stored")
            else:
                result = safe_eval(expr, self._eval_context())
                self.ans = result
                self._sync_variable_status()
                self._console_write(f"> {expr}\n{fmt(result, 12)}")
        except Exception as exc:
            self._console_write(f"> {expr}\nError: {exc}")
        self.console_input.set("")

    # ----- Finance workspace -------------------------------------------------
    def _build_finance(self) -> None:
        page = self.finance_page
        top = tk.Frame(page, bg=C["bg"])
        top.pack(fill="x", pady=(5, 10))
        tk.Label(top, text="FINANCIAL TOOLKIT", bg=C["bg"], fg=C["text"],
                 font=(FONT, 18, "bold")).pack(anchor="w")
        tk.Label(top, text="EMI  •  SIP  •  FD  •  INTEREST  •  GST & DISCOUNT",
                 bg=C["bg"], fg=C["muted"],
                 font=(FONT, 8, "bold")).pack(anchor="w", pady=(3, 0))
        tabs = ttk.Notebook(page)
        tabs.pack(fill="both", expand=True)
        self.emi_page = tk.Frame(tabs, bg=C["bg"])
        self.sip_page = tk.Frame(tabs, bg=C["bg"])
        self.fd_page = tk.Frame(tabs, bg=C["bg"])
        self.interest_page = tk.Frame(tabs, bg=C["bg"])
        self.gst_page = tk.Frame(tabs, bg=C["bg"])
        self.schedule_page = tk.Frame(tabs, bg=C["bg"])
        self.growth_page = tk.Frame(tabs, bg=C["bg"])

        for frame, name in [
            (self.emi_page, "EMI SOLVER"),
            (self.sip_page, "SIP"),
            (self.fd_page, "FIXED DEPOSIT"),
            (self.interest_page, "INTEREST"),
            (self.gst_page, "GST / DISCOUNT"),
            (self.schedule_page, "LOAN SCHEDULE"),
            (self.growth_page, "CAGR / GROWTH"),
        ]:
            tabs.add(frame, text=f"  {name}  ")

        self._build_emi()
        self._build_sip()
        self._build_fd()
        self._build_interest()
        self._build_gst()
        self._build_amortization()
        self._build_cagr()

    def _finance_layout(self, parent: tk.Widget, title: str, desc: str) -> tuple[tk.Frame, tk.Frame]:
        shell = tk.Frame(parent, bg=C["bg"])
        shell.pack(fill="both", expand=True, padx=16, pady=13)
        shell.grid_columnconfigure(0, weight=3)
        shell.grid_columnconfigure(1, weight=2)
        form = card(shell, title, desc)
        result = card(shell, "RESULTS", "LIVE SUMMARY", accent="fusion")
        form.grid(row=0, column=0, sticky="nsew", padx=(0, 8))
        result.grid(row=0, column=1, sticky="nsew", padx=(8, 0))
        return form, result

    def _result_box(self, parent: tk.Widget, var: tk.StringVar) -> None:
        tk.Label(parent, textvariable=var, bg=C["bg2"], fg=C["cyan2"],
                 font=(MONO, 11), justify="left", anchor="nw",
                 padx=15, pady=16, wraplength=370, relief="sunken", bd=3,
                 highlightthickness=1, highlightbackground=C["line2"]).pack(
                     fill="both", expand=True, padx=14, pady=(0, 13)
                 )

    # ----- EMI calculator ----------------------------------------------------
    def _build_emi(self) -> None:
        form, result = self._finance_layout(
            self.emi_page, "ADVANCED EMI CALCULATOR",
            "SOLVE FOR PRINCIPAL · EMI · RATE · TENURE"
        )
        body = tk.Frame(form, bg=C["panel"])
        body.pack(fill="both", expand=True, padx=16, pady=(0, 14))
        self.emi_target = tk.StringVar(value="EMI")
        tk.Label(body, text="SOLVE FOR", bg=C["panel"], fg=C["muted"],
                 font=(FONT, 9, "bold")).grid(
                     row=0, column=0, sticky="w", pady=(0, 5)
                 )
        combo = ttk.Combobox(
            body, textvariable=self.emi_target, state="readonly",
            values=["EMI", "Principal", "Annual interest rate", "Tenure (months)"],
            width=25
        )
        combo.grid(row=1, column=0, sticky="ew", pady=(0, 10))
        combo.bind("<<ComboboxSelected>>", self._emi_target_changed)

        self.emi_fields: dict[str, tk.Entry] = {}
        field_specs = [
            ("Principal (₹)", "250000", "principal"),
            ("Monthly EMI (₹)", "", "emi"),
            ("Annual interest rate (%)", "9.5", "rate"),
            ("Tenure (months)", "60", "months"),
        ]
        for i, (label, default, key) in enumerate(field_specs):
            row = 2 + i // 2
            col = i % 2
            wrap = tk.Frame(body, bg=C["panel"])
            wrap.grid(row=row, column=col, sticky="ew",
                      padx=(0 if col == 0 else 10, 0), pady=7)
            tk.Label(wrap, text=label, bg=C["panel"], fg=C["muted"],
                     font=(FONT, 9, "bold")).pack(anchor="w", pady=(0, 5))
            var = tk.StringVar(value=default)
            e = styled_entry(wrap, var, width=22, font_size=11)
            e.pack(fill="x", ipady=9)
            e.var = var  # type: ignore[attr-defined]
            self.emi_fields[key] = e

        body.grid_columnconfigure(0, weight=1)
        body.grid_columnconfigure(1, weight=1)
        tk.Label(
            body,
            text="Leave the selected target field blank. Other fields are inputs.",
            bg=C["panel"], fg=C["muted"], font=(FONT, 8)
        ).grid(row=4, column=0, columnspan=2, sticky="w", pady=(6, 9))
        neon_button(
            body, "CALCULATE EMI  ✦", self.calculate_emi,
            width=22, height=2, font_size=10
        ).grid(row=5, column=0, sticky="w", pady=5)

        self.emi_result = tk.StringVar(
            value="Select what you want to solve, fill the other three values, then calculate.\n\n"
                  "The solver supports zero-interest loans and estimates the annual rate "
                  "using a numerical method."
        )
        self._result_box(result, self.emi_result)

    def _emi_target_changed(self, _event: Any = None) -> None:
        target_map = {
            "EMI": "emi",
            "Principal": "principal",
            "Annual interest rate": "rate",
            "Tenure (months)": "months",
        }
        key = target_map.get(self.emi_target.get())
        if key:
            self.emi_fields[key].delete(0, "end")
            self.emi_fields[key].focus_set()

    def calculate_emi(self) -> None:
        try:
            target = self.emi_target.get()
            vals: dict[str, float | None] = {}
            for key, entry in self.emi_fields.items():
                raw = entry.get().strip().replace(",", "")
                vals[key] = float(raw) if raw else None

            p = vals["principal"]
            payment = vals["emi"]
            annual = vals["rate"]
            months = vals["months"]

            if p is not None and p <= 0:
                raise ValueError("Principal must be greater than zero.")
            if payment is not None and payment <= 0:
                raise ValueError("EMI must be greater than zero.")
            if annual is not None and annual < 0:
                raise ValueError("Annual interest rate cannot be negative.")
            if months is not None and months <= 0:
                raise ValueError("Tenure must be greater than zero.")

            if target == "EMI":
                if None in (p, annual, months):
                    raise ValueError("Enter principal, annual rate and tenure.")
                payment = emi_payment(float(p), float(annual), float(months))
                self.emi_fields["emi"].delete(0, "end")
                self.emi_fields["emi"].insert(0, f"{payment:.2f}")

            elif target == "Principal":
                if None in (payment, annual, months):
                    raise ValueError("Enter EMI, annual rate and tenure.")
                r = float(annual) / 1200
                n = float(months)
                p = (
                    float(payment) * n
                    if r == 0
                    else float(payment) * ((1+r)**n - 1) / (r * (1+r)**n)
                )
                self.emi_fields["principal"].delete(0, "end")
                self.emi_fields["principal"].insert(0, f"{p:.2f}")

            elif target == "Annual interest rate":
                if None in (p, payment, months):
                    raise ValueError("Enter principal, EMI and tenure.")
                annual = solve_loan_rate(float(p), float(payment), float(months))
                self.emi_fields["rate"].delete(0, "end")
                self.emi_fields["rate"].insert(0, f"{annual:.6f}")

            elif target == "Tenure (months)":
                if None in (p, payment, annual):
                    raise ValueError("Enter principal, EMI and annual rate.")
                months = solve_loan_months(float(p), float(payment), float(annual))
                self.emi_fields["months"].delete(0, "end")
                self.emi_fields["months"].insert(0, f"{months:.4f}")

            if None in (p, payment, annual, months):
                raise ValueError("Please complete the loan inputs.")

            total = float(payment) * float(months)
            interest = total - float(p)
            self.emi_result.set(
                f"LOAN SUMMARY\n\n"
                f"Principal      {money(float(p))}\n"
                f"Monthly EMI    {money(float(payment))}\n"
                f"Annual rate    {fmt(float(annual), 7)} %\n"
                f"Tenure         {fmt(float(months), 7)} months\n\n"
                f"Total payment  {money(total)}\n"
                f"Total interest {money(interest)}\n\n"
                f"Solved for: {target}"
            )
        except Exception as exc:
            self.emi_result.set(f"Unable to calculate\n\n{exc}")

    # ----- SIP calculator ----------------------------------------------------
    def _build_sip(self) -> None:
        form, result = self._finance_layout(
            self.sip_page, "SIP RETURNS CALCULATOR", "MONTHLY INVESTMENT GROWTH"
        )
        body = tk.Frame(form, bg=C["panel"])
        body.pack(fill="both", expand=True, padx=16, pady=(0, 14))
        self.sip_monthly = add_field(body, "Monthly investment (₹)", "5000", row=0, column=0)
        self.sip_rate = add_field(body, "Expected annual return (%)", "12", row=0, column=1)
        self.sip_years = add_field(body, "Investment period (years)", "10", row=1, column=0)
        tk.Label(
            body,
            text="Assumes month-end contributions and monthly compounding of the expected annual rate.",
            bg=C["panel"], fg=C["muted"], font=(FONT, 8),
            wraplength=440, justify="left"
        ).grid(row=2, column=0, columnspan=2, sticky="w", padx=7, pady=10)
        neon_button(body, "CALCULATE SIP", self.calculate_sip,
                    width=18, height=2).grid(row=3, column=0, sticky="w", padx=7, pady=6)
        self.sip_result = tk.StringVar(
            value="Enter your monthly contribution, expected return and investment period."
        )
        self._result_box(result, self.sip_result)

    def calculate_sip(self) -> None:
        try:
            p = float(self.sip_monthly.get())
            annual = float(self.sip_rate.get())
            years = float(self.sip_years.get())
            if p < 0 or annual < 0 or years <= 0:
                raise ValueError("Investment must be non-negative; years must be positive.")
            n = years * 12
            r = annual / 1200
            fv = p * n if r == 0 else p * (((1+r)**n - 1) / r)
            invested = p * n
            self.sip_result.set(
                f"SIP SUMMARY\n\n"
                f"Future value     {money(fv)}\n"
                f"Amount invested  {money(invested)}\n"
                f"Estimated gain   {money(fv-invested)}\n\n"
                f"Monthly SIP      {money(p)}\n"
                f"Annual return    {fmt(annual)} %\n"
                f"Period           {fmt(years)} years\n\n"
                f"Illustrative estimate only; actual returns vary with market performance."
            )
        except Exception as exc:
            self.sip_result.set(f"Unable to calculate\n\n{exc}")

    # ----- Fixed deposit calculator -----------------------------------------
    def _build_fd(self) -> None:
        form, result = self._finance_layout(
            self.fd_page, "FIXED DEPOSIT CALCULATOR", "COMPOUND INTEREST"
        )
        body = tk.Frame(form, bg=C["panel"])
        body.pack(fill="both", expand=True, padx=16, pady=(0, 14))
        self.fd_principal = add_field(body, "Deposit amount (₹)", "100000", row=0, column=0)
        self.fd_rate = add_field(body, "Annual interest rate (%)", "7.25", row=0, column=1)
        self.fd_years = add_field(body, "Tenure (years)", "5", row=1, column=0)
        self.fd_freq = tk.StringVar(value="4 times / year (quarterly)")
        tk.Label(body, text="Compounding frequency", bg=C["panel"], fg=C["muted"],
                 font=(FONT, 9, "bold")).grid(row=1, column=1, sticky="w", padx=7, pady=6)
        ttk.Combobox(
            body, textvariable=self.fd_freq, state="readonly", width=25,
            values=[
                "1 time / year (annually)",
                "2 times / year (half-yearly)",
                "4 times / year (quarterly)",
                "12 times / year (monthly)"
            ]
        ).grid(row=2, column=1, sticky="ew", padx=7, pady=4)
        neon_button(body, "CALCULATE MATURITY", self.calculate_fd,
                    width=21, height=2).grid(row=3, column=0, sticky="w", padx=7, pady=12)
        self.fd_result = tk.StringVar(
            value="Calculate the estimated maturity value of a fixed deposit."
        )
        self._result_box(result, self.fd_result)

    def calculate_fd(self) -> None:
        try:
            p = float(self.fd_principal.get())
            r = float(self.fd_rate.get()) / 100
            t = float(self.fd_years.get())
            m = {
                "1 time / year (annually)": 1,
                "2 times / year (half-yearly)": 2,
                "4 times / year (quarterly)": 4,
                "12 times / year (monthly)": 12
            }[self.fd_freq.get()]
            if p < 0 or r < 0 or t < 0:
                raise ValueError("Values cannot be negative.")
            amount = p * (1 + r/m) ** (m*t)
            self.fd_result.set(
                f"FD SUMMARY\n\n"
                f"Maturity value   {money(amount)}\n"
                f"Principal        {money(p)}\n"
                f"Interest earned  {money(amount-p)}\n\n"
                f"Annual rate      {fmt(r*100)} %\n"
                f"Tenure           {fmt(t)} years\n"
                f"Compounding      {m} times per year"
            )
        except Exception as exc:
            self.fd_result.set(f"Unable to calculate\n\n{exc}")

    # ----- Simple / compound interest ---------------------------------------
    def _build_interest(self) -> None:
        form, result = self._finance_layout(
            self.interest_page, "SIMPLE & COMPOUND INTEREST", "COMPARE INTEREST METHODS"
        )
        body = tk.Frame(form, bg=C["panel"])
        body.pack(fill="both", expand=True, padx=16, pady=(0, 14))
        self.int_principal = add_field(body, "Principal (₹)", "50000", row=0, column=0)
        self.int_rate = add_field(body, "Annual rate (%)", "8", row=0, column=1)
        self.int_time = add_field(body, "Time (years)", "3", row=1, column=0)
        self.int_frequency = tk.StringVar(value="4")
        tk.Label(body, text="Compounds per year (CI)", bg=C["panel"], fg=C["muted"],
                 font=(FONT, 9, "bold")).grid(row=1, column=1, sticky="w", padx=7, pady=6)
        ttk.Combobox(
            body, textvariable=self.int_frequency, state="readonly",
            values=["1", "2", "4", "12", "365"], width=8
        ).grid(row=2, column=1, sticky="ew", padx=7)
        neon_button(body, "COMPARE INTEREST", self.calculate_interest,
                    width=20, height=2).grid(row=3, column=0, sticky="w", padx=7, pady=12)
        self.int_result = tk.StringVar(
            value="Compare simple interest and compound interest for the same inputs."
        )
        self._result_box(result, self.int_result)

    def calculate_interest(self) -> None:
        try:
            p = float(self.int_principal.get())
            rate = float(self.int_rate.get()) / 100
            t = float(self.int_time.get())
            n = int(self.int_frequency.get())
            if p < 0 or rate < 0 or t < 0:
                raise ValueError("Values cannot be negative.")
            si = p * rate * t
            ci_amount = p * (1 + rate/n) ** (n*t)
            self.int_result.set(
                f"INTEREST COMPARISON\n\n"
                f"Simple interest    {money(si)}\n"
                f"Simple amount      {money(p+si)}\n\n"
                f"Compound interest  {money(ci_amount-p)}\n"
                f"Compound amount    {money(ci_amount)}\n\n"
                f"Difference         {money(ci_amount-(p+si))}"
            )
        except Exception as exc:
            self.int_result.set(f"Unable to calculate\n\n{exc}")

    # ----- GST / discount ----------------------------------------------------
    def _build_gst(self) -> None:
        form, result = self._finance_layout(
            self.gst_page, "GST & DISCOUNT CALCULATOR", "DISCOUNT FIRST, THEN TAX"
        )
        body = tk.Frame(form, bg=C["panel"])
        body.pack(fill="both", expand=True, padx=16, pady=(0, 14))
        self.gst_base = add_field(body, "Listed / base price (₹)", "2500", row=0, column=0)
        self.gst_discount = add_field(body, "Discount (%)", "10", row=0, column=1)
        self.gst_rate = add_field(body, "GST rate (%)", "18", row=1, column=0)
        tk.Label(
            body,
            text="Calculation applies discount before GST. Change rates to match the item and applicable rules.",
            bg=C["panel"], fg=C["muted"], font=(FONT, 8),
            wraplength=450, justify="left"
        ).grid(row=2, column=0, columnspan=2, sticky="w", padx=7, pady=10)
        neon_button(body, "CALCULATE FINAL PRICE", self.calculate_gst,
                    width=23, height=2).grid(row=3, column=0, sticky="w", padx=7, pady=6)
        self.gst_result = tk.StringVar(
            value="Calculate the discounted price, tax amount and final price."
        )
        self._result_box(result, self.gst_result)

    def calculate_gst(self) -> None:
        try:
            base = float(self.gst_base.get())
            disc = float(self.gst_discount.get())
            rate = float(self.gst_rate.get())
            if base < 0 or not 0 <= disc <= 100 or rate < 0:
                raise ValueError("Check the price and percentage values.")
            discount = base * disc / 100
            taxable = base - discount
            tax = taxable * rate / 100
            self.gst_result.set(
                f"PRICE BREAKDOWN\n\n"
                f"Base price       {money(base)}\n"
                f"Discount         − {money(discount)}\n"
                f"Taxable amount   {money(taxable)}\n"
                f"GST              + {money(tax)}\n\n"
                f"FINAL PRICE      {money(taxable+tax)}"
            )
        except Exception as exc:
            self.gst_result.set(f"Unable to calculate\n\n{exc}")

    def _build_amortization(self) -> None:
        shell = tk.Frame(self.schedule_page, bg=C["bg"])
        shell.pack(fill="both", expand=True, padx=12, pady=10)
        shell.grid_columnconfigure(0, weight=1)
        shell.grid_rowconfigure(1, weight=1)
        form = card(shell, "LOAN AMORTIZATION", "MONTH-BY-MONTH BREAKDOWN")
        form.grid(row=0, column=0, sticky="ew", pady=(0, 9))
        body = tk.Frame(form, bg=C["panel"])
        body.pack(fill="x", padx=12, pady=(0, 12))
        self.amort_principal = add_field(body, "Principal (₹)", "500000", row=0, column=0)
        self.amort_rate = add_field(body, "Annual rate (%)", "9.5", row=0, column=1)
        self.amort_months = add_field(body, "Tenure (months)", "120", row=0, column=2)
        neon_button(body, "GENERATE SCHEDULE", self.calculate_amortization,
                    width=21, height=2).grid(row=1, column=0, sticky="w", padx=7, pady=6)
        table_card = card(shell, "REPAYMENT TABLE", "OPENING · EMI · INTEREST · PRINCIPAL · BALANCE")
        table_card.grid(row=1, column=0, sticky="nsew")
        tree_wrap = tk.Frame(table_card, bg=C["panel"])
        tree_wrap.pack(fill="both", expand=True, padx=12, pady=(0, 12))
        cols = ("month", "opening", "emi", "interest", "principal", "balance")
        self.amort_tree = ttk.Treeview(tree_wrap, columns=cols, show="headings", height=12)
        for col, title, width in [
            ("month", "MONTH", 70), ("opening", "OPENING BALANCE", 150),
            ("emi", "EMI", 130), ("interest", "INTEREST", 130),
            ("principal", "PRINCIPAL PAID", 140), ("balance", "CLOSING BALANCE", 150)]:
            self.amort_tree.heading(col, text=title)
            self.amort_tree.column(col, width=width, anchor="e" if col != "month" else "center")
        scroll = ttk.Scrollbar(tree_wrap, orient="vertical", command=self.amort_tree.yview)
        self.amort_tree.configure(yscrollcommand=scroll.set)
        self.amort_tree.pack(side="left", fill="both", expand=True)
        scroll.pack(side="right", fill="y")
        self.amort_summary = tk.StringVar(value="Enter loan details and generate the repayment schedule.")
        tk.Label(shell, textvariable=self.amort_summary, bg=C["bg2"], fg=C["cyan2"],
                 font=(MONO, 9), padx=10, pady=8, anchor="w").grid(row=2, column=0, sticky="ew", pady=(8, 0))

    def calculate_amortization(self) -> None:
        try:
            principal = float(self.amort_principal.get().replace(",", ""))
            rate = float(self.amort_rate.get())
            months = int(float(self.amort_months.get()))
            if principal <= 0 or rate < 0 or months <= 0 or months > 600:
                raise ValueError("Use positive principal, non-negative rate and 1–600 months.")
            payment = emi_payment(principal, rate, months)
            monthly_rate = rate/1200
            balance = principal
            total_interest = 0.0
            for item in self.amort_tree.get_children():
                self.amort_tree.delete(item)
            for month in range(1, months+1):
                opening = balance
                interest = opening*monthly_rate
                principal_paid = min(opening, payment-interest)
                actual_payment = interest+principal_paid
                balance = max(0.0, opening-principal_paid)
                total_interest += interest
                self.amort_tree.insert("", "end", values=(month, f"₹{opening:,.2f}",
                    f"₹{actual_payment:,.2f}", f"₹{interest:,.2f}",
                    f"₹{principal_paid:,.2f}", f"₹{balance:,.2f}"))
            self.amort_summary.set(
                f"Monthly EMI: {money(payment)}     Total payment: {money(principal+total_interest)}     Total interest: {money(total_interest)}"
            )
        except Exception as exc:
            self.amort_summary.set(f"Schedule error: {exc}")

    def _build_cagr(self) -> None:
        form, result = self._finance_layout(
            self.growth_page, "GROWTH & CAGR CALCULATOR", "ANNUALISED GROWTH + INFLATION VIEW"
        )
        body = tk.Frame(form, bg=C["panel"])
        body.pack(fill="both", expand=True, padx=15, pady=(0, 13))
        self.cagr_start = add_field(body, "Beginning value (₹ or units)", "100000", row=0, column=0)
        self.cagr_end = add_field(body, "Ending value (₹ or units)", "150000", row=0, column=1)
        self.cagr_years = add_field(body, "Number of years", "5", row=1, column=0)
        self.inflation_rate = add_field(body, "Inflation rate (%) — optional", "5", row=1, column=1)
        neon_button(body, "CALCULATE CAGR", self.calculate_cagr,
                    width=18, height=2).grid(row=2, column=0, sticky="w", padx=7, pady=12)
        self.cagr_result = tk.StringVar(value="Calculate annualised growth and inflation-adjusted growth.")
        self._result_box(result, self.cagr_result)

    def calculate_cagr(self) -> None:
        try:
            start = float(self.cagr_start.get().replace(",", ""))
            end = float(self.cagr_end.get().replace(",", ""))
            years = float(self.cagr_years.get())
            inflation = float(self.inflation_rate.get() or 0)
            if start <= 0 or end < 0 or years <= 0 or inflation < 0:
                raise ValueError("Beginning value and years must be positive; other values cannot be negative.")
            cagr = ((end/start)**(1/years)-1)*100
            real = ((1+cagr/100)/(1+inflation/100)-1)*100
            self.cagr_result.set(
                f"GROWTH SUMMARY\n\nBeginning value     {money(start)}\nEnding value        {money(end)}\n"
                f"Period              {fmt(years)} years\n\nNominal CAGR        {fmt(cagr, 8)} %\n"
                f"Inflation rate      {fmt(inflation, 6)} %\nReal annual growth  {fmt(real, 8)} %\n\n"
                f"CAGR is a smoothed annualised rate, not the actual path taken each year."
            )
        except Exception as exc:
            self.cagr_result.set(f"Unable to calculate\n\n{exc}")

    # ----- Linear regression laboratory ------------------------------------
    def _build_regression_lab(self) -> None:
        page = self.regression_page
        page.grid_columnconfigure(0, weight=2)
        page.grid_columnconfigure(1, weight=3)
        page.grid_rowconfigure(0, weight=1)
        inputs = card(page, "PAIRED DATA INPUT", "X / Y OBSERVATIONS")
        results = card(page, "REGRESSION INSIGHTS", "LEAST-SQUARES LINE")
        inputs.grid(row=0, column=0, sticky="nsew", padx=(0, 8), pady=5)
        results.grid(row=0, column=1, sticky="nsew", padx=(8, 0), pady=5)
        body = tk.Frame(inputs, bg=C["panel"])
        body.pack(fill="both", expand=True, padx=14, pady=(0, 13))
        tk.Label(body, text="Enter matching X and Y values in the same order.",
                 bg=C["panel"], fg=C["cyan2"], font=(FONT, 9, "bold")).pack(anchor="w", pady=(2, 8))
        self.reg_x_input = tk.StringVar(value="1, 2, 3, 4, 5, 6")
        self.reg_y_input = tk.StringVar(value="2, 3, 5, 4, 6, 7")
        for label, variable in (("X VALUES", self.reg_x_input), ("Y VALUES", self.reg_y_input)):
            tk.Label(body, text=label, bg=C["panel"], fg=C["muted"],
                     font=(FONT, 8, "bold")).pack(anchor="w", pady=(5, 3))
            styled_entry(body, variable, font_size=11).pack(fill="x", ipady=8)
        self.reg_predict_x = tk.StringVar(value="7")
        tk.Label(body, text="PREDICT Y AT X (OPTIONAL)", bg=C["panel"], fg=C["muted"],
                 font=(FONT, 8, "bold")).pack(anchor="w", pady=(12, 3))
        styled_entry(body, self.reg_predict_x, font_size=11).pack(fill="x", ipady=8)
        buttons = tk.Frame(body, bg=C["panel"])
        buttons.pack(fill="x", pady=(13, 8))
        neon_button(buttons, "FIT MODEL", self.calculate_regression,
                    width=13, height=2).pack(side="left", padx=(0, 5))
        neon_button(buttons, "EXAMPLE", self._load_regression_example,
                    width=10, height=2).pack(side="left", padx=(0, 5))
        neon_button(buttons, "EXPORT CSV", self.export_lab_regression,
                    width=10, height=2, accent="mint").pack(side="left")
        tk.Label(body, text="Uses ordinary least squares for a straight-line model.\nCorrelation is descriptive and does not establish causation.",
                 bg=C["panel"], fg=C["muted"], font=(FONT, 8), justify="left",
                 wraplength=330).pack(anchor="w", pady=(7, 0))
        result_body = tk.Frame(results, bg=C["panel"])
        result_body.pack(fill="both", expand=True, padx=13, pady=(0, 13))
        self.reg_result = tk.StringVar(value="Enter paired observations and select FIT REGRESSION.")
        self.reg_result_label = tk.Label(result_body, textvariable=self.reg_result, bg=C["bg2"], fg=C["cyan2"],
                 font=(MONO, 9), anchor="nw", justify="left", padx=12, pady=10,
                 wraplength=410, relief="sunken", bd=2)
        self.reg_result_label.pack(fill="x", pady=(0, 8))
        self.reg_result_label.bind("<Configure>", lambda event: self.reg_result_label.configure(
            wraplength=max(260, event.width - 28)))
        self.reg_canvas = tk.Canvas(result_body, bg=C["bg2"], height=230,
                                    highlightthickness=1, highlightbackground=C["line2"])
        self.reg_canvas.pack(fill="both", expand=True)
        self.reg_canvas.bind("<Configure>", lambda _e: self._draw_regression_plot(*self._regression_state) if getattr(self, "_regression_state", None) else None)
        self.calculate_regression()

    def _load_regression_example(self) -> None:
        self.reg_x_input.set("1, 2, 3, 4, 5, 6")
        self.reg_y_input.set("2, 3, 5, 4, 6, 7")
        self.reg_predict_x.set("7")
        self.calculate_regression()

    def calculate_regression(self) -> None:
        try:
            xs = self._parse_lab_series(self.reg_x_input.get(), "X values")
            ys = self._parse_lab_series(self.reg_y_input.get(), "Y values")
            if len(xs) != len(ys):
                raise ValueError("X and Y must contain the same number of observations.")
            if len(xs) < 2:
                raise ValueError("Enter at least two paired observations.")
            n = len(xs)
            xbar, ybar = statistics.mean(xs), statistics.mean(ys)
            sxx = sum((x-xbar)**2 for x in xs)
            syy = sum((y-ybar)**2 for y in ys)
            sxy = sum((x-xbar)*(y-ybar) for x, y in zip(xs, ys))
            if sxx <= 1e-15:
                raise ValueError("X values must contain at least two distinct values.")
            slope = sxy / sxx
            intercept = ybar - slope*xbar
            fitted = [intercept+slope*x for x in xs]
            residuals = [y-yhat for y, yhat in zip(ys, fitted)]
            sse = sum(r*r for r in residuals)
            r = sxy / math.sqrt(sxx*syy) if syy > 1e-15 else None
            r2 = max(0.0, min(1.0, 1.0-sse/syy)) if syy > 1e-15 else None
            residual_se = math.sqrt(sse/(n-2)) if n > 2 else None
            mae = sum(abs(r) for r in residuals) / n
            rmse = math.sqrt(sse / n)
            adjusted_r2 = 1 - (1 - r2) * (n - 1) / (n - 2) if n > 2 and r2 is not None else None
            equation = f"ŷ = {fmt(slope, 9)}x {'+' if intercept >= 0 else '−'} {fmt(abs(intercept), 9)}"
            details = (
                f"OBSERVATIONS       {n}\n"
                f"MODEL              {equation}\n"
                f"SLOPE              {fmt(slope, 10)}\n"
                f"INTERCEPT          {fmt(intercept, 10)}\n"
                f"CORRELATION (r)    {fmt(r, 9) if r is not None else 'Not defined (constant Y)'}\n"
                f"R-SQUARED          {fmt(r2, 9) if r2 is not None else 'Not defined (constant Y)'}\n"
                f"ADJUSTED R²        {fmt(adjusted_r2, 9) if adjusted_r2 is not None else 'Needs 3+ points'}\n"
                f"RESIDUAL SUM SQ.   {fmt(sse, 9)}\n"
                f"MAE / RMSE         {fmt(mae, 8)} / {fmt(rmse, 8)}\n"
                f"RESIDUAL STD. ERR. {fmt(residual_se, 8) if residual_se is not None else 'Needs 3+ points'}"
            )
            pred_raw = self.reg_predict_x.get().strip()
            if pred_raw:
                pred_x = float(pred_raw)
                if not math.isfinite(pred_x):
                    raise ValueError("Prediction X must be finite.")
                details += f"\nPREDICTED Y        {fmt(intercept+slope*pred_x, 10)}  at x = {fmt(pred_x)}"
                if pred_x < min(xs) or pred_x > max(xs):
                    details += "\nNOTE               Prediction is outside the observed X range (extrapolation)."
            self._regression_export_rows = [(x, y, intercept+slope*x, y-(intercept+slope*x)) for x, y in zip(xs, ys)]
            self._regression_metrics = {"Observations": n, "Slope": slope, "Intercept": intercept,
                                       "Correlation r": r, "R-squared": r2, "Adjusted R-squared": adjusted_r2,
                                       "Residual sum of squares": sse, "MAE": mae, "RMSE": rmse,
                                       "Residual standard error": residual_se}
            self.reg_result.set(details)
            self._regression_state = (xs, ys, slope, intercept)
            self._draw_regression_plot(xs, ys, slope, intercept)
        except Exception as exc:
            self.reg_result.set(f"Regression error\n\n{exc}")
            self.reg_canvas.delete("all")

    def _draw_regression_plot(self, xs: list[float], ys: list[float],
                              slope: float, intercept: float) -> None:
        c = self.reg_canvas
        c.delete("all")
        w, h = max(c.winfo_width(), 420), max(c.winfo_height(), 220)
        left, right, top, bottom = 52, w-20, 26, h-38
        xmin, xmax = min(xs), max(xs)
        xpad = max((xmax-xmin)*.08, .5)
        xmin, xmax = xmin-xpad, xmax+xpad
        predicted = [intercept+slope*x for x in (xmin, xmax)]
        ymin, ymax = min(min(ys), min(predicted)), max(max(ys), max(predicted))
        ypad = max((ymax-ymin)*.12, .5)
        ymin, ymax = ymin-ypad, ymax+ypad
        def px(x): return left+(x-xmin)/(xmax-xmin)*(right-left)
        def py(y): return bottom-(y-ymin)/(ymax-ymin)*(bottom-top)
        for i in range(5):
            yy = bottom-(bottom-top)*i/4
            xx = left+(right-left)*i/4
            c.create_line(left, yy, right, yy, fill=C["line"], dash=(2, 4))
            c.create_line(xx, top, xx, bottom, fill=C["line"], dash=(2, 4))
        c.create_line(px(xmin), py(predicted[0]), px(xmax), py(predicted[1]),
                      fill=C["mint_light"], width=3)
        for x, y in zip(xs, ys):
            cx, cy = px(x), py(y)
            c.create_oval(cx-5, cy-5, cx+5, cy+5, fill=C["cyan2"], outline=C["sapphire_dark"], width=2)
        c.create_text(12, 7, text="OBSERVED DATA  +  LEAST-SQUARES FIT", anchor="nw",
                      fill=C["cyan2"], font=(FONT, 9, "bold"))
        c.create_text((left+right)/2, h-12, text="X", fill=C["muted"], font=(FONT, 8))
        c.create_text(15, (top+bottom)/2, text="Y", fill=C["muted"], font=(FONT, 8))
        c.create_text(left, bottom+12, text=fmt(min(xs)), anchor="w", fill=C["muted"], font=(MONO, 7))
        c.create_text(right, bottom+12, text=fmt(max(xs)), anchor="e", fill=C["muted"], font=(MONO, 7))

    # ----- Ordinary differential equation laboratory ----------------------
    def _build_ode_lab(self) -> None:
        page = self.ode_page
        page.grid_columnconfigure(0, weight=2)
        page.grid_columnconfigure(1, weight=3)
        page.grid_rowconfigure(0, weight=1)
        inputs = card(page, "ODE SOLVER", "RK4 · SYMBOLIC WHEN AVAILABLE")
        output = card(page, "SOLUTION TRACE", "INITIAL VALUE PROBLEM")
        inputs.grid(row=0, column=0, sticky="nsew", padx=(0, 8), pady=5)
        output.grid(row=0, column=1, sticky="nsew", padx=(8, 0), pady=5)
        body = tk.Frame(inputs, bg=C["panel"])
        body.pack(fill="both", expand=True, padx=14, pady=(0, 13))
        self.ode_rhs = tk.StringVar(value="x - y")
        self.ode_x0 = tk.StringVar(value="0")
        self.ode_y0 = tk.StringVar(value="1")
        self.ode_xend = tk.StringVar(value="5")
        self.ode_steps = tk.StringVar(value="250")
        tk.Label(body, text="DIFFERENTIAL EQUATION  dy/dx = f(x, y)", bg=C["panel"],
                 fg=C["cyan2"], font=(FONT, 9, "bold")).pack(anchor="w", pady=(4, 5))
        styled_entry(body, self.ode_rhs, font_size=13).pack(fill="x", ipady=9, pady=(0, 10))
        for label, var in [("INITIAL X", self.ode_x0), ("INITIAL Y", self.ode_y0),
                           ("END X", self.ode_xend), ("STEPS (1–5000)", self.ode_steps)]:
            wrap = tk.Frame(body, bg=C["panel"])
            wrap.pack(fill="x", pady=5)
            tk.Label(wrap, text=label, bg=C["panel"], fg=C["muted"],
                     font=(FONT, 8, "bold")).pack(anchor="w", pady=(0, 3))
            styled_entry(wrap, var, font_size=10).pack(fill="x", ipady=6)
        ode_actions = tk.Frame(body, bg=C["panel"])
        ode_actions.pack(anchor="w", pady=(12, 7))
        neon_button(ode_actions, "SOLVE IVP", self.solve_ode,
                    width=14, height=2, font_size=9).pack(side="left", padx=(0, 6))
        neon_button(ode_actions, "EXPORT TRACE CSV", self.export_lab_ode,
                    width=16, height=2, font_size=8, accent="mint").pack(side="left")
        tk.Label(body, text="Supports numeric RHS expressions in x and y. SymPy adds a symbolic attempt when available.",
                 bg=C["panel"], fg=C["muted"], font=(FONT, 8), wraplength=350,
                 justify="left").pack(anchor="w", pady=(4, 0))
        output_body = tk.Frame(output, bg=C["panel"])
        output_body.pack(fill="both", expand=True, padx=13, pady=(0, 13))
        ode_text_frame = tk.Frame(output_body, bg=C["panel"])
        ode_text_frame.pack(fill="x", expand=False, pady=(0, 8))
        ode_text_scroll = ttk.Scrollbar(ode_text_frame, orient="vertical")
        ode_text_scroll.pack(side="right", fill="y")
        self.ode_output = tk.Text(ode_text_frame, bg=C["bg2"], fg=C["cyan2"], insertbackground=C["cyan"],
                                  font=(MONO, 9), relief="sunken", bd=2,
                                  highlightthickness=1, highlightbackground=C["line2"],
                                  wrap="word", padx=11, pady=10, height=9,
                                  yscrollcommand=ode_text_scroll.set)
        self.ode_output.pack(side="left", fill="both", expand=True)
        ode_text_scroll.configure(command=self.ode_output.yview)
        self.ode_plot = tk.Canvas(output_body, bg=C["bg2"], height=205,
                                  highlightthickness=1, highlightbackground=C["line2"])
        self.ode_plot.pack(fill="both", expand=True)
        self.ode_plot.bind("<Configure>", lambda _e: self._draw_ode_plot(self.ode_trace) if len(getattr(self, "ode_trace", [])) > 1 else None)
        self.ode_output.insert("1.0", "Enter dy/dx = f(x,y), an initial point and an end value.\n\nThe solver uses fourth-order Runge–Kutta integration. The numerical trace will appear below.")
        self.ode_output.configure(state="disabled")
        self.ode_trace = []
        self.solve_ode()  # Populate the workspace with a useful, editable example on first open.

    def solve_ode(self) -> None:
        try:
            rhs = self.ode_rhs.get().strip()
            x0, y0 = float(self.ode_x0.get()), float(self.ode_y0.get())
            x_end = float(self.ode_xend.get())
            steps = int(self.ode_steps.get())
            if not rhs:
                raise ValueError("Enter the right-hand side f(x,y).")
            if not all(math.isfinite(v) for v in (x0, y0, x_end)):
                raise ValueError("Initial and end values must be finite.")
            if steps < 1 or steps > 5000:
                raise ValueError("Choose between 1 and 5000 steps.")
            if abs(x_end - x0) < 1e-15:
                raise ValueError("End X must be different from Initial X.")
            h = (x_end-x0)/steps
            def f(x: float, y: float) -> float:
                value = float(safe_eval(rhs, {"x": x, "y": y}))
                if not math.isfinite(value):
                    raise ValueError("The derivative became non-finite.")
                return value
            x, y = x0, y0
            points = [(x, y)]
            for i in range(steps):
                k1 = f(x, y)
                k2 = f(x+h/2, y+h*k1/2)
                k3 = f(x+h/2, y+h*k2/2)
                k4 = f(x+h, y+h*k3)
                y += h*(k1+2*k2+2*k3+k4)/6
                x += h
                if not math.isfinite(y):
                    raise ValueError("The numerical solution diverged or became non-finite.")
                points.append((x, y))
            stride = max(1, steps//10)
            trace = points[::stride]
            if trace[-1] != points[-1]:
                trace.append(points[-1])
            lines = [f"dy/dx = {rhs}", f"Initial condition: y({fmt(x0)}) = {fmt(y0)}",
                     f"RK4 steps: {steps}", "", f"NUMERICAL RESULT  y({fmt(x_end)}) ≈ {fmt(y, 13)}", "", "SAMPLE TRACE"]
            lines.extend(f"x = {fmt(tx, 8):>14}    y ≈ {fmt(ty, 12)}" for tx, ty in trace)
            if sp is not None:
                try:
                    sx = sp.symbols("x")
                    yfunc = sp.Function("y")(sx)
                    rhs_sym = sp.sympify(rhs.replace("^", "**"), locals={"x": sx, "y": yfunc})
                    solution = sp.dsolve(sp.Eq(sp.diff(yfunc, sx), rhs_sym), yfunc,
                                          ics={yfunc.subs(sx, x0): y0})
                    lines.extend(["", "SYMBOLIC SOLUTION ATTEMPT", str(solution)])
                except Exception as exc:
                    lines.extend(["", f"Symbolic solution not available for this equation: {exc}"])
            else:
                lines.extend(["", "Optional symbolic solver: install SymPy with pip install sympy"])
            self.ode_output.configure(state="normal")
            self.ode_output.delete("1.0", "end")
            self.ode_output.insert("1.0", "\n".join(lines))
            self.ode_output.configure(state="disabled")
            self.ode_trace = points
            self._draw_ode_plot(points)
            self._console_write(f"ODE solved numerically: y({fmt(x_end)}) ≈ {fmt(y, 12)}")
        except Exception as exc:
            self.ode_output.configure(state="normal")
            self.ode_output.delete("1.0", "end")
            self.ode_output.insert("1.0", f"ODE ERROR\n\n{exc}")
            self.ode_output.configure(state="disabled")
            self.ode_plot.delete("all")
            self.ode_trace = []

    def _draw_ode_plot(self, points: list[tuple[float, float]]) -> None:
        c = self.ode_plot
        c.delete("all")
        if len(points) < 2:
            return
        w, h = max(c.winfo_width(), 420), max(c.winfo_height(), 190)
        left, right, top, bottom = 52, w-18, 25, h-34
        xmin, xmax = points[0][0], points[-1][0]
        if abs(xmax-xmin) < 1e-15:
            xmax = xmin + 1.0
        ys = [p[1] for p in points]
        ymin, ymax = min(ys), max(ys)
        if abs(ymax-ymin) < 1e-15:
            ymin, ymax = ymin-.5, ymax+.5
        pad = (ymax-ymin)*.08
        ymin, ymax = ymin-pad, ymax+pad
        def px(x): return left+(x-xmin)/(xmax-xmin)*(right-left)
        def py(y): return bottom-(y-ymin)/(ymax-ymin)*(bottom-top)
        for i in range(5):
            yy = bottom-(bottom-top)*i/4
            xx = left+(right-left)*i/4
            c.create_line(left, yy, right, yy, fill=C["line"], dash=(2, 4))
            c.create_line(xx, top, xx, bottom, fill=C["line"], dash=(2, 4))
        coords = [coord for x, y in points for coord in (px(x), py(y))]
        c.create_line(*coords, fill=C["mint_light"], width=2, smooth=False)
        x0, y0 = points[0]
        xe, ye = points[-1]
        c.create_oval(px(x0)-4, py(y0)-4, px(x0)+4, py(y0)+4,
                      fill=C["cyan2"], outline=C["sapphire_dark"])
        c.create_oval(px(xe)-5, py(ye)-5, px(xe)+5, py(ye)+5,
                      fill=C["mint"], outline=C["mint_light"], width=2)
        c.create_text(11, 6, text="NUMERICAL SOLUTION TRACE  ·  RK4", anchor="nw",
                      fill=C["cyan2"], font=(FONT, 8, "bold"))
        c.create_text(left, h-12, text=fmt(points[0][0]), anchor="w", fill=C["muted"], font=(MONO, 7))
        c.create_text(right, h-12, text=fmt(points[-1][0]), anchor="e", fill=C["muted"], font=(MONO, 7))

    # ----- Experiment exports ----------------------------------------------
    def _export_rows(self, suggested_name: str, rows: list[list[Any]]) -> None:
        path = filedialog.asksaveasfilename(
            parent=self.root, title="Export experiment data", initialfile=suggested_name,
            defaultextension=".csv", filetypes=[("CSV files", "*.csv"), ("All files", "*.*")]
        )
        if not path:
            return
        with open(path, "w", newline="", encoding="utf-8-sig") as handle:
            writer = csv.writer(handle)
            writer.writerows(rows)
        messagebox.showinfo("Export complete", f"Experiment data saved to:\\n{path}", parent=self.root)

    def export_lab_statistics(self) -> None:
        if not hasattr(self, "_lab_stats_data"):
            messagebox.showwarning("No dataset", "Analyse a dataset before exporting.", parent=self.root)
            return
        rows: list[list[Any]] = [["Section", "Metric", "Value"]]
        for key, value in self._lab_stats_metrics.items():
            rows.append(["Summary", key, "Not defined" if value is None else value])
        rows.extend([["Observation", "Value", value] for value in self._lab_stats_data])
        self._export_rows("quantumcalc_statistics.csv", rows)

    def export_lab_regression(self) -> None:
        if not hasattr(self, "_regression_export_rows"):
            messagebox.showwarning("No regression", "Fit a regression model before exporting.", parent=self.root)
            return
        rows: list[list[Any]] = [["Metric", "Value"]]
        rows.extend([[key, "Not defined" if value is None else value]
                     for key, value in self._regression_metrics.items()])
        rows.extend([[], ["X", "Observed Y", "Predicted Y", "Residual"]])
        rows.extend([[x, y, predicted, residual]
                     for x, y, predicted, residual in self._regression_export_rows])
        self._export_rows("quantumcalc_regression.csv", rows)

    def export_lab_ode(self) -> None:
        if not getattr(self, "ode_trace", None):
            messagebox.showwarning("No ODE trace", "Solve an initial value problem before exporting.", parent=self.root)
            return
        rows = [["X", "Numerical Y"]]
        rows.extend([[x, y] for x, y in self.ode_trace])
        self._export_rows("quantumcalc_ode_trace.csv", rows)

    # ----- Formula library ---------------------------------------------------
    def _build_formula_library(self) -> None:
        page = self.formula_page
        self.formulas = self._formula_data()
        top = tk.Frame(page, bg=C["bg"])
        top.pack(fill="x", pady=(7, 10))
        tk.Label(top, text="FORMULA LIBRARY", bg=C["bg"], fg=C["text"],
                 font=(FONT, 18, "bold")).pack(anchor="w")
        tk.Label(
            top,
            text=f"Search and explore {len(self.formulas):,} curated formulas across mathematics, science, engineering, computing, finance and more.",
            bg=C["bg"], fg=C["muted"], font=(FONT, 9)
        ).pack(anchor="w", pady=(3, 0))

        shell = tk.Frame(page, bg=C["bg"])
        shell.pack(fill="both", expand=True)
        shell.grid_columnconfigure(0, weight=1)
        shell.grid_columnconfigure(1, weight=2)
        shell.grid_rowconfigure(0, weight=1)

        listing = card(shell, "BROWSE FORMULAS", "SEARCH + FILTER")
        detail = card(shell, "FORMULA DETAIL", "SELECT AN ITEM", accent="fusion")
        listing.grid(row=0, column=0, sticky="nsew", padx=(0, 8))
        detail.grid(row=0, column=1, sticky="nsew", padx=(8, 0))

        searchrow = tk.Frame(listing, bg=C["panel"])
        searchrow.pack(fill="x", padx=13, pady=(0, 7))
        self.formula_search = tk.StringVar()
        se = styled_entry(searchrow, self.formula_search, font_size=9)
        se.pack(fill="x", ipady=7)
        self.formula_search.set("Search formula or topic…")
        se.bind("<FocusIn>", self._formula_search_focus_in)
        se.bind("<FocusOut>", self._formula_search_focus_out)
        se.bind("<KeyRelease>", lambda _e=None: self._populate_formula_tree())

        self.formula_category = tk.StringVar(value="All categories")
        category_box = ttk.Combobox(
            listing, textvariable=self.formula_category, state="readonly", width=24,
            values=["All categories"] + sorted({f["category"] for f in self.formulas})
        )
        category_box.pack(fill="x", padx=13, pady=(0, 9))
        category_box.bind("<<ComboboxSelected>>", lambda _e=None: self._populate_formula_tree())

        tree_area = tk.Frame(listing, bg=C["panel"])
        tree_area.pack(fill="both", expand=True, padx=13, pady=(0, 13))
        tree_area.grid_rowconfigure(0, weight=1)
        tree_area.grid_columnconfigure(0, weight=1)
        self.formula_tree = ttk.Treeview(
            tree_area, columns=("category",), show="tree headings", selectmode="browse"
        )
        self.formula_tree.heading("#0", text="Formula / concept")
        self.formula_tree.heading("category", text="Category")
        self.formula_tree.column("#0", width=240)
        self.formula_tree.column("category", width=105, anchor="center")
        formula_ybar = ttk.Scrollbar(tree_area, orient="vertical", command=self.formula_tree.yview)
        formula_xbar = ttk.Scrollbar(tree_area, orient="horizontal", command=self.formula_tree.xview)
        self.formula_tree.configure(yscrollcommand=formula_ybar.set, xscrollcommand=formula_xbar.set)
        self.formula_tree.grid(row=0, column=0, sticky="nsew")
        formula_ybar.grid(row=0, column=1, sticky="ns")
        formula_xbar.grid(row=1, column=0, sticky="ew")
        self.formula_tree.bind("<<TreeviewSelect>>", self._show_formula)

        self._populate_formula_tree()

        dbody = tk.Frame(detail, bg=C["panel"])
        dbody.pack(fill="both", expand=True, padx=16, pady=(0, 14))
        self.formula_title = tk.StringVar(value="Choose a formula from the library")
        self.formula_expression = tk.StringVar(value="")
        self.formula_explain = tk.StringVar(
            value="Search by topic or select a category to browse the collection."
        )
        tk.Label(
            dbody, textvariable=self.formula_title, bg=C["panel"], fg=C["cyan2"],
            font=(FONT, 15, "bold"), wraplength=600, justify="left"
        ).pack(anchor="w", pady=(6, 16))
        tk.Label(
            dbody, text="FORMULA", bg=C["panel"], fg=C["muted"],
            font=(FONT, 8, "bold")
        ).pack(anchor="w")
        tk.Label(
            dbody, textvariable=self.formula_expression, bg=C["bg2"],
            fg=C["cyan2"], font=(MONO, 15), justify="left",
            wraplength=650, padx=14, pady=18, relief="sunken", bd=3,
            highlightthickness=1, highlightbackground=C["line2"]
        ).pack(fill="x", pady=(5, 15))
        tk.Label(
            dbody, text="WHEN TO USE IT", bg=C["panel"], fg=C["muted"],
            font=(FONT, 8, "bold")
        ).pack(anchor="w")
        tk.Label(
            dbody, textvariable=self.formula_explain, bg=C["panel"],
            fg=C["text"], font=(FONT, 10), justify="left", wraplength=630
        ).pack(fill="x", anchor="w", pady=(6, 15))

        self.formula_example = tk.StringVar(value="")
        tk.Label(
            dbody, textvariable=self.formula_example, bg=C["panel2"],
            fg=C["cyan2"], font=(MONO, 9), justify="left",
            wraplength=630, padx=10, pady=10, relief="ridge", bd=2,
            highlightthickness=1, highlightbackground=C["line"]
        ).pack(fill="x", pady=(0, 12))

        action = tk.Frame(dbody, bg=C["panel"])
        action.pack(fill="x", pady=(5, 0))
        neon_button(
            action, "COPY FORMULA", self.copy_formula,
            width=16, height=2, accent="fusion"
        ).pack(side="left")
        neon_button(
            action, "SEND TO CALCULATOR ↗", self.insert_formula,
            width=22, height=2
        ).pack(side="left", padx=8)
        self.selected_formula: dict[str, str] | None = None

    @staticmethod
    def _formula_data() -> list[dict[str, str]]:
        rows = [
            ("Percentage", "Arithmetic", "Percentage = (Part / Whole) × 100", "Find what percentage one quantity is of another.", "Part = 25, Whole = 200 → 12.5%"),
            ("Profit percentage", "Arithmetic", "Profit % = (Profit / Cost Price) × 100", "Calculate profit relative to the original cost price.", "CP=800, SP=1000 → profit=25%"),
            ("Loss percentage", "Arithmetic", "Loss % = (Loss / Cost Price) × 100", "Calculate loss relative to the original cost price.", "CP=1000, SP=850 → loss=15%"),
            ("Density", "Physics", "ρ = Mass / Volume", "Mass per unit volume.", "200 g / 50 cm³ = 4 g/cm³"),
            ("Pressure", "Physics", "P = Force / Area", "Pressure is force acting per unit area.", "100 N / 2 m² = 50 Pa"),
            ("Work", "Physics", "W = Force × Displacement", "For a constant force along the direction of displacement.", "10 N × 3 m = 30 J"),
            ("Power", "Physics", "Power = Work / Time", "Rate of doing work or transferring energy.", "600 J / 10 s = 60 W"),
            ("Wave speed", "Physics", "v = f × λ", "Relates wave speed, frequency and wavelength.", "f=5 Hz, λ=2 m → 10 m/s"),
            ("Ohm's law — resistance", "Physics", "R = V / I", "Find resistance from voltage and current.", "12 V / 2 A = 6 Ω"),
            ("EMI — monthly rate", "Finance", "r = Annual rate / (12 × 100)", "Convert an annual percentage rate to a monthly decimal rate.", "12% p.a. → r=0.01 per month"),
            ("Loan total interest", "Finance", "Total Interest = (EMI × n) − P", "Calculate total interest paid over n monthly instalments.", "EMI=₹10,000, n=24, P=₹2,00,000 → ₹40,000"),
            ("Loan principal from EMI", "Finance", "P = EMI × [((1+r)^n − 1) / (r(1+r)^n)]", "Find loan principal from EMI, monthly rate r and number of payments n.", "Use r as a monthly decimal rate."),
            ("SIP future value — beginning-month", "Finance", "FV = M × (((1+i)^n − 1) / i) × (1+i)", "Estimate future value when each monthly contribution is made at the beginning of the month.", "M=₹2,000, i=1%, n=60."),
            ("Fixed deposit compound amount", "Finance", "A = P × (1 + R/(100m))^(mt)", "Estimate maturity value with m compounding periods each year.", "P=₹50,000, R=7%, m=4, t=3 years."),
            ("Compound annual growth rate", "Finance", "CAGR = ((Ending / Beginning)^(1/n) − 1) × 100", "Annualised growth rate across n years.", "₹10,000 to ₹14,641 over 4 years → 10% CAGR"),
            ("Present value", "Finance", "PV = FV / (1 + r)^n", "Discount a future value using per-period rate r and n periods.", "FV=₹12,100, r=10%, n=2 → PV=₹10,000"),
            ("Break-even quantity", "Finance", "Q = Fixed Cost / (Price − Variable Cost per unit)", "Units required for revenue to cover total costs when contribution per unit is positive.", "Fixed=₹50,000, price=₹100, variable=₹50 → 1,000 units"),
            ("Percentage change", "Arithmetic", "((New − Old) / Old) × 100", "Calculate an increase or decrease relative to an original value.", "Old 80, New 100 → 25% increase"),
            ("Average / mean", "Statistics", "x̄ = (Σx) / n", "Add all observations and divide by the number of observations.", "2, 4, 6 → mean = 4"),
            ("Ratio", "Arithmetic", "a : b = a/b", "Compare two quantities in the same units.", "12 : 18 = 2 : 3"),
            ("Simple interest", "Finance", "SI = (P × R × T) / 100", "Interest on the original principal only.", "P=10000, R=8%, T=2 → SI=1600"),
            ("Compound amount", "Finance", "A = P(1 + r/n)^(nt)", "Calculate growth when interest is compounded n times per year.", "P=10000, r=8%, n=4, t=2"),
            ("EMI", "Finance", "EMI = P·r·(1+r)^n / ((1+r)^n − 1)", "Monthly loan instalment; r is monthly rate as a decimal and n is number of instalments.", "Annual rate 12% → monthly r = 0.01"),
            ("SIP future value", "Finance", "FV = M × (((1+i)^n − 1) / i)", "Approximate future value of regular month-end investments with a constant monthly rate.", "M=5000, i=1% monthly, n=120"),
            ("Linear equation", "Algebra", "ax + b = 0  →  x = −b/a", "Solve a first-degree equation when a is not zero.", "3x + 6 = 0 → x = −2"),
            ("Quadratic formula", "Algebra", "x = (−b ± √(b²−4ac)) / (2a)", "Find roots of ax² + bx + c = 0, a ≠ 0.", "Discriminant D = b² − 4ac"),
            ("Algebraic identity", "Algebra", "(a + b)² = a² + 2ab + b²", "Expand the square of a sum.", "(x+3)² = x² + 6x + 9"),
            ("Difference of squares", "Algebra", "a² − b² = (a − b)(a + b)", "Factor a difference of two perfect squares.", "x² − 25 = (x−5)(x+5)"),
            ("Arithmetic progression nth term", "Sequences", "aₙ = a + (n−1)d", "Find a term in an AP from first term a and common difference d.", "a=3, d=4, n=10 → 39"),
            ("Arithmetic progression sum", "Sequences", "Sₙ = n/2 × [2a + (n−1)d]", "Find the sum of the first n terms of an AP.", "a=2, d=3, n=5 → 40"),
            ("Geometric progression nth term", "Sequences", "aₙ = a × r^(n−1)", "Find a term in a GP with first term a and common ratio r.", "a=2, r=3, n=4 → 54"),
            ("Circle area", "Geometry", "A = πr²", "Calculate the area enclosed by a circle.", "r=7 → 154 square units (π≈22/7)"),
            ("Circle circumference", "Geometry", "C = 2πr", "Calculate the boundary length of a circle.", "r=7 → 44 units (π≈22/7)"),
            ("Pythagorean theorem", "Geometry", "c² = a² + b²", "For a right triangle, c is the hypotenuse.", "a=3, b=4 → c=5"),
            ("Triangle area", "Geometry", "A = ½ × base × height", "Calculate triangle area when perpendicular height is known.", "base=10, height=6 → 30"),
            ("Sine rule", "Trigonometry", "a/sin(A) = b/sin(B) = c/sin(C)", "Relate sides to their opposite angles in any non-degenerate triangle.", "Use when a side-angle opposite pair is known."),
            ("Cosine rule", "Trigonometry", "c² = a² + b² − 2ab cos(C)", "Find a side when two sides and their included angle are known.", "For C=90°, it becomes Pythagoras."),
            ("Pythagorean trig identity", "Trigonometry", "sin²(x) + cos²(x) = 1", "Fundamental trigonometric identity; x is in a consistent angle unit.", "If sin(x)=0.6, cos²(x)=0.64."),
            ("Power rule — derivative", "Calculus", "d/dx (xⁿ) = n·x^(n−1)", "Differentiate a power of x with respect to x.", "d/dx(x⁵) = 5x⁴"),
            ("Product rule", "Calculus", "(uv)' = u'v + uv'", "Differentiate a product of two differentiable functions.", "d/dx(x² sin x) = 2x sin x + x² cos x"),
            ("Chain rule", "Calculus", "d/dx f(g(x)) = f'(g(x))·g'(x)", "Differentiate a composite function.", "d/dx sin(x²) = 2x cos(x²)"),
            ("Power rule — integral", "Calculus", "∫xⁿ dx = x^(n+1)/(n+1) + C", "Integrate a power when n ≠ −1.", "∫x² dx = x³/3 + C"),
            ("Mean", "Statistics", "Mean = Σx / n", "Arithmetic average of a data set.", "3, 6, 9 → mean = 6"),
            ("Population variance", "Statistics", "σ² = Σ(x − μ)² / N", "Measure the average squared distance from the population mean.", "Standard deviation is √variance."),
            ("Standard deviation", "Statistics", "σ = √(Σ(x − μ)² / N)", "Measure spread around the population mean.", "A larger value indicates more dispersion."),
            ("Speed", "Physics", "v = distance / time", "Average speed equals total distance divided by total time.", "150 km in 3 h → 50 km/h"),
            ("Newton's second law", "Physics", "F = m × a", "Net force equals mass multiplied by acceleration.", "m=2 kg, a=3 m/s² → 6 N"),
            ("Kinetic energy", "Physics", "KE = ½mv²", "Energy of motion for an object of mass m and speed v.", "m=2 kg, v=3 m/s → 9 J"),
            ("Ohm's law", "Physics", "V = I × R", "For an ohmic conductor under constant physical conditions, voltage equals current times resistance.", "I=2 A, R=5 Ω → 10 V"),
            ("Coulomb's law", "Physics", "F = k |q₁q₂| / r²", "Electrostatic force magnitude between two point charges in vacuum.", "Force varies inversely with square of separation."),
            ("Gravitational force", "Physics", "F = Gm₁m₂ / r²", "Newton's law of universal gravitation for two point masses.", "Doubling distance reduces force to one quarter."),
            ("Momentum", "Physics", "p = m × v", "Linear momentum is mass multiplied by velocity.", "m=3 kg, v=4 m/s → 12 kg·m/s"),
            ("Impulse", "Physics", "J = F × Δt = Δp", "Impulse equals change in momentum for constant net force.", "10 N × 2 s = 20 N·s"),
            ("Surface area of sphere", "Geometry", "A = 4πr²", "Total curved surface area of a sphere.", "r=3 → 36π square units"),
            ("Volume of sphere", "Geometry", "V = 4πr³/3", "Volume enclosed by a sphere.", "r=3 → 36π cubic units"),
            ("Cone volume", "Geometry", "V = πr²h/3", "Volume of a right circular cone.", "r=3, h=4 → 12π cubic units"),
            ("Cylinder volume", "Geometry", "V = πr²h", "Volume of a right circular cylinder.", "r=2, h=5 → 20π cubic units"),
            ("Binomial probability", "Statistics", "P(X=k) = C(n,k)pᵏ(1−p)^(n−k)", "Probability of exactly k successes in n independent trials with success probability p.", "Use for fixed number of independent trials."),
            ("Z-score", "Statistics", "z = (x − μ) / σ", "Standardise a value using the mean and standard deviation.", "x=70, μ=60, σ=5 → z=2"),
            ("Covariance", "Statistics", "Cov(X,Y) = E[(X−μx)(Y−μy)]", "Measures how two variables vary together.", "Positive covariance indicates same-direction variation on average."),
            ("Correlation coefficient", "Statistics", "r = Cov(X,Y)/(σxσy)", "Standardised measure of linear association between two variables.", "r ranges from −1 to +1."),
            ("Matrix multiplication", "Algebra", "(AB)ᵢⱼ = Σₖ AᵢₖBₖⱼ", "Multiply rows of A by columns of B; inner dimensions must match.", "A is m×n and B is n×p → AB is m×p."),
            ("2×2 determinant", "Algebra", "det([[a,b],[c,d]]) = ad − bc", "Calculate the determinant of a 2×2 matrix.", "[[1,2],[3,4]] → −2"),
            ("Permutations", "Combinatorics", "nPr = n! / (n−r)!", "Count ordered selections of r objects from n distinct objects.", "5P2 = 20"),
            ("Combinations", "Combinatorics", "nCr = n! / (r!(n−r)!)", "Count selections where order does not matter.", "5C2 = 10"),
            ("Log product rule", "Algebra", "logₐ(xy) = logₐx + logₐy", "Convert a product inside a logarithm into a sum, for positive x,y and valid base a.", "log₁₀(100×10)=2+1=3"),
            ("Fourth-order Runge–Kutta step", "Calculus", "yₙ₊₁ = yₙ + (h/6)(k₁ + 2k₂ + 2k₃ + k₄)", "Numerically approximate a first-order ODE dy/dx=f(x,y) using four slope estimates per step.", "k₁=f(x,y); k₂=f(x+h/2,y+hk₁/2); k₃=f(x+h/2,y+hk₂/2); k₄=f(x+h,y+hk₃)."),
            ("Sphere volume", "Geometry", "V = (4/3)πr³", "Volume enclosed by a sphere of radius r.", "r=2 → 32π/3 cubic units."),
            ("Parametric sphere", "Geometry", "x=R cos(v) cos(u); y=R cos(v) sin(u); z=R sin(v)", "Represent a sphere parametrically using longitude u and latitude v.", "u∈[0,2π], v∈[−π/2,π/2]."),
            ("Torus surface", "Geometry", "x=(R+r cos(v))cos(u); y=(R+r cos(v))sin(u); z=r sin(v)", "Represent a torus with major radius R and tube radius r.", "u,v∈[0,2π]."),
            ("Log power rule", "Algebra", "logₐ(xʳ) = r logₐx", "Bring an exponent down as a multiplier for positive x and valid base a.", "log₂(8³)=3×3=9"),
        ]
        # Extended reference collection: formulas are grouped by discipline and
        # include a short applicability note/example to reduce misuse.
        rows.extend([
            # Arithmetic, algebra and number theory
            ("Weighted mean", "Statistics", "x̄w = Σ(wᵢxᵢ) / Σwᵢ", "Average observations using their relative weights.", "Scores 80 and 90 with weights 1 and 3 → 87.5."),
            ("Geometric mean", "Statistics", "GM = (Πxᵢ)^(1/n)", "Use for positive multiplicative data such as growth factors.", "2 and 8 → GM = 4."),
            ("Harmonic mean", "Statistics", "HM = n / Σ(1/xᵢ)", "Useful for averaging rates when equal quantities are covered.", "Speeds 40 and 60 over equal distances → HM = 48."),
            ("Sample variance", "Statistics", "s² = Σ(xᵢ−x̄)² / (n−1)", "Unbiased sample variance estimate for independent observations.", "Use n−1 degrees-of-freedom correction."),
            ("Sample standard deviation", "Statistics", "s = √(Σ(xᵢ−x̄)² / (n−1))", "Sample spread estimate around the sample mean.", "Square root of sample variance."),
            ("Coefficient of variation", "Statistics", "CV = (σ / μ) × 100%", "Compare relative dispersion for positive-scale data with nonzero mean.", "σ=5, μ=25 → CV=20%."),
            ("Interquartile range", "Statistics", "IQR = Q₃ − Q₁", "Measure the spread of the middle half of ordered observations.", "Q₁=12, Q₃=28 → IQR=16."),
            ("Standard error of mean", "Statistics", "SE(x̄) = s / √n", "Estimate the sampling variability of a sample mean under usual assumptions.", "s=10, n=25 → SE=2."),
            ("Margin of error", "Statistics", "ME = critical value × SE", "Half-width of a confidence interval under the selected model.", "For a z interval, ME=z*·σ/√n."),
            ("Pearson correlation", "Statistics", "r = Σ[(xᵢ−x̄)(yᵢ−ȳ)] / √(Σ(xᵢ−x̄)²Σ(yᵢ−ȳ)²)", "Measure linear association between paired observations.", "r is between −1 and +1."),
            ("Least-squares slope", "Statistics", "b₁ = Σ[(xᵢ−x̄)(yᵢ−ȳ)] / Σ(xᵢ−x̄)²", "Slope of the simple linear least-squares fit.", "Predicted y = b₀ + b₁x."),
            ("Least-squares intercept", "Statistics", "b₀ = ȳ − b₁x̄", "Intercept of the simple linear regression line.", "The fitted line passes through (x̄,ȳ)."),
            ("Coefficient of determination", "Statistics", "R² = 1 − SSE/SST", "Fraction of observed response variation explained by a fitted model.", "R²=0.90 means 90% of sample variation is explained by the model."),
            ("Root mean square error", "Statistics", "RMSE = √(Σ(yᵢ−ŷᵢ)²/n)", "Summarise prediction error in the response variable's units.", "Smaller RMSE indicates smaller typical squared-error scale."),
            ("Mean absolute error", "Statistics", "MAE = Σ|yᵢ−ŷᵢ|/n", "Average absolute prediction error.", "Residual magnitudes 1, 2, 3 → MAE=2."),
            ("Bayes theorem", "Probability", "P(A|B) = P(B|A)P(A) / P(B)", "Update the probability of A after observing B, when P(B)>0.", "Prior × likelihood divided by evidence."),
            ("Addition rule", "Probability", "P(A∪B)=P(A)+P(B)−P(A∩B)", "Find the probability that at least one of two events occurs.", "For mutually exclusive events, the intersection is zero."),
            ("Conditional probability", "Probability", "P(A|B)=P(A∩B)/P(B)", "Probability of A among outcomes where B has occurred.", "Requires P(B)>0."),
            ("Multiplication rule", "Probability", "P(A∩B)=P(A)P(B|A)", "Find joint probability using a conditional probability.", "For independent events, P(A∩B)=P(A)P(B)."),
            ("Expected value", "Probability", "E[X]=Σx·P(X=x)", "Long-run mean of a discrete random variable.", "Fair die: E[X]=3.5."),
            ("Binomial mean and variance", "Probability", "E[X]=np; Var(X)=np(1−p)", "For n independent Bernoulli trials with common success probability p.", "n=10, p=0.2 → mean=2, variance=1.6."),
            ("Poisson probability", "Probability", "P(X=k)=e^(−λ)λᵏ/k!", "Model counts over a fixed interval when events occur at a constant average rate under Poisson assumptions.", "λ=2, k=0 → P=e^(−2)."),
            ("Normal density", "Probability", "f(x)=e^(−(x−μ)²/(2σ²))/(σ√(2π))", "Probability density for a normal distribution with σ>0.", "The total area under the density is 1."),
            ("Exponential distribution CDF", "Probability", "F(x)=1−e^(−λx), x≥0", "Cumulative probability for an exponential waiting-time model with λ>0.", "Mean waiting time is 1/λ."),
            ("Combination identity", "Combinatorics", "C(n,r)=C(n,n−r)", "Choose r items or equivalently exclude n−r items.", "10C2 = 10C8 = 45."),
            ("Binomial theorem", "Algebra", "(x+y)ⁿ = Σ C(n,k)xⁿ⁻ᵏyᵏ", "Expand a nonnegative integer power of a binomial.", "(x+y)³=x³+3x²y+3xy²+y³."),
            ("Sum of first n natural numbers", "Number Theory", "Σk = n(n+1)/2", "Sum integers from 1 through n.", "n=100 → 5050."),
            ("Sum of squares", "Number Theory", "Σk² = n(n+1)(2n+1)/6", "Sum squares of integers from 1 through n.", "n=3 → 14."),
            ("Sum of cubes", "Number Theory", "Σk³ = [n(n+1)/2]²", "Sum cubes of integers from 1 through n.", "1³+2³+3³=36."),
            ("Euclidean algorithm", "Number Theory", "gcd(a,b)=gcd(b, a mod b)", "Compute the greatest common divisor by repeated remainders.", "gcd(48,18)=6."),
            ("Euler totient", "Number Theory", "φ(n)=nΠp|n(1−1/p)", "Count positive integers up to n that are coprime to n.", "φ(12)=4."),
            ("Modular inverse condition", "Number Theory", "a⁻¹ mod m exists iff gcd(a,m)=1", "Determine whether a multiplicative inverse modulo m exists.", "3⁻¹ mod 7 = 5."),
            ("Arithmetic series", "Sequences", "Sₙ = n(a₁+aₙ)/2", "Sum an arithmetic sequence from first and last terms.", "3+5+7+9 = 24."),
            ("Infinite geometric series", "Sequences", "S∞=a/(1−r), |r|<1", "Sum an infinite geometric progression when it converges.", "a=4, r=0.5 → S∞=8."),
            # Geometry, trigonometry and calculus
            ("Rectangle area", "Geometry", "A = l × w", "Area of a rectangle with length l and width w.", "8 × 5 = 40 square units."),
            ("Rectangle perimeter", "Geometry", "P = 2(l+w)", "Perimeter of a rectangle.", "8 by 5 → perimeter 26."),
            ("Parallelogram area", "Geometry", "A = b × h", "Area using base and perpendicular height.", "b=9, h=4 → 36."),
            ("Trapezoid area", "Geometry", "A = ½(a+b)h", "Area when a and b are the parallel sides.", "a=5, b=9, h=4 → 28."),
            ("Heron's formula", "Geometry", "A=√(s(s−a)(s−b)(s−c)); s=(a+b+c)/2", "Triangle area from all three side lengths.", "Sides 3,4,5 → area 6."),
            ("Regular polygon interior angle", "Geometry", "θ = (n−2)180°/n", "Each interior angle of a regular n-sided polygon.", "Regular hexagon → 120°."),
            ("Regular polygon area", "Geometry", "A = ½ × apothem × perimeter", "Area of a regular polygon using its apothem.", "Multiply apothem by perimeter and halve."),
            ("Arc length", "Geometry", "s = rθ", "Arc length when θ is measured in radians.", "r=3, θ=π/2 → 3π/2."),
            ("Sector area", "Geometry", "A = ½r²θ", "Sector area when θ is measured in radians.", "r=2, θ=π/2 → π."),
            ("Frustum of cone volume", "Geometry", "V=⅓πh(R²+Rr+r²)", "Volume of a right circular conical frustum.", "R and r are the larger and smaller radii."),
            ("Ellipse area", "Geometry", "A = πab", "Area of an ellipse with semi-axes a and b.", "a=4, b=2 → 8π."),
            ("Law of sines", "Trigonometry", "a/sin A = b/sin B = c/sin C", "Solve non-right triangles when a known opposite side-angle pair is available.", "Angles must use a consistent unit."),
            ("Tangent identity", "Trigonometry", "tan x = sin x / cos x", "Relate tangent to sine and cosine where cos x≠0.", "tan 45°=1."),
            ("Secant identity", "Trigonometry", "sec²x = 1 + tan²x", "Pythagorean identity involving secant and tangent.", "Valid where cosine is nonzero."),
            ("Double-angle sine", "Trigonometry", "sin(2x)=2sin x cos x", "Express sine of a double angle.", "sin(60°)=2sin30°cos30°."),
            ("Double-angle cosine", "Trigonometry", "cos(2x)=cos²x−sin²x", "Equivalent forms include 2cos²x−1 and 1−2sin²x.", "cos(2x)=1−2sin²x."),
            ("Angle addition — sine", "Trigonometry", "sin(a±b)=sin a cos b±cos a sin b", "Compute sine of a sum or difference.", "Use a consistent angle unit."),
            ("Angle addition — cosine", "Trigonometry", "cos(a±b)=cos a cos b∓sin a sin b", "Compute cosine of a sum or difference.", "The sign on the sine product is opposite."),
            ("Radians conversion", "Trigonometry", "radians = degrees × π/180", "Convert degrees to radians.", "180° = π radians."),
            ("Taylor series of exp", "Calculus", "eˣ = Σ(xⁿ/n!), n=0…∞", "Power series representation of the exponential function.", "Converges for every real x."),
            ("Taylor series of sine", "Calculus", "sin x = Σ(−1)ⁿx^(2n+1)/(2n+1)!", "Power series representation of sine.", "Converges for every real x."),
            ("Taylor series of cosine", "Calculus", "cos x = Σ(−1)ⁿx^(2n)/(2n)!", "Power series representation of cosine.", "Converges for every real x."),
            ("Derivative of exponential", "Calculus", "d(eˣ)/dx = eˣ", "Derivative of the natural exponential function.", "d(e^(3x))/dx=3e^(3x)."),
            ("Derivative of logarithm", "Calculus", "d(ln x)/dx = 1/x, x>0", "Derivative of the natural logarithm.", "d(ln(2x))/dx=1/x for x>0."),
            ("Derivative of sine", "Calculus", "d(sin x)/dx = cos x", "Derivative with respect to x in radians.", "d(sin(4x))/dx=4cos(4x)."),
            ("Derivative of cosine", "Calculus", "d(cos x)/dx = −sin x", "Derivative with respect to x in radians.", "d(cos(2x))/dx=−2sin(2x)."),
            ("Integration by parts", "Calculus", "∫u dv = uv − ∫v du", "Integrate a product by choosing u and dv.", "∫x eˣ dx = xeˣ−eˣ+C."),
            ("Substitution rule", "Calculus", "∫f(g(x))g′(x)dx = ∫f(u)du", "Simplify an integral using u=g(x).", "For u=x², du=2x dx."),
            ("Fundamental theorem of calculus", "Calculus", "∫ₐᵇ f(x)dx = F(b)−F(a)", "Evaluate a definite integral when F′=f and conditions are met.", "Antiderivative differences give net signed area."),
            ("Arc length of a curve", "Calculus", "L=∫ₐᵇ√(1+[f′(x)]²)dx", "Length of y=f(x) over [a,b] when differentiable.", "Requires the integral to exist."),
            ("Mean value theorem", "Calculus", "f′(c)=[f(b)−f(a)]/(b−a)", "For continuous f on [a,b] and differentiable on (a,b), some c satisfies this equality.", "At least one tangent has the secant slope."),
            ("Newton-Raphson iteration", "Calculus", "xₙ₊₁=xₙ−f(xₙ)/f′(xₙ)", "Iteratively approximate a root when derivative is nonzero and iteration behaves well.", "Convergence depends on starting value and function."),
            ("Trapezoidal numerical integration", "Calculus", "∫ₐᵇf(x)dx ≈ (h/2)[f₀+2Σfᵢ+fₙ]", "Approximate a definite integral with equally spaced samples.", "h=(b−a)/n."),
            ("Euler ODE step", "Differential Equations", "yₙ₊₁=yₙ+h f(xₙ,yₙ)", "First-order numerical method for y′=f(x,y).", "Simple but generally less accurate than higher-order methods."),
